#include <vector>
#include <tuple>

#include "AFQMC/config.h"
#include "Numerics/csr_blas.hpp"
#include "AFQMC/Wavefunctions/PHMSD.hpp"
#include "Numerics/batched_operations.hpp"

namespace sfqmc
{
namespace afqmc
{
/*
 * Calculates the local energy and overlaps of all the walkers in the set and 
 * returns them in the appropriate data structures
 * alg0: Loop over unique configurations and do a full calculation of the GF and E.
 * Reference implementation, uses the least amount of memory, slow/inefficient. 
 */
template<bool MP>
template<class WlkSet, class Mat, class TVec>
void PHMSD<MP>::energy_shared_alg0(const WlkSet& wset, Mat&& E, TVec&& Ov)
{
  using ma::conj;
  using std::get;
  using std::fill_n;
  using std::copy_n;
  int nspins  = (walker_type==COLLINEAR?2:1);
  size_t nkev = HamOp.number_of_ke_vectors();
  RUNTIME_CHECK(E.dimensionality == 2, "");
  RUNTIME_CHECK(Ov.dimensionality == 1, "");
  RUNTIME_CHECK(E.size(0) == wset.size(), "");
  RUNTIME_CHECK(Ov.size(0) == wset.size(), "");
  RUNTIME_CHECK(E.size(1) == 3, "");

  ComplexType zero(0.0);
  auto nwalk = wset.size();
  double LogOverlapFactor(wset.getLogOverlapFactor());
  StaticMatrix eloc2({nwalk, 3}, ComplexType(0.0), 
                     buffer_manager.get_generator().template get_allocator<ComplexType>()); 
  StaticVector opSpinEJ(iextensions<1u>{nwalk}, ComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<ComplexType>()); 
  StaticSHM3Tensor Ovmsd({nspins, maxn_unique_confg, nwalk}, ComplexType(0.0),
                     shm_buffer_manager.get_generator().template get_allocator<ComplexType>()); 
  StaticSHM4Tensor Emsd({nspins, maxn_unique_confg, nwalk, 3}, ComplexType(0.0),
                     shm_buffer_manager.get_generator().template get_allocator<ComplexType>()); 

  fill_n(Ov.origin(), nwalk, zero);
  fill_n(E.origin(), 3 * nwalk, zero);

  long nexcit[2] = {long(abij.number_of_unique_excitations()[0]), 
                    long(abij.number_of_unique_excitations()[1])};
  std::vector<int> confg(nup);
  IVector confg_dev(iextensions<1u>{nup}); 

  // 1. calculate eneries for unique determinants
  //    - Emsd[spin][nd_unique][iw][{0:E1, 1:EXX, 2:--}]
  //    - Ovmsd[spin][nd_unique][iw]
  if (walker_type == NONCOLLINEAR)
  {
    //ComplexType ov0;
    int w0, w1;
    std::tie(w0, w1) = FairDivideBoundary(TG.TG_local().rank(), nwalk, TG.TG_local().size());
    auto SM=wset.SlaterMatrices(Alpha);
    confg.resize(nup);
    auto Gdims     = dm_dims(false, SpinTypes(0));
    auto Gdims_ref = dm_dims_ref(false, SpinTypes(0));
    int nr = Gdims.first * Gdims.second, nc = nwalk;
    if (transposed_G_for_E_)
      std::swap(nr, nc);
    StaticSHMMatrix G({nr, nc}, 
                   shm_buffer_manager.get_generator().template get_allocator<ComplexType>()); 
    // compute [nwalk][...] and transpose at end
    StaticSHM3Tensor Gwork({nwalk, Gdims_ref.first, Gdims_ref.second}, 
                   shm_buffer_manager.get_generator().template get_allocator<ComplexType>());
    int ix = ( transposed_G_for_E_ ? 0 : 1 );  
    Static3Tensor Gt({ix*(w1-w0), Gdims.first, Gdims.second},
                   buffer_manager.get_generator().template get_allocator<ComplexType>());
    
    for (int nd = 0; nd < int(nexcit[0]); ++nd)
    {
      abij.get_configuration(0, nd, confg);
      copy_n(confg.data(), confg.size(), confg_dev.origin());
      {
        int n0, n1;
        std::tie(n0, n1) = FairDivideBoundary(TG.TG_local().rank(), 
                                              int(G.num_elements()), 
                                              TG.TG_local().size());
        fill_n(G.origin()+n0, n1-n0, ComplexType(0.0));
        TG.TG_local().barrier();
      }
      // calculate G and overlap
      SDetOp.BatchedMixedDensityMatrixFromConfiguration(OrbMats[0], SM.sliced(w0,w1),
                      Gwork.sliced(w0, w1), LogOverlapFactor, Ovmsd[0][nd].sliced(w0,w1), 
                      confg_dev.origin(), true);
      // transpose if needed
      if(transposed_G_for_E_) 
      {
        fill_n(G[w0].origin(), (w1-w0)*G[w0].num_elements(), ComplexType(0.0));
        auto G3D = G.rotated().partitioned(Gdims.first).unrotated();  
        ma::copy_select(Gwork.sliced(w0,w1),G3D.sliced(w0,w1),confg_dev);
      } 
      else
      {
        fill_n(Gt.origin(), Gt.num_elements(), ComplexType(0.0));
        ma::copy_select(Gwork.sliced(w0,w1),Gt,confg_dev);
        ma::transpose( Gt.rotated().flatted().unrotated(), G(boost::multi::ALL, {w0,w1}) ); 
      }
      TG.TG_local().barrier();
      HamOp.energy(eloc2, G, 0, TG.TG_local().root(), true, true);
      if(TG.TG_local().size() > 1 ) {
        // reduce_n since Emsd is in shared memory (doing this instead of copy with mutex)
        TG.TG_local().reduce_n(raw_pointer_cast(eloc2.origin()), 3 * nwalk, 
                               raw_pointer_cast(Emsd[0][nd].origin()), std::plus<>(), 0);
        TG.TG_local().barrier();
      } else {
        copy_n(eloc2.origin(), 3 * nwalk, Emsd[0][nd].origin()); 
      }
    }  // nd
  }
  else
  {
    // if memory becomes a problem, make a large loop outside everything and loop over walker blocks
    StaticSHMSPMatrix KEleft({nwalk, nkev}, SPComplexType(0.0),
                     shm_buffer_manager.get_generator().template get_allocator<SPComplexType>());
    // since this is used for both unique_up/down information
    StaticSHMSP3Tensor KEright({maxn_unique_confg, nwalk, nkev}, SPComplexType(0.0),
                     shm_buffer_manager.get_generator().template get_allocator<SPComplexType>());
    int w0, w1;
    std::tie(w0, w1) = FairDivideBoundary(TG.TG_local().rank(), nwalk, TG.TG_local().size());
    for (int spin = 0; spin < nspins; ++spin)
    {
      auto SM=wset.SlaterMatrices( (spin == 0 ? Alpha : Beta) );
      confg.resize((spin == 0) ? nup : ndown);
      auto Gdims     = dm_dims(false, SpinTypes(spin));
      auto Gdims_ref = dm_dims_ref(false, SpinTypes(spin));
      int nr = Gdims.first * Gdims.second, nc = nwalk;
      if (transposed_G_for_E_)
        std::swap(nr, nc);
      StaticSHMMatrix G({nr, nc},
                     shm_buffer_manager.get_generator().template get_allocator<ComplexType>()); 
      // compute [nwalk][...] and transpose at end
      StaticSHM3Tensor Gwork({nwalk, Gdims_ref.first, Gdims_ref.second}, 
                     shm_buffer_manager.get_generator().template get_allocator<ComplexType>());
      int ix = ( transposed_G_for_E_ ? 0 : 1 );  
      Static3Tensor Gt({ix*(w1-w0), Gdims.first, Gdims.second}, 
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
      
      for (int nd = 0; nd < int(nexcit[spin]); ++nd)
      {
        abij.get_configuration(spin, nd, confg);
        copy_n(confg.data(), confg.size(), confg_dev.origin());
        {
          int n0, n1;
          std::tie(n0, n1) = FairDivideBoundary(TG.TG_local().rank(), 
                                                int(G.num_elements()), 
                                                TG.TG_local().size());
          fill_n(G.origin()+n0, n1-n0, ComplexType(0.0));
          TG.TG_local().barrier();
        }
        // calculate G and overlap
        SDetOp.BatchedMixedDensityMatrixFromConfiguration(OrbMats[spin], SM.sliced(w0,w1),
                        Gwork.sliced(w0, w1), LogOverlapFactor, Ovmsd[spin][nd].sliced(w0,w1), 
                        confg_dev.origin(), true);
        // transpose if needed
        if(transposed_G_for_E_) 
        {
          fill_n(G[w0].origin(), (w1-w0)*G[w0].num_elements(), ComplexType(0.0));
          auto G3D = G.rotated().partitioned(Gdims.first).unrotated();  
          ma::copy_select(Gwork.sliced(w0,w1),G3D.sliced(w0,w1),confg_dev.sliced(0,confg.size()));
        } 
        else
        {
          fill_n(Gt.origin(), Gt.num_elements(), ComplexType(0.0));
          ma::copy_select(Gwork.sliced(w0,w1),Gt,confg_dev.sliced(0,confg.size()));
          ma::transpose( Gt.rotated().flatted().unrotated(), G(boost::multi::ALL, {w0,w1}) ); 
        }
        TG.TG_local().barrier();
        if (spin == 0)
        {
          auto KEr = KEright[nd];
          HamOp.energy(Alpha, eloc2, G, 0, KEr, 
                       TG.TG_local().root(), true, true);
          if(TG.TG_local().size() > 1 ) {
            // reduce_n since Emsd is in shared memory (doing this instead of copy with mutex)
            TG.TG_local().reduce_n(raw_pointer_cast(eloc2.origin()), 3 * nwalk, 
                                   raw_pointer_cast(Emsd[spin][nd].origin()), std::plus<>(), 0);
            TG.TG_local().barrier();
          } else {
            copy_n(eloc2.origin(), 3 * nwalk, Emsd[spin][nd].origin()); 
          }
        }
        else
        {
          HamOp.energy(Beta, eloc2, G, 0, KEleft,
                       TG.TG_local().root(), true, true);
          if(TG.TG_local().size() > 1 ) {
            TG.TG_local().reduce_n(raw_pointer_cast(eloc2.origin()), 3 * nwalk, 
                                   raw_pointer_cast(Emsd[spin][nd].origin()), std::plus<>(), 0);
            TG.TG_local().barrier();
          } else {
            copy_n(eloc2.origin(), 3 * nwalk, Emsd[spin][nd].origin()); 
          }
          // when spin == 1, KEright already contains contraction over unique up configurations
          auto tmp = eloc2.flatted().sliced(0,nwalk);  
          // tmp[iw] = sum_n KEr[nd][iw][n] KEl[iw][n]
          ma::dot('N','N',KEright[nd],KEleft,tmp);
          // tmp[iw] *= Ovmsd[spin][nd][iw]
          ma::elementwise(ma::TOp_MUL, Ovmsd[spin][nd], tmp);
          // opSpinEJ[iw] += tmp[iw]
          ma::axpy(ComplexType(1.0), tmp,  opSpinEJ);  
        }
      }  // nd
      if (spin == 0) {
        if(TG.TG_local().size() > 1)
          APP_ABORT(" Error: Finish core parallelization in PHMSD! \n\n");
        StaticSHMSP3Tensor Tdn( {nexcit[0], nwalk, nkev}, SPComplexType(0.0), 
                     shm_buffer_manager.get_generator().template get_allocator<SPComplexType>());
        // scale KE vectors by overlaps:  KEright[nd][iw][n] *= Ovmsd[0][nd][iw] 
        ma::elementwise(ma::TOp_MUL, 0, Ovmsd[0].sliced(0, nexcit[0]), KEright.sliced(0, nexcit[0]));
        // Tdn[idet_down][iw][n] = DetCouplings[idet_down][idet_up] * KEright[idet_up][iw][n] 
        copy_n( KEright.origin(), Tdn.num_elements(), Tdn.origin() );
        auto Tdn2D = Tdn.rotated().flatted().unrotated();
        auto KEr2D = KEright.rotated().flatted().unrotated();
        ma::product(OpSpinDetCouplings_sp[1], Tdn2D, 
                                  KEr2D.sliced(0, nexcit[1])); 
      }
    } // spin
  }
  TG.TG_local().barrier();

  // 2. assemble sum over configurations
  if (walker_type == COLLINEAR)
  {
    // weight[iw]_u/d = sum_d/u Ov[u][iw] *OpSpinDetCouplings[u][d] Ov[d][iw] 
    // E[iw] += sum_u weight[iw]_u * E[u][iw] + sum_d weight[iw]_d * E[d][iw]
    // Ovmsd( {nspins, maxn_unique_confg, nwalk}    )
    // Emsd ( {nspins, maxn_unique_confg, nwalk, 3} )
    StaticMatrix wgt({maxn_unique_confg, nwalk}, ComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<ComplexType>()); 
    // spin up
    // W[u][iw] = sum_d OpSpinDetCouplings[u][d] Ov[d][iw]   
    ma::product(OpSpinDetCouplings[0], Ovmsd[1].sliced(0, nexcit[1]), wgt.sliced(0, nexcit[0]));
    // W[u][iw] *= Ovmsd[0][u][iw]   
    ma::elementwise(ma::TOp_MUL, Ovmsd[0].sliced(0, nexcit[0]), wgt.sliced(0, nexcit[0]));
    // Ov[iw] = sum_u W[u][iw]  
    ma::accumulate(0, wgt.sliced(0, nexcit[0]), Ov); 

    // Emsd[0][u][iw][0:3] *= W[u][iw] 
    ma::elementwise(ma::TOp_MUL, 0, wgt.sliced(0, nexcit[0]).flatted(), 
                        Emsd[0].sliced(0, nexcit[0]).flatted());

    // spin down
    // W[d][iw] = sum_u OpSpinDetCouplings[d][u] Ov[u][iw]   
    ma::product(OpSpinDetCouplings[1], Ovmsd[0].sliced(0, nexcit[0]), wgt.sliced(0, nexcit[1]));
    // W[d][iw] *= Ovmsd[1][d][iw]   
    ma::elementwise(ma::TOp_MUL, Ovmsd[1].sliced(0, nexcit[1]), wgt.sliced(0, nexcit[1]));

    // Emsd[1][d][iw][0:3] *= W[d][iw] 
    ma::elementwise(ma::TOp_MUL, 0, wgt.sliced(0, nexcit[1]).flatted(), 
                        Emsd[1].sliced(0, nexcit[1]).flatted());
  } else {
    // Ovmsd[0][u][iw] *= OpSpinDetCouplings[d][u]
    Vector_ref_<pointer> Xu(make_device_ptr(OpSpinDetCouplings[1].non_zero_values_data(0)), 
			    iextensions<1u>{nexcit[0]});
    ma::elementwise(ma::TOp_MUL, 0, Xu, Ovmsd[0].sliced(0, nexcit[0]));

    // Ov[iw] = sum_u Ovmsd[0][u][iw]   
    ma::accumulate(0, Ovmsd[0].sliced(0, nexcit[0]), Ov); 

    // Emsd[0][u][iw][0:3] *= W[u][iw] 
    ma::elementwise(ma::TOp_MUL, 0, Ovmsd[0].sliced(0, nexcit[0]).flatted(),
                        Emsd[0].sliced(0, nexcit[0]).flatted());     
  }

  // E[iw][0:3] = sum_s_u Emsd[s][u][iw][0:3], since Emsd contains wgt factors
  auto E1D = E.flatted(); 
  // since Emsd should be zero beyond nexcit[spin], summing everything for better efficiency
  auto Emsd2D = Emsd.flatted().rotated().flatted().unrotated();
  ma::accumulate(0, Emsd2D, E1D); 

  // 3. reduce over TG_local
  if( TG.TG_local().size() > 1 ) {  
    if(walker_type == COLLINEAR)
      TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(opSpinEJ.origin()), nwalk, std::plus<>());
    TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(Ov.origin()), nwalk, std::plus<>());
    TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(E.origin()), 3 * nwalk, std::plus<>());
  }  
  if(walker_type == COLLINEAR)
    ma::axpy(ComplexType(1.0), opSpinEJ, E(E.extension(0), 2));  
  ma::elementwise(ma::TOp_DIV, 0, Ov, E); 
  TG.TG_local().barrier();
}

/*
   * Calculates the local energy and overlaps of all the walkers in the set and 
   * returns them in the appropriate data structures
  */
template<bool MP>
template<class WlkSet, class Mat, class TVec>
void PHMSD<MP>::energy_shared_alg1(const WlkSet& wset, Mat&& E, TVec&& Ov)
{
  if(TG.TG_local().size() > 1)
    APP_ABORT(" Error: energy algorithm 1 not yet implemented with ncore>1.\n\n");
  using ma::conj;
  using std::get;
  using std::fill_n;
  using std::copy_n;
  int nspins  = (walker_type==COLLINEAR?2:1);
  size_t nkev = HamOp.number_of_ke_vectors();
  RUNTIME_CHECK(E.dimensionality == 2, "");
  RUNTIME_CHECK(Ov.dimensionality == 1, "");
  RUNTIME_CHECK(E.size(0) == wset.size(), "");
  RUNTIME_CHECK(Ov.size(0) == wset.size(), "");
  RUNTIME_CHECK(E.size(1) == 3, "");

  ComplexType zero(0.0);
  auto nwalk = wset.size();
  double LogOverlapFactor(wset.getLogOverlapFactor());

  fill_n(Ov.origin(), nwalk, zero);
  fill_n(E.origin(), 3 * nwalk, zero);

  long nexcit[2] = {long(abij.number_of_unique_excitations()[0]), 
                    long(abij.number_of_unique_excitations()[1])};
  std::vector<int> confg(nup);
  IVector confg_dev(iextensions<1u>{nup}); 

  if (walker_type != COLLINEAR)
  {
    APP_ABORT("Error: Finish implementation of PHMSD for CLOSED/NONCOLLINEAR walkers.");
  } 
  else  
  {
    auto GAdims0 = dm_dims_ref(false, Alpha);
    auto GBdims0 = dm_dims_ref(false, Beta);

    // generalize later
    int nbatch__ = nwalk;

    StaticMatrix ebuff({nbatch__, 3}, ComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
    StaticMatrix overlaps({2, nbatch__}, ComplexType(0.0),
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    // storage for reference Green functions
    Static3Tensor GA0({nbatch__, GAdims0.first, GAdims0.second}, 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor GB0({nbatch__, GBdims0.first, GBdims0.second}, 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor QQ0inv0_buff({nbatch__, OrbMats[0].size(0), nup}, 
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor QQ0inv1_buff({nbatch__, OrbMats[1].size(0), ndown}, 
                     buffer_manager.get_generator().template get_allocator<ComplexType>());

    auto SMup=wset.SlaterMatrices(Alpha);
    auto SMdn=wset.SlaterMatrices(Beta);

/*
    long max_ndet_nex=0;
    for (int nex = 1; nex < abij.maximum_excitation_number()[0]; nex++)
    {
      int ndet = abij.number_of_unique_excitations(nex)[0];
      if( ndet * (nex+1) > max_ndet_nex ) max_ndet_nex = ndet * (nex+1);
    }
*/

    for (int iw = 0; iw < nwalk; iw+=nbatch__)
    {
      int nb = std::min(nbatch__, nwalk - iw);
      auto eloc=ebuff.sliced(0, nb);
      auto GA= GA0.sliced(0, nb);
      auto GB= GB0.sliced(0, nb);
      auto local_QQ0inv0 = QQ0inv0_buff.sliced(0, nb);
      auto local_QQ0inv1 = QQ0inv1_buff.sliced(0, nb);
      StaticSHM3Tensor Ovlps({nspins, maxn_unique_confg, nb}, ComplexType(0.0),
                     shm_buffer_manager.get_generator().template get_allocator<ComplexType>()); 

      // 1. calculate reference GF and list of overlaps
      SDetOp.BatchedMixedDensityMatrixForWoodbury(OrbMats[0], SMup.sliced(iw,iw+nb), GA,
            LogOverlapFactor, overlaps[0].sliced(0,nb), refc_dev.origin(), local_QQ0inv0, true);

#if defined(ENABLE_CUDA)
      calculate_overlaps(0, 1, 0, abij, local_QQ0inv0, Ovlps[0].sliced(0,nexcit[0]));
#else
      for(int i=0; i<nb; ++i)
        calculate_overlaps(0, 1, 0, abij, local_QQ0inv0[i], Ovlps[0]({0,nexcit[0]}, i));
#endif

      SDetOp.BatchedMixedDensityMatrixForWoodbury(OrbMats[1], SMdn.sliced(iw,iw+nb), GB,
            LogOverlapFactor, overlaps[1].sliced(0,nb), refc_dev.origin()+nup, local_QQ0inv1, true);
#if defined(ENABLE_CUDA)
      calculate_overlaps(0, 1, 1, abij, local_QQ0inv1, Ovlps[1].sliced(0,nexcit[1]));
#else
      for(int i=0; i<nb; ++i)
        calculate_overlaps(0, 1, 1, abij, local_QQ0inv1[i], Ovlps[1]({0,nexcit[1]}, i));
#endif

      // multiply Ovlps by overlaps
      // Ovlps[s][u][iw] *= overlaps[iw]   
      ma::elementwise(ma::TOp_MUL, 1, overlaps[0].sliced(0,nb), Ovlps[0].sliced(0,nexcit[0]));
      ma::elementwise(ma::TOp_MUL, 1, overlaps[1].sliced(0,nb), Ovlps[1].sliced(0,nexcit[1]));

      StaticSHMSP3Tensor KEright({maxn_unique_confg, nb, nkev}, SPComplexType(0.0),
                     shm_buffer_manager.get_generator().template get_allocator<SPComplexType>());
      { // spin up
        // 2a. calculate weights
        StaticMatrix wgt({nexcit[0], nb}, SPComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
        // W[u][iw] = sum_d OpSpinDetCouplings[u][d] Ov[d][iw]   
        ma::product(OpSpinDetCouplings[0], Ovlps[1].sliced(0, nexcit[1]), wgt);
        // W[u][iw] *= Ovlps[0][u][iw]   
        ma::elementwise(ma::TOp_MUL, Ovlps[0].sliced(0,nexcit[0]), wgt);
        // Ov[iw] = sum_u W[u][iw]  
        ma::accumulate(0, wgt, Ov.sliced(iw,iw+nb));

        // 3a. Reference energy and temporary matrices
        auto KEr = KEright[0];
        HamOp.ph_reference_energy(Alpha, eloc, GA.rotated().flatted().unrotated(), 
                    KEr, TG.TG_local().root());
        // MAM: ph_excited_energies calculates and adds sum_d wgt[d] * (E[d]-Eref)
        // so I need to add here: sum_d wgt[d] Eref = Ov * Eref
        // E[iw][:] *= Ov[iw]   
        ma::elementwise(ma::TOp_MUL, 0, Ov.sliced(iw,iw+nb), eloc);
        ma::add(ComplexType(1.0), eloc, ComplexType(1.0), E.sliced(iw, iw+nb), E.sliced(iw, iw+nb));

        // 4a. calculate R matrices and evaluate E, KEright 
        ph_excited_energies_first_step(nup, OrbMats[0].size(0), abij, wgt, 
                    local_QQ0inv0, eloc, KEright.sliced(0,nexcit[0]), HamOp);
        ma::add(ComplexType(1.0), eloc, ComplexType(1.0), E.sliced(iw, iw+nb), E.sliced(iw, iw+nb));

        StaticSHMSP3Tensor Tdn( {nexcit[0], nwalk, nkev}, SPComplexType(0.0),
                     shm_buffer_manager.get_generator().template get_allocator<SPComplexType>());
        // scale KE vectors by overlaps:  KEright[nd][iw][n] *= Ovmsd[0][nd][iw] 
        ma::elementwise(ma::TOp_MUL, 0, Ovlps[0].sliced(0, nexcit[0]), KEright.sliced(0, nexcit[0]));
        // Tdn[idet_down][iw][n] = DetCouplings[idet_down][idet_up] * KEright[idet_up][iw][n] 
        copy_n( KEright.origin(), Tdn.num_elements(), Tdn.origin() );
        auto Tdn2D=Tdn.rotated().flatted().unrotated();
        auto KEr2D = KEright.rotated().flatted().unrotated();
        ma::product(OpSpinDetCouplings_sp[1], Tdn2D,
                                  KEr2D.sliced(0, nexcit[1]));
        // scale KE vectors by overlaps:  KEright[nd][iw][n] *= Ovmsd[1][nd][iw] 
        ma::elementwise(ma::TOp_MUL, 0, Ovlps[1].sliced(0, nexcit[1]), KEright.sliced(0, nexcit[1]));
      }

      { // spin down
        // 2b. calculate weights
        StaticMatrix wgt({nexcit[1], nb}, SPComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
        // W[u][iw] = sum_d OpSpinDetCouplings[u][d] Ov[d][iw]   
        ma::product(OpSpinDetCouplings[1], Ovlps[0].sliced(0, nexcit[0]), wgt);
        // W[u][iw] *= Ovlps[0][u][iw]   
        ma::elementwise(ma::TOp_MUL, Ovlps[1].sliced(0,nexcit[1]), wgt);

        // 3b. Reference energy and temporary matrices
        StaticSHMSPMatrix KEleft({nb, nkev}, SPComplexType(0.0),
                     shm_buffer_manager.get_generator().template get_allocator<SPComplexType>());
        HamOp.ph_reference_energy(Beta, eloc, GB.rotated().flatted().unrotated(), 
                    KEleft, TG.TG_local().root());
        // E[iw][:] *= Ov[iw] ; see note above about factor of Ov (instead of wgt)
        ma::elementwise(ma::TOp_MUL, 0, Ov.sliced(iw,iw+nb), eloc);
        ma::add(ComplexType(1.0), eloc, ComplexType(1.0), E.sliced(iw, iw+nb), E.sliced(iw, iw+nb));

        auto tmp = eloc.flatted().sliced(0,nb);
        // tmp[iw] = sum_n KEr[nd][iw][n] KEl[iw][n]
        ma::dot('N','N',KEright[0],KEleft,tmp);
        // opSpinEJ[iw] += tmp[iw]
        ma::axpy(ComplexType(1.0), tmp, E({iw, iw+nb}, 2));

        //4b. calculate R matrices and evaluate E, KEright 
        ph_excited_energies_second_step(ndown, OrbMats[1].size(0), abij, wgt, 
                            local_QQ0inv1, eloc, KEright.sliced(0, nexcit[1]),  HamOp);
        ma::add(ComplexType(1.0), eloc, ComplexType(1.0), E.sliced(iw, iw+nb), E.sliced(iw, iw+nb));
      }
    }
  }
  TG.TG_local().barrier();
  if(TG.TG_local().size() > 1 )
    TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(E.origin()), E.num_elements(), std::plus<>());

  // Normalize Energies  
  ma::elementwise(ma::TOp_DIV, 0, Ov, E); 
  TG.TG_local().barrier();
}

template<bool MP>
template<class WlkSet, class Mat, class TVec>
void PHMSD<MP>::energy_shared_alg2([[maybe_unused]] const WlkSet& wset, [[maybe_unused]] Mat&& E, [[maybe_unused]] TVec&& Ov)
{
  APP_ABORT(" Error: Finish PHMSD::energy_shared_alg2. ");
}

/*
   * Calculates the local energy and overlaps of all the walkers in the set and 
   * returns them in the appropriate data structures
   */
template<bool MP>
template<class WlkSet, class Mat, class TVec>
void PHMSD<MP>::Energy_distributed([[maybe_unused]] const WlkSet& wset, [[maybe_unused]] Mat&& E, [[maybe_unused]] TVec&& Ov)
{
  APP_ABORT(" Error: Finish PHMSD::Energy_distributed. ");
}

/*
   * This routine has (potentially) considerable overhead if either the number of determinants
   *   or the number of walkers changes.   
   * G is assumed to be in shared memory
   * Ov is assumed to be local to the core
   */
template<bool MP>
template<class WlkSet, class MatG, class TVec, class MatOv>
void PHMSD<MP>::MixedDensityMatrix_impl(const WlkSet& wset, MatG&& G, TVec&& Ov, 
                                    MatOv&& Ovlps, bool compact, bool transpose)
{
  using ma::T;
  using std::fill_n;
  RUNTIME_CHECK(G.stride(1) == 1, "");
  RUNTIME_CHECK(Ov.stride(0) == 1, "");
  if (transpose)
    RUNTIME_CHECK(G.size(0) == wset.size() && G.size(1) == size_t(dm_size(not compact)), "");
  else
    RUNTIME_CHECK(G.size(1) == wset.size() && G.size(0) == size_t(dm_size(not compact)), "");
  int nspins  = (walker_type==COLLINEAR?2:1);
  const int nw = wset.size();
  double LogOverlapFactor(wset.getLogOverlapFactor());
  long nexcit[2] = {long(abij.number_of_unique_excitations()[0]), 
                    long(abij.number_of_unique_excitations()[1])};
  RUNTIME_CHECK(Ov.size() >= nw, "");
  RUNTIME_CHECK(Ovlps.size(0) == nspins, "");
  RUNTIME_CHECK(Ovlps.size(1) == maxn_unique_confg, "");
  RUNTIME_CHECK(Ovlps.size(2) == nw, "");
  fill_n(Ov.origin(), nw, ComplexType(0.0));
  {
    int n0, n1;
    std::tie(n0, n1) = FairDivideBoundary(TG.TG_local().rank(), int(G.size(0)), 
                                          TG.TG_local().size());
    ma::fill(G.sliced(n0,n1), ComplexType(0.0));
  }  
  TG.TG_local().barrier();

  if (walker_type == NONCOLLINEAR)
  {
    // always calculate compact and multiply by OrbMat at the end if full
    auto Gdims      = dm_dims(false, Alpha);
    auto Gdims_full = dm_dims(true, Alpha);
    if (compact)
      Gdims_full = {0, 0};
    auto Gdims0 = dm_dims_ref(false, Alpha);
    //size_t cnt   = 0;
    const int ntasks_percore      = nw / TG.getNCoresPerTG();
    const int ntasks_total_serial = ntasks_percore * TG.getNCoresPerTG();
    const int nextra              = nw - ntasks_total_serial;
    if(nextra != 0) 
      APP_ABORT(" Error in PHMSD: ncores must divide #walkers.");	

    // each processor does ntasks_percore_serial overlaps serially
    const int w0 = TG.getLocalTGRank() * ntasks_percore;
    const int wN = (TG.getLocalTGRank() + 1) * ntasks_percore;
    const int nbatch__  = std::min((wN-w0), (nbatch < 0 ? (wN-w0) : nbatch));

    StaticVector overlaps(iextensions<1u>{nbatch__}, ComplexType(0.0), 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    // storage for reference Green functions
    Static3Tensor GA0({nbatch__, Gdims0.first, Gdims0.second}, 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor QQ0inv0_buff({nbatch__, OrbMats[0].size(0), nup}, 
                     buffer_manager.get_generator().template get_allocator<ComplexType>());

    auto SM=wset.SlaterMatrices(Alpha);

    for (int iw = w0; iw < wN; iw+=nbatch__)
    {
      int nb = std::min(nbatch__, wN - iw);  
      auto GA= GA0.sliced(0, nb);  
      auto local_QQ0inv0= QQ0inv0_buff.sliced(0, nb);  

      // 1. calculate list of overlaps
      SDetOp.BatchedMixedDensityMatrixForWoodbury(OrbMats[0], SM.sliced(iw,iw+nb), GA, 
            LogOverlapFactor, overlaps.sliced(0,nb), refc_dev.origin(), local_QQ0inv0, true);

#if defined(ENABLE_CUDA)
      calculate_overlaps(0, 1, 0, abij, local_QQ0inv0, Ovlps[0].sliced(0,nexcit[0]));
#else
      for(int i=0; i<nb; ++i)
        calculate_overlaps(0, 1, 0, abij, local_QQ0inv0[i], Ovlps[0]({0,nexcit[0]}, iw+i));
#endif

      // multiply Ovlps by overlaps
      // Ovlps[s][u][iw] *= overlaps[iw]   
      ma::elementwise(ma::TOp_MUL, 1, overlaps.sliced(0,nb), Ovlps[0]({0,nexcit[0]},{iw,iw+nb}));

      // 2. generate R[Nact,Nel] and generate G
      {
        // Ovlps[0][u][iw] *= OpSpinDetCouplings[d][u]
        Vector_ref_<pointer> Xu(make_device_ptr(OpSpinDetCouplings[1].non_zero_values_data(0)), 
			    iextensions<1u>{nexcit[0]});
        ma::elementwise(ma::TOp_MUL, 0, Xu, Ovlps[0]({0, nexcit[0]},{iw,iw+nb}));

        // Ov[iw] = sum_u Ovlps[0][u][iw]   
        ma::accumulate(0, Ovlps[0]({0, nexcit[0]},{iw,iw+nb}), Ov.sliced(iw,iw+nb)); 

        Static3Tensor Ra({nb, nup, long(OrbMats[0].size(0))}, ComplexType(0.0), 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
#if defined(ENABLE_CUDA)
        calculate_R(0, 1, 0, abij, local_QQ0inv0, Ovlps[0]({0, nexcit[0]},{iw,iw+nb}), Ra);
#else
        for(int i=0; i<nb; ++i)
          calculate_R(0, 1, 0, abij, local_QQ0inv0[i], Ovlps[0](boost::multi::ALL,i), Ra[i]);
#endif

        if (transpose)
        {
          if (compact)
          { 
            Array_ref<ComplexType, 3, pointer> Gw(make_device_ptr(G[iw].origin()), 
                                               {nb, Gdims.first, Gdims.second});
            ma::productStridedBatched(T(Ra), GA, Gw(Gw.extension(0), {0,Gdims.first}, Gw.extension(2)));
          }
          else
          {
            Array_ref<ComplexType, 3, pointer> Gw(make_device_ptr(G[iw].origin()), 
                                    {nb, Gdims_full.first, Gdims_full.second});
            Static3Tensor GAt({nb, Gdims.first, Gdims.second}, 
                         buffer_manager.get_generator().template get_allocator<ComplexType>());
            ma::productStridedBatched(T(Ra), GA, GAt);
            ma::productStridedBatched(T(OrbMats[0]), GAt, Gw); 
          }
        }
        else
        {
          Static3Tensor GAt({nb, Gdims.first, Gdims.second}, 
                         buffer_manager.get_generator().template get_allocator<ComplexType>());
          if (compact)
          {
            ma::productStridedBatched(T(Ra), GA, GAt);
            ma::transpose(GAt.rotated().flatted().unrotated(),
                          G({0, Gdims.first * Gdims.second}, {iw, iw+nb}));
          }
          else
          {
            Static3Tensor Gfulla({nb, Gdims_full.first, Gdims_full.second}, 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
            ma::productStridedBatched(T(Ra), GA, GAt);
            ma::productStridedBatched(T(OrbMats[0]), GAt, Gfulla);
            ma::transpose(Gfulla.rotated().flatted().unrotated(),
                          G({0, Gdims_full.first * Gdims_full.second}, {iw, iw+nb}));
          }
        }
      }
    }
  }
  else
  {
    // always calculate compact and multiply by OrbMat at the end if full
    auto GAdims      = dm_dims(false, Alpha);
    auto GBdims      = dm_dims(false, Beta);
    auto GAdims_full = dm_dims(true, Alpha);
    auto GBdims_full = dm_dims(true, Beta);
    if (compact)
    {
      GAdims_full = {0, 0};
      GBdims_full = {0, 0};
    }
    auto GAdims0 = dm_dims_ref(false, Alpha);
    auto GBdims0 = dm_dims_ref(false, Beta);
    const int ntasks_percore      = nw / TG.getNCoresPerTG();
    const int ntasks_total_serial = ntasks_percore * TG.getNCoresPerTG();
    const int nextra              = nw - ntasks_total_serial;
    if(nextra != 0) 
      APP_ABORT(" Error in PHMSD: ncores must divide #walkers.");	

    // each processor does ntasks_percore_serial overlaps serially
    const int w0 = TG.getLocalTGRank() * ntasks_percore;
    const int wN = (TG.getLocalTGRank() + 1) * ntasks_percore;
    const int nbatch__  = std::min((wN-w0), (nbatch < 0 ? (wN-w0) : nbatch));

    StaticMatrix overlaps({2, nbatch__}, ComplexType(0.0), 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    // storage for reference Green functions
    Static3Tensor GA0({nbatch__, GAdims0.first, GAdims0.second}, 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor GB0({nbatch__, GBdims0.first, GBdims0.second},
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor QQ0inv0_buff({nbatch__, OrbMats[0].size(0), nup}, 
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor QQ0inv1_buff({nbatch__, OrbMats[1].size(0), ndown}, 
                     buffer_manager.get_generator().template get_allocator<ComplexType>());

    auto SMup=wset.SlaterMatrices(Alpha);
    auto SMdn=wset.SlaterMatrices(Beta);

    for (int iw = w0; iw < wN; iw+=nbatch__)
    {
      int nb = std::min(nbatch__, wN - iw);  
      auto GA = GA0.sliced(0, nb) ;  
      auto GB = GB0.sliced(0, nb) ;  
      auto local_QQ0inv0 = QQ0inv0_buff.sliced(0, nb);  
      auto local_QQ0inv1 = QQ0inv1_buff.sliced(0, nb);  

      // 1. calculate list of overlaps
      SDetOp.BatchedMixedDensityMatrixForWoodbury(OrbMats[0], SMup.sliced(iw,iw+nb), GA, 
            LogOverlapFactor, overlaps[0].sliced(0,nb), refc_dev.origin(), local_QQ0inv0, true);

#if defined(ENABLE_CUDA)
      calculate_overlaps(0, 1, 0, abij, local_QQ0inv0, Ovlps[0].sliced(0,nexcit[0]));
#else
      for(int i=0; i<nb; ++i)
        calculate_overlaps(0, 1, 0, abij, local_QQ0inv0[i], Ovlps[0]({0,nexcit[0]}, iw+i));
#endif

      SDetOp.BatchedMixedDensityMatrixForWoodbury(OrbMats[1], SMdn.sliced(iw,iw+nb), GB,
            LogOverlapFactor, overlaps[1].sliced(0,nb), refc_dev.origin()+nup, local_QQ0inv1, true);
#if defined(ENABLE_CUDA)
      calculate_overlaps(0, 1, 1, abij, local_QQ0inv1, Ovlps[1].sliced(0,nexcit[1]));
#else
      for(int i=0; i<nb; ++i)
        calculate_overlaps(0, 1, 1, abij, local_QQ0inv1[i], Ovlps[1]({0,nexcit[1]}, iw+i)); 
#endif

      // multiply Ovlps by overlaps
      // Ovlps[s][u][iw] *= overlaps[iw]   
      ma::elementwise(ma::TOp_MUL, 1, overlaps[0].sliced(0,nb), Ovlps[0]({0,nexcit[0]},{iw,iw+nb}));
      ma::elementwise(ma::TOp_MUL, 1, overlaps[1].sliced(0,nb), Ovlps[1]({0,nexcit[1]},{iw,iw+nb}));

      // 2. generate R[Nact,Nel] and generate G
      {
        StaticMatrix wgt({nexcit[0], nb}, ComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
        // W[u][iw] = sum_d OpSpinDetCouplings[u][d] Ov[d][iw]   
        ma::product(OpSpinDetCouplings[0], Ovlps[1]({0, nexcit[1]},{iw,iw+nb}), wgt);
        // W[u][iw] *= Ovlps[0][u][iw]   
        ma::elementwise(ma::TOp_MUL, Ovlps[0]({0,nexcit[0]},{iw,iw+nb}), wgt);
        // Ov[iw] = sum_u W[u][iw]  
        ma::accumulate(0, wgt, Ov.sliced(iw,iw+nb));

        Static3Tensor Ra({nb, nup, long(OrbMats[0].size(0))}, ComplexType(0.0), 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
#if defined(ENABLE_CUDA)
        calculate_R(0, 1, 0, abij, local_QQ0inv0, wgt, Ra);
#else
        for(int i=0; i<nb; ++i)
          calculate_R(0, 1, 0, abij, local_QQ0inv0[i], wgt(wgt.extension(0),i), Ra[i]);
#endif

        if (transpose)
        {
          if (compact)
          { 
            Array_ref<ComplexType, 3, pointer> Gw(make_device_ptr(G[iw].origin()), 
                                               {nb, GAdims.first+GBdims.first, GAdims.second});
            ma::productStridedBatched(T(Ra), GA, Gw(Gw.extension(0), {0,GAdims.first}, Gw.extension(2)));
          }
          else
          {
            Array_ref<ComplexType, 3, pointer> Gw(make_device_ptr(G[iw].origin()), 
                                    {nb, GAdims_full.first+GBdims_full.first, GAdims_full.second});
            Static3Tensor GAt({nb, GAdims.first, GAdims.second}, 
                         buffer_manager.get_generator().template get_allocator<ComplexType>());
            ma::productStridedBatched(T(Ra), GA, GAt);
            ma::productStridedBatched(T(OrbMats[0]), GAt, 
                    Gw(Gw.extension(0), {0,GAdims_full.first}, Gw.extension(2)));
          }
        }
        else
        {
          Static3Tensor GAt({nb, GAdims.first, GAdims.second}, 
                         buffer_manager.get_generator().template get_allocator<ComplexType>());
          if (compact)
          {
            ma::productStridedBatched(T(Ra), GA, GAt);
            ma::transpose(GAt.rotated().flatted().unrotated(),
                          G({0, GAdims.first * GAdims.second}, {iw, iw+nb}));
          }
          else
          {
            Static3Tensor Gfulla({nb, GAdims_full.first, GAdims_full.second},
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
            ma::productStridedBatched(T(Ra), GA, GAt);
            ma::productStridedBatched(T(OrbMats[0]), GAt, Gfulla);
            ma::transpose(Gfulla.rotated().flatted().unrotated(),
                          G({0, GAdims_full.first * GAdims_full.second}, {iw, iw+nb}));
          }
        }
      }

      {
        StaticMatrix wgt({nexcit[1], nb}, ComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
        // W[d][iw] = sum_u OpSpinDetCouplings[d][u] Ov[u][iw]   
        ma::product(OpSpinDetCouplings[1], Ovlps[0]({0, nexcit[0]},{iw,iw+nb}), wgt);
        // W[u][iw] *= Ovlps[0][u][iw]   
        ma::elementwise(ma::TOp_MUL, Ovlps[1]({0,nexcit[1]},{iw,iw+nb}), wgt);

        Static3Tensor Rb({nb, ndown, long(OrbMats[1].size(0))}, ComplexType(0.0),
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
#if defined(ENABLE_CUDA)
        calculate_R(0, 1, 1, abij, local_QQ0inv1, wgt, Rb);
#else
        for(int i=0; i<nb; ++i)
          calculate_R(0, 1, 1, abij, local_QQ0inv1[i], wgt(wgt.extension(0),i), Rb[i]);
#endif

        if (transpose)
        { 
          if (compact)
          { 
            Array_ref<ComplexType, 3, pointer> Gw(make_device_ptr(G[iw].origin()), 
                                               {nb, GAdims.first+GBdims.first, GBdims.second});
            ma::productStridedBatched(T(Rb), GB, 
                Gw(Gw.extension(0), {GAdims.first,GAdims.first+GBdims.first}, Gw.extension(2)));
          }
          else
          { 
            Array_ref<ComplexType, 3, pointer> Gw(make_device_ptr(G[iw].origin()), 
                                {nb, GAdims_full.first+GBdims_full.first, GAdims_full.second});
            Static3Tensor GBt({nb, GBdims.first, GBdims.second}, 
                         buffer_manager.get_generator().template get_allocator<ComplexType>());
            ma::productStridedBatched(T(Rb), GB, GBt);
            ma::productStridedBatched(T(OrbMats[1]), GBt, Gw(Gw.extension(0), 
                    {GAdims_full.first,GAdims_full.first+GBdims_full.first}, Gw.extension(2)));
          }
        }
        else
        {
          Static3Tensor GBt({nb, GBdims.first, GBdims.second}, 
                         buffer_manager.get_generator().template get_allocator<ComplexType>());
          if (compact)
          {
            ma::productStridedBatched(T(Rb), GB, GBt);
            ma::transpose(GBt.rotated().flatted().unrotated(),
                          G({GAdims.first * GAdims.second, G.size(0)}, {iw, iw+nb}));
          }
          else
          {
            Static3Tensor Gfull({nb, GBdims_full.first, GBdims_full.second}, 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
            ma::productStridedBatched(T(Rb), GB, GBt);
            ma::productStridedBatched(T(OrbMats[1]), GBt, Gfull);
            ma::transpose(Gfull.rotated().flatted().unrotated(),
                          G({GAdims_full.first * GAdims_full.second, G.size(0)}, {iw, iw+nb}));
          }
        }
      }
    }
  }
  // normalize G
  if(TG.TG_local().size() > 1)
    TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(Ov.origin()), nw, std::plus<>());
  if (transpose)
  {
    int n0, n1;
    std::tie(n0, n1) = FairDivideBoundary(TG.TG_local().rank(), 
                                          int(G.size(1)), TG.TG_local().size());
    ma::elementwise(ma::TOp_DIV, 0, Ov, G(G.extension(0), {n0, n1})); 
  }
  else
  {
    int n0, n1;
    std::tie(n0, n1) = FairDivideBoundary(TG.TG_local().rank(), 
                                          int(G.size(0)), TG.TG_local().size());
    ma::elementwise(ma::TOp_DIV, 1, Ov, G.sliced(n0, n1)); 
  }
  TG.TG_local().barrier();
}

/* 
   * Computes the density matrix for a given reference. 
   * G and Ov are expected to be in shared memory.
   * Simple round-robin is used. 
   */
// MAM: modify this to combine FairShare/Batched dispatch, which should
//      work well in both cpu/gpu cases.
template<bool MP>
template<class WlkSet, class MatA, class MatB, class MatG, class TVec>
void PHMSD<MP>::DensityMatrix_shared(const WlkSet& wset,
                                 MatA&& RefA,
                                 MatB&& RefB,
                                 MatG&& G,
                                 TVec&& Ov,
                                 bool herm,
                                 bool compact,
                                 bool transposed)
{
  RUNTIME_CHECK(G.stride(1) == 1, "");
  RUNTIME_CHECK(Ov.stride(0) == 1, "");
  if (transposed)
    RUNTIME_CHECK(G.size(0) == wset.size() && G.size(1) == size_t(dm_size(not compact)), "");
  else
    RUNTIME_CHECK(G.size(1) == wset.size() && G.size(0) == size_t(dm_size(not compact)), "");
  const int nw = wset.size();
  RUNTIME_CHECK(Ov.size() >= nw, "");
  // to force synchronization before modifying structures in SHM
  TG.TG_local().barrier();
  fill_n(Ov.origin(), Ov.num_elements(), ComplexType(0));
  fill_n(G.origin(), G.num_elements(), ComplexType(0.0));
  TG.TG_local().barrier();
  double LogOverlapFactor(wset.getLogOverlapFactor());

  if (walker_type != COLLINEAR)
  {
    if (herm)
      RUNTIME_CHECK(RefA.size(0) == dm_dims(false, Alpha).first && RefA.size(1) == dm_dims(false, Alpha).second, "");
    else
      RUNTIME_CHECK(RefA.size(1) == dm_dims(false, Alpha).first && RefA.size(0) == dm_dims(false, Alpha).second, "");

    auto Gdims = dm_dims(not compact, Alpha);
    StaticMatrix G2D_({Gdims.first, Gdims.second}, 
                      buffer_manager.get_generator().template get_allocator<ComplexType>());
    for (int iw = 0; iw < nw; ++iw)
    {
      if (iw % TG.TG_local().size() != TG.TG_local().rank())
        continue;
      Ov[iw] = SDetOp.MixedDensityMatrix(RefA, *wset[iw].SlaterMatrix(Alpha), G2D_, LogOverlapFactor, compact, herm);
      if (walker_type == CLOSED)
        Ov[iw] *= ComplexType(Ov[iw]);
      if (transposed)
        G[iw] = G2D_.flatted();
      else
        G(G.extension(0), iw) = G2D_.flatted();
    }
  }
  else
  {
    if (herm)
      RUNTIME_CHECK(RefA.size(0) == dm_dims(false, Alpha).first && RefA.size(1) == dm_dims(false, Alpha).second, "");
    else
      RUNTIME_CHECK(RefA.size(1) == dm_dims(false, Alpha).first && RefA.size(0) == dm_dims(false, Alpha).second, "");
    if (herm)
      RUNTIME_CHECK(RefB.size(0) == dm_dims(false, Beta).first && RefB.size(1) == dm_dims(false, Beta).second, "");
    else
      RUNTIME_CHECK(RefB.size(1) == dm_dims(false, Beta).first && RefB.size(0) == dm_dims(false, Beta).second, "");

    StaticVector ovlps(iextensions<1u>{2 * nw}, ComplexType(0.0), 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    fill_n(ovlps.origin(), 2 * nw, ComplexType(0.0));
    auto GAdims = dm_dims(not compact, Alpha);
    auto GBdims = dm_dims(not compact, Beta);
    StaticMatrix GA2D_({GAdims.first, GAdims.second}, 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    StaticMatrix GB2D_({GBdims.first, GBdims.second}, 
                       buffer_manager.get_generator().template get_allocator<ComplexType>());

    for (int iw = 0; iw < 2 * nw; ++iw)
    {
      if (iw % TG.TG_local().size() != TG.TG_local().rank())
        continue;

      if (iw % 2 == 0)
      {
        ovlps[iw] =
            SDetOp.MixedDensityMatrix(RefA, *wset[iw / 2].SlaterMatrix(Alpha), GA2D_, LogOverlapFactor, compact, herm);
        if (transposed)
          G[iw / 2].sliced(0, GAdims.first * GAdims.second) = GA2D_.flatted();
        else
          G({0, GAdims.first * GAdims.second}, iw / 2) = GA2D_.flatted();
      }
      else
      {
        ovlps[iw] =
            SDetOp.MixedDensityMatrix(RefB, *wset[iw / 2].SlaterMatrix(Beta), GB2D_, LogOverlapFactor, compact, herm);
        if (transposed)
          G[iw / 2].sliced(GAdims.first * GAdims.second, G.size(1)) = GB2D_.flatted();
        else
          G({GAdims.first * GAdims.second, G.size(0)}, iw / 2) = GB2D_.flatted();
      }
    }
    if (TG.TG_local().size() > 1)
      TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(ovlps.origin()), 2 * nw, std::plus<>());
    if (TG.TG_local().root())
      for (int iw = 0; iw < nw; ++iw)
        Ov[iw] = ComplexType(ovlps[2 * iw]) * ComplexType(ovlps[2 * iw + 1]);
  }
  TG.TG_local().barrier();
}

/*
   * Calculates the overlaps of all walkers in the set. Returns values in arrays. 
   * Ov is assumed to be local to the core
   */
template<bool MP>
template<class WlkSet, class TVec>
void PHMSD<MP>::Overlap(const WlkSet& wset, TVec&& Ov)
{
  using std::fill_n;
  const int nw = wset.size();
  RUNTIME_CHECK(Ov.size() == nw, "");
  ma::fill(Ov, ComplexType(0.0));
  double LogOverlapFactor(wset.getLogOverlapFactor());
  long nexcit[2] = {long(abij.number_of_unique_excitations()[0]),
                    long(abij.number_of_unique_excitations()[1])};
  if (walker_type == NONCOLLINEAR)
  {
    const int ntasks_percore      = nw / TG.getNCoresPerTG();
    const int ntasks_total_serial = ntasks_percore * TG.getNCoresPerTG();
    const int nextra              = nw - ntasks_total_serial;
    if(nextra != 0) 
      APP_ABORT(" Error in PHMSD: ncores must divide #walkers."); 

    // each processor does ntasks_percore_serial overlaps serially
    const int w0 = TG.getLocalTGRank() * ntasks_percore;
    const int wN = (TG.getLocalTGRank() + 1) * ntasks_percore;
    const int nbatch__  = std::min((wN-w0), (nbatch < 0 ? (wN-w0) : nbatch));

    StaticVector ov0(iextensions<1u>{nbatch__}, ComplexType(0.0),
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    StaticMatrix ovlp_list({maxn_unique_confg, nbatch__}, ComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor QQ0inv0_buff({nbatch__, OrbMats[0].size(0), nup}, 
                     buffer_manager.get_generator().template get_allocator<ComplexType>());

    auto SM=wset.SlaterMatrices(Alpha);

    for (int iw = w0; iw < wN; iw+=nbatch__)
    {
      int nb = std::min(nbatch__, wN - iw);
      auto local_QQ0inv0= QQ0inv0_buff.sliced(0, nb) ;

      // alpha  
      SDetOp.BatchedOverlapForWoodbury(OrbMats[0], SM.sliced(iw,iw+nb), LogOverlapFactor, 
                ov0.sliced(0,nb), refc_dev.origin(), local_QQ0inv0);
#if defined(ENABLE_CUDA)
      calculate_overlaps(0, 1, 0, abij, local_QQ0inv0, ovlp_list.sliced(0,nexcit[0]));
#else
      for(int i=0; i<nb; ++i)
        calculate_overlaps(0, 1, 0, abij, local_QQ0inv0[i], ovlp_list({0,nexcit[0]}, i));
#endif

      // multiply Ovlps by overlaps
      // Ovlps[s][u][iw] *= ov0[iw]   
      ma::elementwise(ma::TOp_MUL, 1, ov0.sliced(0,nb), ovlp_list({0,nexcit[0]},{0,nb}));

      // Ovlps[0][u][iw] *= OpSpinDetCouplings[d][u]
      Vector_ref_<pointer> Xu(make_device_ptr(OpSpinDetCouplings[1].non_zero_values_data(0)), 
			    iextensions<1u>{nexcit[0]});
      ma::elementwise(ma::TOp_MUL, 0, Xu, ovlp_list({0, nexcit[0]},{0,nb}));

      // Ov[iw] = sum_u ovlp_list[u][iw]   
      ma::accumulate(0, ovlp_list({0, nexcit[0]},{0,nb}), Ov.sliced(iw,iw+nb)); 
    }
  }
  else
  {
    const int ntasks_percore      = nw / TG.getNCoresPerTG();
    const int ntasks_total_serial = ntasks_percore * TG.getNCoresPerTG();
    const int nextra              = nw - ntasks_total_serial;
    if(nextra != 0) 
      APP_ABORT(" Error in PHMSD: ncores must divide #walkers."); 

    // each processor does ntasks_percore_serial overlaps serially
    const int w0 = TG.getLocalTGRank() * ntasks_percore;
    const int wN = (TG.getLocalTGRank() + 1) * ntasks_percore;
    const int nbatch__  = std::min((wN-w0), (nbatch < 0 ? (wN-w0) : nbatch));

    StaticMatrix ov0({2, nbatch__}, ComplexType(0.0),
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor ovlp_list({2, maxn_unique_confg, nbatch__}, ComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor QQ0inv0_buff({nbatch__, OrbMats[0].size(0), nup}, 
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor QQ0inv1_buff({nbatch__, OrbMats[1].size(0), ndown}, 
                     buffer_manager.get_generator().template get_allocator<ComplexType>());

    auto SMup=wset.SlaterMatrices(Alpha);
    auto SMdn=wset.SlaterMatrices(Beta);

    for (int iw = w0; iw < wN; iw+=nbatch__)
    {
      int nb = std::min(nbatch__, wN - iw);
      auto local_QQ0inv0 = QQ0inv0_buff.sliced(0, nb);
      auto local_QQ0inv1 = QQ0inv1_buff.sliced(0, nb);    

      // alpha  
      SDetOp.BatchedOverlapForWoodbury(OrbMats[0], SMup.sliced(iw,iw+nb), LogOverlapFactor, 
                ov0[0].sliced(0,nb), refc_dev.origin(), local_QQ0inv0);
#if defined(ENABLE_CUDA)
      calculate_overlaps(0, 1, 0, abij, local_QQ0inv0, ovlp_list[0].sliced(0,nexcit[0]));
#else
      for(int i=0; i<nb; ++i)
        calculate_overlaps(0, 1, 0, abij, local_QQ0inv0[i], ovlp_list[0]({0,nexcit[0]}, i));
#endif

      // beta
      SDetOp.BatchedOverlapForWoodbury(OrbMats[1], SMdn.sliced(iw,iw+nb), LogOverlapFactor, 
                ov0[1].sliced(0,nb), refc_dev.origin() + nup, local_QQ0inv1);
#if defined(ENABLE_CUDA)
      calculate_overlaps(0, 1, 1, abij, local_QQ0inv1, ovlp_list[1].sliced(0,nexcit[1]));
#else
      for(int i=0; i<nb; ++i)
        calculate_overlaps(0, 1, 1, abij, local_QQ0inv1[i], ovlp_list[1]({0,nexcit[1]}, i));
#endif

      // multiply Ovlps by overlaps
      // Ovlps[s][u][iw] *= ov0[iw]   
      ma::elementwise(ma::TOp_MUL, 1, ov0[0].sliced(0,nb), ovlp_list[0]({0,nexcit[0]},{0,nb}));
      ma::elementwise(ma::TOp_MUL, 1, ov0[1].sliced(0,nb), ovlp_list[1]({0,nexcit[1]},{0,nb}));

      StaticMatrix wgt({nexcit[0], nb}, ComplexType(0.0),
                   buffer_manager.get_generator().template get_allocator<ComplexType>());
      // W[u][iw] = sum_d OpSpinDetCouplings[u][d] Ov[d][iw]   
      ma::product(OpSpinDetCouplings[0], ovlp_list[1]({0, nexcit[1]},{0,nb}), wgt);
      // W[u][iw] *= Ovlps[0][u][iw]   
      ma::elementwise(ma::TOp_MUL, ovlp_list[0]({0,nexcit[0]},{0,nb}), wgt);
      // Ov[iw] = sum_u W[u][iw]  
      ma::accumulate(0, wgt, Ov.sliced(iw,iw+nb));
    }
  }
  if(TG.TG_local().size() > 1)
    TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(Ov.origin()), nw, std::plus<>());
}

template<bool MP>
template<class WlkSet, class TVec, class Mat1, class Mat2, class Mat3, class Observable>
void PHMSD<MP>::accumulate_estimators(int iav, WlkSet& wset, TVec& wgt,
        std::vector<Observable>& properties_1body, std::vector<Observable>& properties,
        Mat1 const& X, Mat2 const& Yc, Mat3 const& M, bool time_evolved, bool importanceSampling)
{
  if(TG.TG_local().size() > 1)
    APP_ABORT(" Error: energy algorithm 1 not yet implemented with ncore>1.\n\n");
  using ma::conj;
  using std::get;
  using std::fill_n;
  using std::copy_n;
  int nspins  = (walker_type==COLLINEAR?2:1);
  int npol((walker_type == NONCOLLINEAR) ? 2 : 1);
  int nwalk = wset.size();
  double LogOverlapFactor(wset.getLogOverlapFactor());

  // what to do!
  bool calculate_G = (properties_1body.size()>0);
  bool loop_over_unique = (properties.size()>0);
  bool loop_over_confgs = false; //(properties_full.size()>0);

  // if only 1body properties, call MixedDensityMatrix 
  if(calculate_G and not loop_over_unique and not loop_over_confgs) {

    StaticSHM4Tensor Gfull({nwalk, nspins, npol*NMO, npol*NMO},
          shm_buffer_manager.get_generator().template get_allocator<ComplexType>());
    // Gfull = M + ma::T(X) * ma::T(OrbMats[spin]) * Gc * conj(Y),
    //   where Yc = conj(Y), Yc already comes with the conjugate!

    int w0, wN;
    std::tie(w0, wN) = FairDivideBoundary(TG.TG_local().rank(), nwalk, TG.TG_local().size());
    TG.TG_local().barrier();

    // 0. Gfull = M
    // assumes M is contiguous
    if(time_evolved)
      ma::copy(M.sliced(w0,wN).flatted().flatted().flatted(),
             Gfull.sliced(w0,wN).flatted().flatted().flatted() );
    TG.TG_local().barrier();

    int nact[2] = {int(OrbMats[0].size(0)), int(OrbMats[1].size(0))};
    StaticSHM3Tensor Gc({nwalk, nact[0]+nact[1], npol*NMO}, 
          shm_buffer_manager.get_generator().template get_allocator<ComplexType>());

    // 1. Calculate compact, mixed density matrix
    MixedDensityMatrix(wset, Gc.rotated().flatted().unrotated(), true,  true);

    for(int ispin=0; ispin<nspins; ispin++) {

      auto Gis=Gc.sliced(w0,wN).rotated().sliced(ispin*nact[0], nact[0]+ispin*nact[1]).unrotated();

      if(time_evolved) {
        StaticSHM3Tensor GYc(Gis.extensions(), 
            shm_buffer_manager.get_generator().template get_allocator<ComplexType>());

        // GYc = Gc * Yc
        ma::productStridedBatched(Gis, Yc.sliced(w0,wN).rotated()[ispin].unrotated(), GYc);

        // reuse Gis: Gis = S * X 
        ma::productStridedBatched(OrbMats[ispin], X.sliced(w0,wN).rotated()[ispin].unrotated(),
                                Gis);

        // Gfull += T(Gis) * GYc
        ma::productStridedBatched(ComplexType(1.0), ma::T(Gis), GYc,
                              ComplexType(1.0), Gfull.sliced(w0,wN).rotated()[ispin].unrotated() );

      } else {

        // Gfull = T(OrbMats) * Gc
        ma::productStridedBatched(ma::T(OrbMats[ispin]), Gis,
                                Gfull.sliced(w0,wN).rotated()[ispin].unrotated() );

      }

    }
    TG.TG_local().barrier();

    // 3. copy to host 
    // trying allocating on the fly, change if too slow!
    long i0, iN;
    std::tie(i0, iN) = FairDivideBoundary(long(TG.TG_local().rank()),
                    long(Gfull.num_elements()), long(TG.TG_local().size()));
    Array<ComplexType, 4, shared_allocator<ComplexType>> G4D_host(Gfull.extensions(),
                                        shared_allocator<ComplexType>{TG.TG_local()});
    copy_n(make_device_ptr(Gfull.origin()) + i0, iN - i0, raw_pointer_cast(G4D_host.origin()) + i0);
    TG.TG_local().barrier();

    // 4. accumulate 
    if(time_evolved) {
      for (auto& v : properties_1body)
        v.accumulate(iav, Gfull, G4D_host, wgt, importanceSampling);
    }
    else {
      for (auto& v : properties_1body)
        v.accumulate(iav, 
                    OrbMats[0],
                    Gc.sliced(w0,wN).rotated().sliced(0, nact[0]).unrotated(),
                    OrbMats[1],
                    Gc.sliced(w0,wN).rotated().sliced(nact[0], nact[0]+nact[1]).unrotated(),    
                    Gfull, G4D_host, wgt, importanceSampling);
    }
    
    return;
  }
  APP_ABORT("Error: PHMSD::accumulate_estimator only working for onerdm, finish! ");

  long nexcit[2] = {long(abij.number_of_unique_excitations()[0]),
                    long(abij.number_of_unique_excitations()[1])};
  std::vector<int> confg(nup);
  IVector confg_dev(iextensions<1u>{nup});

  if (walker_type != COLLINEAR)
  {
    APP_ABORT("Error: Finish implementation of PHMSD for CLOSED/NONCOLLINEAR walkers.");
  }
  else
  {

    // generalize later
    int nbatch__ = nwalk;

    Array<ComplexType, 1> Xw(iextensions<1u>{nwalk});
    Array<ComplexType, 1> scl_wgt(wgt);
    StaticVector Ov(iextensions<1u>{nwalk}, ComplexType(0.0),
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
    StaticSHM3Tensor ph_wgt({2, maxn_unique_confg, nwalk}, ComplexType(0.0),
                       shm_buffer_manager.get_generator().template get_allocator<ComplexType>());
    StaticSHM3Tensor Ovlps({2, maxn_unique_confg, nwalk}, ComplexType(0.0),
                       shm_buffer_manager.get_generator().template get_allocator<ComplexType>());

    auto SMup=wset.SlaterMatrices(Alpha);
    auto SMdn=wset.SlaterMatrices(Beta);

    // 1. calculate Overlaps
    for (int iw = 0; iw < nwalk; iw+=nbatch__)
    {
      int nb = std::min(nbatch__, nwalk - iw);
      StaticVector overlaps(iextensions<1u>{nb}, ComplexType(0.0),
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
      for(int ispin=0; ispin<nspins; ispin++) { 

        Static3Tensor QQ0inv({nb, OrbMats[ispin].size(0), (ispin==0?nup:ndown)}, 
                     buffer_manager.get_generator().template get_allocator<ComplexType>());

        if(ispin==0)
          SDetOp.BatchedOverlapForWoodbury(OrbMats[ispin], SMup.sliced(iw,iw+nb), LogOverlapFactor,
                overlaps, refc_dev.origin() + ispin*nup, QQ0inv);
        else
          SDetOp.BatchedOverlapForWoodbury(OrbMats[ispin], SMdn.sliced(iw,iw+nb), LogOverlapFactor,
                overlaps, refc_dev.origin() + ispin*nup, QQ0inv);
#if defined(ENABLE_CUDA)
        calculate_overlaps(0, 1, ispin, abij, QQ0inv, Ovlps[ispin]({0,nexcit[ispin]},{iw,iw+nb}));
#else
        for(int i=0; i<nb; ++i)
          calculate_overlaps(0, 1, ispin, abij, QQ0inv[i], Ovlps[ispin]({0,nexcit[ispin]}, iw+i));
#endif
        // multiply Ovlps by overlaps
        // Ovlps[s][u][iw] *= overlaps[iw]   
        ma::elementwise(ma::TOp_MUL, 1, overlaps, Ovlps[ispin]({0,nexcit[ispin]}, {iw, iw+nb}));
      } // ispin
    }  // iw

    // 2. calculate full overlap, ph_wgts and normalize walker weights
    // W[u][iw] = sum_d OpSpinDetCouplings[u][d] Ov[d][iw]   
    ma::product(OpSpinDetCouplings[0], Ovlps[1].sliced(0, nexcit[1]), ph_wgt[0].sliced(0, nexcit[0]));
    ma::product(OpSpinDetCouplings[1], Ovlps[0].sliced(0, nexcit[0]), ph_wgt[1].sliced(0, nexcit[1]));
    // W[u][iw] *= Ovlps[0][u][iw]   
    ma::elementwise(ma::TOp_MUL, Ovlps[0].sliced(0,nexcit[0]), ph_wgt[0].sliced(0, nexcit[0]));
    ma::elementwise(ma::TOp_MUL, Ovlps[1].sliced(0,nexcit[1]), ph_wgt[1].sliced(0, nexcit[1]));
    // Ov[iw] = sum_u W[u][iw]  
    ma::accumulate(0, ph_wgt[0].sliced(0, nexcit[0]), Ov);

    // scl_wgt[iw] = wgt[iw] / Ov[iw]
    copy_n(Ov.origin(), nwalk, Xw.origin());
    for(int i=0; i<nwalk; i++)
        scl_wgt[i] /= Xw[i];

    // 4. loop over excitations, calculate Rpa and call properties
    for (int iw = 0; iw < nwalk; iw+=nbatch__)
    { 
      int nb = std::min(nbatch__, nwalk - iw);
      StaticVector overlaps(iextensions<1u>{nb}, ComplexType(0.0),
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
      for(int ispin=0; ispin<nspins; ispin++) {
        
        auto& SM = ( (ispin==0) ? SMup : SMdn );
        Static3Tensor GA({nb, SM.size(2), npol*NMO},
                       buffer_manager.get_generator().template get_allocator<ComplexType>());
        Static3Tensor QQ0inv({nb, OrbMats[ispin].size(0), SM.size(2)}, 
                     buffer_manager.get_generator().template get_allocator<ComplexType>());
        
        SDetOp.BatchedMixedDensityMatrixForWoodbury(OrbMats[ispin], SM.sliced(iw,iw+nb), GA,
            LogOverlapFactor, overlaps, refc_dev.origin() + ispin*nup, QQ0inv, true);

/*
         //
         if( ispin==0 ) {
           ph_excited_properties_first_step(nup, OrbMats[0].size(0), abij, ph_wgt[0],
                    QQ0inv, properties);       
         } else {
           ph_excited_properties_second_step(ndown, OrbMats[1].size(0), abij, ph_wgt[1],
                    QQ0inv, properties);       
         }
*/

      } // ispin

      // properties.ph_complete?

    }  // iw

  }
}

/*
 * Calculate mean field Green function 
 */
template<bool MP>
template<class Mat>
void PHMSD<MP>::G_MF(Mat&& Gmf)
{
  using ma::conj;
  using ma::T;
  using std::get;
  using std::fill_n;
  using std::norm;

  // temporary runtime check for incompatible memory spaces
  {
    auto dev_ptr_ = make_device_ptr(Gmf.origin());
    (void)dev_ptr_; // to suppress unused variable warning
  }

  int nspins  = (walker_type==COLLINEAR?2:1);
  int npol    = (walker_type==NONCOLLINEAR?2:1);
  RUNTIME_CHECK(Gmf.size(0) == nspins*npol*NMO, "");
  RUNTIME_CHECK(Gmf.size(1) == npol*NMO, "");
  ma::fill(Gmf, ComplexType(0));

  Matrix<ComplexType> ovlps({nspins, maxn_unique_confg}, ComplexType(0.0));

  std::vector<int> exct(2 * nup);
  std::vector<int> Iwork(2 * nup);
  std::vector<int> confg(nup);
  std::vector<int> confgB(nup);
  TG.Node().barrier();

  // 1. Overlaps
  for (int spin = 0, nc = 0; spin < nspins; ++spin)
  {
    confg.resize((spin == 0) ? nup : ndown);
    auto Gdims_ref = dm_dims_ref(false, SpinTypes(spin));
    StaticMatrix SM_({Gdims_ref.second, Gdims_ref.first}, ComplexType(0.0),
                      buffer_manager.get_generator().template get_allocator<ComplexType>());
    for (int nd = 0; nd < int(abij.number_of_unique_excitations()[spin]); ++nd, ++nc)
    {
      if (nc % TG.Global().size() == TG.Global().rank())
      {
        abij.get_configuration(spin, nd, confg);
        ma::Matrix2MA('H', OrbMats[spin], SM_, confg);
        ovlps[spin][nd] = SDetOp.Overlap(SM_, 0.0);
      }
    }
  }
  TG.Node().barrier();
  TG.Global().all_reduce_in_place_n(raw_pointer_cast(ovlps.origin()), ovlps.num_elements(), std::plus<>());
  TG.Node().barrier();

  ComplexType ov(0.0);
  if(walker_type == COLLINEAR) 
    for (auto it = abij.configurations_begin(); it < abij.configurations_end(); ++it)
      ov += norm(std::get<2>(*it)) * ovlps[0][std::get<0>(*it)] * ovlps[1][std::get<1>(*it)];
  else
    for (auto it = abij.configurations_begin(); it < abij.configurations_end(); ++it)
      ov += norm(std::get<2>(*it)) * ovlps[0][std::get<0>(*it)]; 

  int nr = OrbMats[0].size(0);
  if(walker_type==COLLINEAR) nr += OrbMats[1].size(0);
  StaticMatrix Gfull({nr, npol*NMO}, 
                      buffer_manager.get_generator().template get_allocator<ComplexType>());

  // 2. Diagonal and off-diagonal components
  for (int spin = 0, is0=0; spin < nspins; ++spin)
  {
    int other_spin    = 1 - spin;
    confg.resize((spin == 0) ? nup : ndown);
    auto Gdims     = dm_dims(false, SpinTypes(spin));
    auto Gdims_ref = dm_dims_ref(false, SpinTypes(spin));
    StaticMatrix G2D_({Gdims_ref.first, Gdims_ref.second}, 
                      buffer_manager.get_generator().template get_allocator<ComplexType>());
    StaticMatrix SM_({Gdims_ref.second, Gdims_ref.first}, ComplexType(0.0), 
                      buffer_manager.get_generator().template get_allocator<ComplexType>());
    auto G = Gfull.sliced( is0, is0+Gdims.first) ;
    is0+=Gdims.first;

    // diagonal contribution
    for (int nd = 0; nd < int(abij.number_of_unique_excitations()[spin]); ++nd)
    {
      if (nd % TG.Global().size() == TG.Global().rank())
      {
        abij.get_configuration(spin, nd, confg);
        ma::Matrix2MA('H', OrbMats[spin], SM_, confg);
        [[maybe_unused]] ComplexType ov_ = SDetOp.MixedDensityMatrix(SM_, G2D_, 0.0, true);
        ComplexType wgt(0.0);
        if( walker_type == COLLINEAR ) 
	{
          auto D = OpSpinDetCouplings[spin][nd];     
          size_t nnz = D.num_non_zero_elements();
#if defined(ENABLE_DEVICE)
          auto val_d = D.non_zero_values_data();
          auto jdet_d = D.non_zero_indices2_data();
	  Vector<ComplexType> val(nnz);
	  Vector<int> jdet(nnz);
          copy_n(val_d,nnz,val.origin());
          copy_n(jdet_d,nnz,jdet.origin());
#else
	  auto val = D.non_zero_values_data(); 
	  auto jdet = D.non_zero_indices2_data();
#endif
          for (size_t n=0; n<nnz; ++n)
            wgt += ovlps[other_spin][jdet[n]] * norm(val[n]);
          wgt *= ovlps[spin][nd];
	} else {
	  wgt = ovlps[spin][nd] * ComplexType(*(OpSpinDetCouplings[1].non_zero_values_data(0) + nd));
        }
        for (int k = 0; k < confg.size(); ++k)
          ma::axpy(wgt, G2D_[k], G[confg[k]]);
      }
    }
    // off-diagonal contribution
    StaticMatrix orbs({2, Gdims.second}, ComplexType(0.0),
                      buffer_manager.get_generator().template get_allocator<ComplexType>());
    ComplexType dummy(0.0);
    confgB.resize((spin == 0) ? nup : ndown);
    if(walker_type == COLLINEAR) 
    {
      for (int nd = 0; nd < int(abij.number_of_unique_excitations()[other_spin]); ++nd)
      {
        if (nd % TG.Global().size() == TG.Global().rank())
        {
          auto D = OpSpinDetCouplings[other_spin][nd];     
          size_t nnz = D.num_non_zero_elements();
#if defined(ENABLE_DEVICE)
          auto val_d = D.non_zero_values_data();
          auto jdet_d = D.non_zero_indices2_data();
          Vector<ComplexType> val(nnz);
          Vector<int> jdet(nnz);
          copy_n(val_d,nnz,val.origin());
          copy_n(jdet_d,nnz,jdet.origin());
#else   
          auto val = D.non_zero_values_data(); 
          auto jdet = D.non_zero_indices2_data();
#endif 
          for (size_t n1=0; n1<nnz; ++n1)  
          {
            size_t cf1 = size_t(jdet[n1]); 
            abij.get_configuration(spin, cf1, confg);
            sort(confg.begin(), confg.end());
            for (size_t n2=n1+1; n2<nnz; ++n2)
            {
              size_t cf2 = size_t(jdet[n2]); 
              abij.get_configuration(spin, cf2, confgB);
              sort(confgB.begin(), confgB.end());
              exct.clear();
              int np = get_excitation_number(true, confg, confgB, exct, dummy, Iwork);
              if (np == 1)
              {
                ComplexType wgt = val[n1] * ma::conj(val[n2]); 
                /*
                 * exct: [0]: location of orbital being excited, [1]: excited orbital 
                 * confg[exct[0]]: occupied orbital being excited
                 * WARNING!!! Assumes orthogonal states, needs overlap factor!!!
                 * Either calculate it (expensive) or demand orthogonality!!!   
                 */
                exct[0] = confg[exct[0]];
                ma::Matrix2MA('Z', OrbMats[spin], orbs, exct);
                ma::axpy(wgt, orbs[0], G[exct[1]]);
                ma::axpy(ma::conj(wgt), orbs[1], G[exct[0]]);
              }
            }
          }
        }
      }
    } else {
      auto D = OpSpinDetCouplings[1][0];     
      size_t nunique = D.num_non_zero_elements();
#if defined(ENABLE_DEVICE)
      auto val_d = D.non_zero_values_data();
      Vector<ComplexType> val(nunique);
      copy_n(val_d,nunique,val.origin());
#else     
      auto val = D.non_zero_values_data(); 
#endif 
      for (size_t n1=0, n12=0; n1<nunique; ++n1)
      {
        abij.get_configuration(spin, n1, confg);
        sort(confg.begin(), confg.end());
        for (size_t n2=n1+1; n2<nunique; ++n2, ++n12)
        {
          if (n12 % TG.Global().size() != TG.Global().rank())
            continue;
          abij.get_configuration(spin, n2, confgB);
          sort(confgB.begin(), confgB.end());
          exct.clear();
          int np = get_excitation_number(true, confg, confgB, exct, dummy, Iwork);
          if (np == 1)
          {
            ComplexType wgt = val[n1] * ma::conj(val[n2]);
            /*
             * exct: [0]: location of orbital being excited, [1]: excited orbital 
             * confg[exct[0]]: occupied orbital being excited
             * WARNING!!! Assumes orthogonal states, needs overlap factor!!!
             * Either calculate it (expensive) or demand orthogonality!!!   
             */
            exct[0] = confg[exct[0]];
            ma::Matrix2MA('Z', OrbMats[spin], orbs, exct);
            ma::axpy(wgt, orbs[0], G[exct[1]]);
            ma::axpy(ma::conj(wgt), orbs[1], G[exct[0]]);
          } // np==1
        } // n2
      } // n1
    } // walker_type == COLLINEAR
  }
  // avoid cuda-aware 
#if defined(ENABLE_DEVICE)
  Matrix<ComplexType> Gt(Gfull.extensions());
  copy_n(Gfull.origin(),Gfull.num_elements(),Gt.origin()); 
  TG.Global().all_reduce_in_place_n(raw_pointer_cast(Gt.origin()), Gt.num_elements(), std::plus<>());
  copy_n(Gt.origin(),Gt.num_elements(),Gfull.origin());
#else
  TG.Global().all_reduce_in_place_n(raw_pointer_cast(Gfull.origin()), Gfull.num_elements(), std::plus<>());
#endif
  ma::scal(ComplexType(1.0 / ov), Gfull);
  ma::product(ma::T(OrbMats[0]),Gfull.sliced(0,OrbMats[0].size(0)),Gmf.sliced(0,npol*NMO));
  if(walker_type==COLLINEAR)
    ma::product(ma::T(OrbMats[1]),Gfull.sliced(OrbMats[0].size(0),Gfull.size(0)),
		Gmf.sliced(NMO,2*NMO));
  TG.Node().barrier();
}

/*
   * Calculate mean field expectation value of Cholesky potentials
   * Can put G in shared memory with proper synchronization to avoid duplicated memory
   * at the expense of synchronization overhead 
   */
template<bool MP>
template<class Vec>
void PHMSD<MP>::vMF(Vec&& v, double dt)
{
  using ma::conj;
  using ma::T;
  using std::get;
  using std::fill_n;
  using std::norm;
  RUNTIME_CHECK(v.num_elements() == local_number_of_cholesky_vectors(), "");
  fill_n(v.origin(), v.num_elements(), ComplexType(0));

  int nspins  = (walker_type==COLLINEAR?2:1);
  int npol    = (walker_type==NONCOLLINEAR?2:1);

  Matrix<ComplexType> ovlps({nspins, maxn_unique_confg}, ComplexType(0.0));

  std::vector<int> exct(2 * nup);
  std::vector<int> Iwork(2 * nup);
  std::vector<int> confg(nup);
  std::vector<int> confgB(nup);
  TG.Node().barrier();

  // 1. Overlaps
  for (int spin = 0, nc = 0; spin < nspins; ++spin)
  {
    confg.resize((spin == 0) ? nup : ndown);
    auto Gdims_ref = dm_dims_ref(false, SpinTypes(spin));
    StaticMatrix SM_({Gdims_ref.second, Gdims_ref.first}, ComplexType(0.0),
                      buffer_manager.get_generator().template get_allocator<ComplexType>());
    for (int nd = 0; nd < int(abij.number_of_unique_excitations()[spin]); ++nd, ++nc)
    {
      if (nc % TG.Global().size() == TG.Global().rank())
      {
        abij.get_configuration(spin, nd, confg);
        ma::Matrix2MA('H', OrbMats[spin], SM_, confg);
        ovlps[spin][nd] = SDetOp.Overlap(SM_, 0.0);
      }
    }
  }
  TG.Node().barrier();
  TG.Global().all_reduce_in_place_n(raw_pointer_cast(ovlps.origin()), ovlps.num_elements(), std::plus<>());
  TG.Node().barrier();

  ComplexType ov(0.0);
  if(walker_type == COLLINEAR) 
    for (auto it = abij.configurations_begin(); it < abij.configurations_end(); ++it)
      ov += norm(std::get<2>(*it)) * ovlps[0][std::get<0>(*it)] * ovlps[1][std::get<1>(*it)];
  else
    for (auto it = abij.configurations_begin(); it < abij.configurations_end(); ++it)
      ov += norm(std::get<2>(*it)) * ovlps[0][std::get<0>(*it)]; 

  int nr = OrbMats[0].size(0);
  if(walker_type==COLLINEAR) nr += OrbMats[1].size(0);
  StaticMatrix Gfull({nr, npol*NMO}, ComplexType(0.0), 
                      buffer_manager.get_generator().template get_allocator<ComplexType>());

  // 2. Diagonal and off-diagonal components
  for (int spin = 0, is0=0; spin < nspins; ++spin)
  {
    int other_spin    = 1 - spin;
    confg.resize((spin == 0) ? nup : ndown);
    auto Gdims     = dm_dims(false, SpinTypes(spin));
    auto Gdims_ref = dm_dims_ref(false, SpinTypes(spin));
    StaticMatrix G2D_({Gdims_ref.first, Gdims_ref.second}, 
                      buffer_manager.get_generator().template get_allocator<ComplexType>());
    StaticMatrix SM_({Gdims_ref.second, Gdims_ref.first}, ComplexType(0.0), 
                      buffer_manager.get_generator().template get_allocator<ComplexType>());
    auto G = Gfull.sliced( is0, is0+Gdims.first) ;
    is0+=Gdims.first;

    // diagonal contribution
    for (int nd = 0; nd < int(abij.number_of_unique_excitations()[spin]); ++nd)
    {
      if (nd % TG.Global().size() == TG.Global().rank())
      {
        abij.get_configuration(spin, nd, confg);
        ma::Matrix2MA('H', OrbMats[spin], SM_, confg);
        [[maybe_unused]] ComplexType ov_ = SDetOp.MixedDensityMatrix(SM_, G2D_, 0.0, true);
        ComplexType wgt(0.0);
        if( walker_type == COLLINEAR ) 
	{
          auto D = OpSpinDetCouplings[spin][nd];     
          size_t nnz = D.num_non_zero_elements();
#if defined(ENABLE_DEVICE)
          auto val_d = D.non_zero_values_data();
          auto jdet_d = D.non_zero_indices2_data();
	  Vector<ComplexType> val(nnz);
	  Vector<int> jdet(nnz);
          copy_n(val_d,nnz,val.origin());
          copy_n(jdet_d,nnz,jdet.origin());
#else
	  auto val = D.non_zero_values_data(); 
	  auto jdet = D.non_zero_indices2_data();
#endif
          for (size_t n=0; n<nnz; ++n)
            wgt += ovlps[other_spin][jdet[n]] * norm(val[n]);
          wgt *= ovlps[spin][nd];
	} else {
	  wgt = ovlps[spin][nd] * ComplexType(*(OpSpinDetCouplings[1].non_zero_values_data(0) + nd));
        }
        for (int k = 0; k < confg.size(); ++k)
          ma::axpy(wgt, G2D_[k], G[confg[k]]);
      }
    }
    // off-diagonal contribution
    StaticMatrix orbs({2, Gdims.second}, ComplexType(0.0),
                      buffer_manager.get_generator().template get_allocator<ComplexType>());
    ComplexType dummy(0.0);
    confgB.resize((spin == 0) ? nup : ndown);
    if(walker_type == COLLINEAR) 
    {
      for (int nd = 0; nd < int(abij.number_of_unique_excitations()[other_spin]); ++nd)
      {
        if (nd % TG.Global().size() == TG.Global().rank())
        {
          auto D = OpSpinDetCouplings[other_spin][nd];     
          size_t nnz = D.num_non_zero_elements();
#if defined(ENABLE_DEVICE)
          auto val_d = D.non_zero_values_data();
          auto jdet_d = D.non_zero_indices2_data();
          Vector<ComplexType> val(nnz);
          Vector<int> jdet(nnz);
          copy_n(val_d,nnz,val.origin());
          copy_n(jdet_d,nnz,jdet.origin());
#else   
          auto val = D.non_zero_values_data(); 
          auto jdet = D.non_zero_indices2_data();
#endif 
          for (size_t n1=0; n1<nnz; ++n1)  
          {
            size_t cf1 = size_t(jdet[n1]); 
            abij.get_configuration(spin, cf1, confg);
            sort(confg.begin(), confg.end());
            for (size_t n2=n1+1; n2<nnz; ++n2)
            {
              size_t cf2 = size_t(jdet[n2]); 
              abij.get_configuration(spin, cf2, confgB);
              sort(confgB.begin(), confgB.end());
              exct.clear();
              int np = get_excitation_number(true, confg, confgB, exct, dummy, Iwork);
              if (np == 1)
              {
                ComplexType wgt = val[n1] * ma::conj(val[n2]); 
                /*
                 * exct: [0]: location of orbital being excited, [1]: excited orbital 
                 * confg[exct[0]]: occupied orbital being excited
                 * WARNING!!! Assumes orthogonal states, needs overlap factor!!!
                 * Either calculate it (expensive) or demand orthogonality!!!   
                 */
                exct[0] = confg[exct[0]];
                ma::Matrix2MA('Z', OrbMats[spin], orbs, exct);
                ma::axpy(wgt, orbs[0], G[exct[1]]);
                ma::axpy(ma::conj(wgt), orbs[1], G[exct[0]]);
              }
            }
          }
        }
      }
    } else {
      auto D = OpSpinDetCouplings[1][0];     
      size_t nunique = D.num_non_zero_elements();
#if defined(ENABLE_DEVICE)
      auto val_d = D.non_zero_values_data();
      Vector<ComplexType> val(nunique);
      copy_n(val_d,nunique,val.origin());
#else     
      auto val = D.non_zero_values_data(); 
#endif 
      for (size_t n1=0, n12=0; n1<nunique; ++n1)
      {
        abij.get_configuration(spin, n1, confg);
        sort(confg.begin(), confg.end());
        for (size_t n2=n1+1; n2<nunique; ++n2, ++n12)
        {
          if (n12 % TG.Global().size() != TG.Global().rank())
            continue;
          abij.get_configuration(spin, n2, confgB);
          sort(confgB.begin(), confgB.end());
          exct.clear();
          int np = get_excitation_number(true, confg, confgB, exct, dummy, Iwork);
          if (np == 1)
          {
            ComplexType wgt = val[n1] * ma::conj(val[n2]);
            /*
             * exct: [0]: location of orbital being excited, [1]: excited orbital 
             * confg[exct[0]]: occupied orbital being excited
             * WARNING!!! Assumes orthogonal states, needs overlap factor!!!
             * Either calculate it (expensive) or demand orthogonality!!!   
             */
            exct[0] = confg[exct[0]];
            ma::Matrix2MA('Z', OrbMats[spin], orbs, exct);
            ma::axpy(wgt, orbs[0], G[exct[1]]);
            ma::axpy(ma::conj(wgt), orbs[1], G[exct[0]]);
          } // np==1
        } // n2
      } // n1
    } // walker_type == COLLINEAR
  }
  // avoid cuda-aware 
#if defined(ENABLE_DEVICE)
  Matrix<ComplexType> Gt(Gfull.extensions());
  copy_n(Gfull.origin(),Gfull.num_elements(),Gt.origin()); 
  TG.Global().all_reduce_in_place_n(raw_pointer_cast(Gt.origin()), Gt.num_elements(), std::plus<>());
  copy_n(Gt.origin(),Gt.num_elements(),Gfull.origin());
#else
  TG.Global().all_reduce_in_place_n(raw_pointer_cast(Gfull.origin()), Gfull.num_elements(), std::plus<>());
#endif
  ma::scal(ComplexType(1.0 / ov), Gfull);
  HamOp.vbias(Gfull.flatted(), std::forward<Vec>(v), dt);
  TG.Node().barrier();

  // since v is not in shared memory, we need to reduce
  if(TG.TG_local().size() > 1)
    TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(v.origin()), v.num_elements(), std::plus<>());
}


} // namespace afqmc
} // namespace sfqmc
