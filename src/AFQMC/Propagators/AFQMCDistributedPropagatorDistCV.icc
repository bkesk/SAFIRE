#include <vector>
#include <map>
#include <string>
#include <iostream>
#include <tuple>

#include "AFQMC/config.h"
#include "AFQMC/Utilities/AFQMCTimer.h"
#include "AFQMC/Utilities/Utils.hpp"
#include "AFQMC/Propagators/WalkerSetUpdate.hpp"
#include "AFQMC/Walkers/WalkerConfig.hpp"
#include "Numerics/ma_blas.hpp"

namespace sfqmc
{
namespace afqmc
{
/*
 * Propagates the walker population nsteps forward with a fixed vbias (from the initial 
 * configuration).   
 */
template<bool SP>
template<class WlkSet>
void AFQMCDistributedPropagatorDistCV<SP>::step(int nsteps_, WlkSet& wset, RealType Eshift, RealType dt)
{
  using std::copy_n;
  AFQMCTimer.start(setup_timer);
  const SPComplexType one(1.), zero(0.);
  auto walker_type        = wset.getWalkerType();
  int nsteps              = nsteps_;
  int nwalk               = wset.size();
  RealType sqrtdt         = std::sqrt(dt);
  long Gsize              = wfn.size_of_G_for_vbias();
  const int globalnCV     = wfn.global_number_of_cholesky_vectors();
  const int localnCV      = wfn.local_number_of_cholesky_vectors();
  const int global_origin = wfn.global_origin_cholesky_vector();
  const int nnodes        = TG.getNGroupsPerTG();
  const int node_number   = TG.getLocalGroupNumber();
  // if transposed_XXX_=true  --> XXX[nwalk][...],
  // if transposed_XXX_=false --> XXX[...][nwalk]
  auto vhs_ext   = iextensions<2u>{nspins_in_vHS * NMO * NMO, nwalk * nsteps};
  auto vhs4d_ext = iextensions<4u>{nspins_in_vHS, NMO, NMO, nwalk * nsteps};
  auto G_ext     = iextensions<2u>{Gsize, nwalk};
  if (transposed_vHS_)
  {
    vhs_ext   = iextensions<2u>{nspins_in_vHS * nwalk * nsteps, NMO * NMO};
    vhs4d_ext = iextensions<4u>{nspins_in_vHS, nwalk * nsteps, NMO, NMO};
  }
  if (transposed_G_)
    G_ext = iextensions<2u>{nwalk, Gsize};

  if (MFfactor.size(0) != nsteps || MFfactor.size(1) != nwalk)
    MFfactor = CMatrix({long(nsteps), long(nwalk)});
  if (hybrid_weight.size(0) != nsteps || hybrid_weight.size(1) != nwalk)
    hybrid_weight = CMatrix({long(nsteps), long(nwalk)});
  if (new_overlaps.size(0) != nwalk)
    new_overlaps = CVector(iextensions<1u>{nwalk});
  if (new_energies.size(0) != nwalk || new_energies.size(1) != 3)
    new_energies = CMatrix({long(nwalk), 3});

  //  Temporary memory usage summary:
  //  G_for_vbias:     [ Gsize * nwalk ] (2 copies)
  //  vbias:           [ localnCV * nwalk ]
  //  X:               [ localnCV * nwalk * nstep ]
  //  vHS:             [ NMO*NMO * nwalk * nstep ] (3 copies)
  // memory_needs: nwalk * ( 2*nsteps + Gsize + localnCV*(nstep+1) + NMO*NMO*nstep )

  // if timestep changed, recalculate one body propagator
  if (std::abs(dt - old_dt) > 1e-6)
    generateP1(dt, walker_type);
  TG.TG_local().barrier();

  StaticMatrix vrecv_buff(vhs_ext, ComplexType(0.0),
			buffer_manager.get_generator().template get_allocator<ComplexType>());
  SPCMatrix_ref vrecv(reinterpret_pointer_cast<SPComplexType>(make_device_ptr(vrecv_buff.origin())), vhs_ext);

  { // using scope to control lifetime of StaticArrays, avoiding unnecesary buffer space

    Static3Tensor globalMFfactor({nnodes, nsteps, nwalk}, ComplexType(0.0),
                         buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor globalhybrid_weight({nnodes, nsteps, nwalk}, ComplexType(0.0),
                         buffer_manager.get_generator().template get_allocator<ComplexType>());
    StaticSPMatrix Gwork(G_ext, SPComplexType(0.0),
			 buffer_manager.get_generator().template get_allocator<SPComplexType>());

    // 1. Calculate Green function for all (local) walkers
    AFQMCTimer.start(G_for_vbias_timer);
    if constexpr (SP) {
      // control scope of Gc
      int Gak0, GakN;
      std::tie(Gak0, GakN) = FairDivideBoundary(TG.getLocalTGRank(), int(Gwork.num_elements()), TG.getNCoresPerTG());
      StaticMatrix Gc(G_ext, ComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<ComplexType>());
      wfn.MixedDensityMatrix_for_vbias(wset, Gc);
      copy_n_cast(make_device_ptr(Gc.origin()) + Gak0, GakN - Gak0, make_device_ptr(Gwork.origin()) + Gak0);
      TG.TG_local().barrier();
    } else {
      wfn.MixedDensityMatrix_for_vbias(wset, Gwork);
    }
    AFQMCTimer.stop(G_for_vbias_timer);


    StaticSPMatrix Grecv(G_ext, SPComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<SPComplexType>());
    StaticSPMatrix vbias({long(localnCV), long(nwalk)},SPComplexType(0.0),
                         buffer_manager.get_generator().template get_allocator<SPComplexType>());
    StaticSPMatrix X({long(localnCV), long(nwalk * nsteps)}, SPComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<SPComplexType>());
    StaticSPMatrix vsend(vhs_ext, SPComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<SPComplexType>());
    StaticSPMatrix vHS(vhs_ext, SPComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<SPComplexType>());

    // partition G and v for communications: all cores communicate a piece of the matrix
    int vak0, vakN;
    int Gak0, GakN;
    std::tie(Gak0, GakN) = FairDivideBoundary(TG.getLocalTGRank(), int(Gwork.num_elements()), TG.getNCoresPerTG());
    std::tie(vak0, vakN) = FairDivideBoundary(TG.getLocalTGRank(), int(vHS.num_elements()), TG.getNCoresPerTG());
    MPI_Send_init(raw_pointer_cast(Gwork.origin()) + Gak0, (GakN - Gak0) * sizeof(SPComplexType), MPI_CHAR, TG.prev_core(),
                  3456, TG.TG().get(), &req_Gsend);
    MPI_Recv_init(raw_pointer_cast(Grecv.origin()) + Gak0, (GakN - Gak0) * sizeof(SPComplexType), MPI_CHAR, TG.next_core(),
                  3456, TG.TG().get(), &req_Grecv);
    MPI_Send_init(raw_pointer_cast(vsend.origin()) + vak0, (vakN - vak0) * sizeof(SPComplexType), MPI_CHAR, TG.prev_core(),
                  5678, TG.TG().get(), &req_vsend);
    MPI_Recv_init(raw_pointer_cast(vrecv.origin()) + vak0, (vakN - vak0) * sizeof(SPComplexType), MPI_CHAR, TG.next_core(),
                  5678, TG.TG().get(), &req_vrecv);

    ma::fill(vsend.flatted().sliced(vak0, vakN), zero);

    // are we back propagating?
    int bp_step = wset.getBPPos(), bp_max = wset.NumBackProp();
    int xx(0);
    if (bp_step >= 0 && bp_step < bp_max)
    {
APP_ABORT("Error: back propagation needs update after changes to vHS/vbias ");
      xx = 1;
      size_t m_(globalnCV * nwalk * nsteps * 2);
      if (bpX.num_elements() < m_)
      {
        bpX     = mpi3SPCVector(iextensions<1u>{m_}, shared_allocator<SPComplexType>{TG.TG_local()});
        if (TG.TG_local().root())
          std::fill_n(bpX.origin(), bpX.num_elements(), SPComplexType(0.0));
      }
    }
    stdSPCMatrix_ref Xsend(raw_pointer_cast(bpX.origin()), {long(globalnCV * xx), nwalk * nsteps});
    stdSPCMatrix_ref Xrecv(Xsend.origin() + Xsend.num_elements(), {long(globalnCV * xx), nwalk * nsteps});
    int Xg0, XgN;
    std::tie(Xg0, XgN) = FairDivideBoundary(TG.getLocalTGRank(), globalnCV * nwalk * nsteps, TG.getNCoresPerTG());
    int Xl0, XlN;
    std::tie(Xl0, XlN) = FairDivideBoundary(TG.getLocalTGRank(), localnCV * nwalk * nsteps, TG.getNCoresPerTG());
    int cv0, cvN;
    std::tie(cv0, cvN) = FairDivideBoundary(TG.getLocalTGRank(), localnCV, TG.getNCoresPerTG());

    if (bp_step >= 0 && bp_step < bp_max)
    {
      MPI_Send_init(Xsend.origin() + Xg0, (XgN - Xg0) * sizeof(SPComplexType), MPI_CHAR, TG.prev_core(), 3456, TG.TG().get(),
                    &req_X2send);
      MPI_Recv_init(Xrecv.origin() + Xg0, (XgN - Xg0) * sizeof(SPComplexType), MPI_CHAR, TG.next_core(), 3456, TG.TG().get(),
                    &req_X2recv);
    }

    TG.TG_local().barrier();
    AFQMCTimer.stop(setup_timer);

    MPI_Status st;

    for (int k = 0; k < nnodes; ++k)
    {
      // 2. wait for communication of previous step
      AFQMCTimer.start(vHS_comm_overhead_timer);
      if (k > 0)
      {
        MPI_Wait(&req_Grecv, &st);
        MPI_Wait(&req_Gsend, &st); // need to wait for Gsend in order to overwrite Gwork
        copy_n(make_device_ptr(Grecv.origin()) + Gak0, GakN - Gak0, make_device_ptr(Gwork.origin()) + Gak0);
        TG.TG_local().barrier();
      }

      // 3. setup next communication
      if (k < nnodes - 1)
      {
        MPI_Start(&req_Gsend);
        MPI_Start(&req_Grecv);
      }
      AFQMCTimer.stop(vHS_comm_overhead_timer);
      //std::cout<<" sum(G): " <<k <<" " <<ma::sum(Gwork) <<"\n";

      // calculate vHS contribution from this node
      // 4a. Calculate vbias for initial configuration
      AFQMCTimer.start(vbias_timer);
      wfn.vbias(Gwork, vbias, dt);
      AFQMCTimer.stop(vbias_timer);
      //std::cout<<" sum(vbias): " <<k <<" " <<ma::sum(vbias) <<"\n";

      // 4b. Assemble X(nCV,nsteps,nwalk)
      AFQMCTimer.start(assemble_X_timer);
      int q = (node_number + k) % nnodes;
      assemble_X(nsteps, nwalk, sqrtdt, X, vbias, MFfactor, hybrid_weight);
      copy_n(make_device_ptr(MFfactor.origin()), MFfactor.num_elements(), make_device_ptr(globalMFfactor[q].origin()));
      copy_n(make_device_ptr(hybrid_weight.origin()), hybrid_weight.num_elements(),
             make_device_ptr(globalhybrid_weight[q].origin()));
      TG.TG_local().barrier();
      AFQMCTimer.stop(assemble_X_timer);
      if (bp_step >= 0 && bp_step < bp_max)
      {
        // receive X
        if (k > 0)
        {
          MPI_Wait(&req_X2recv, &st);
          MPI_Wait(&req_X2send, &st);
          copy_n(Xrecv.origin() + Xg0, XgN - Xg0, Xsend.origin() + Xg0);
          TG.TG_local().barrier();
        }
        // accumulate
        copy_n(make_device_ptr(X[cv0].origin()), nwalk * nsteps * (cvN - cv0), Xsend[global_origin + cv0].origin());
        TG.TG_local().barrier();
        // start X communication
        MPI_Start(&req_X2send);
        MPI_Start(&req_X2recv);
      }
      //std::cout<<" sum(X): " <<k <<" " <<ma::sum(X) <<"\n";

      // 4c. Calculate vHS(M*M,nsteps,nwalk)
      AFQMCTimer.start(vHS_timer);
      wfn.vHS(X, vHS, dt);
      TG.TG_local().barrier();
      AFQMCTimer.stop(vHS_timer);
      //std::cout<<" sum(vHS): " <<k <<" " <<ma::sum(vHS) <<"\n";

      AFQMCTimer.start(vHS_comm_overhead_timer);
      // 5. receive v
      if (k > 0)
      {
        MPI_Wait(&req_vrecv, &st);
        MPI_Wait(&req_vsend, &st);
        copy_n(make_device_ptr(vrecv.origin()) + vak0, vakN - vak0, make_device_ptr(vsend.origin()) + vak0);
      }

      // 6. add local contribution to vsend
      ma::axpy(one, vHS.flatted().sliced(vak0, vakN), vsend.flatted().sliced(vak0, vakN));	
      //std::cout<<" sum(vsend): " <<k <<" " <<ma::sum(vsend) <<"\n";

      // 7. start v communication
      MPI_Start(&req_vsend);
      MPI_Start(&req_vrecv);
      TG.TG_local().barrier();
      AFQMCTimer.stop(vHS_comm_overhead_timer);
    }

    // after the wait, vrecv ( and by extention vHS4D ) has the final vHS for the local walkers
    AFQMCTimer.start(vHS_comm_overhead_timer);
    MPI_Wait(&req_vrecv, &st);
    MPI_Wait(&req_vsend, &st);
    MPI_Wait(&req_X2recv, &st);
    MPI_Wait(&req_X2send, &st);

    MPI_Request_free(&req_Grecv);
    MPI_Request_free(&req_Gsend);
    MPI_Request_free(&req_vrecv);
    MPI_Request_free(&req_vsend);

    // store fields in walker
    if (bp_step >= 0 && bp_step < bp_max)
    {
      MPI_Request_free(&req_X2recv);
      MPI_Request_free(&req_X2send);

      int cvg0, cvgN;
      std::tie(cvg0, cvgN) = FairDivideBoundary(TG.getLocalTGRank(), globalnCV, TG.getNCoresPerTG());
      for (int ni = 0; ni < nsteps; ni++)
      {
        if (bp_step < bp_max)
        {
          auto&& V(*wset.getFields(bp_step));
          if(nsteps==1) {
            copy_n_cast(ma::pointer_dispatch(X[cvg0].origin()), nwalk*(cvgN-cvg0), V[cvg0].origin());
          } else {
            APP_ABORT(" Error: fix ");        
            V.sliced(cvg0, cvgN) = Xrecv({cvg0, cvgN}, {ni * nwalk, (ni + 1) * nwalk});  
	  }
          ma::scal(typename WlkSet::bp_element(typename WlkSet::bp_element_value_type(sqrtdt)), V.sliced(cvg0, cvgN));
          bp_step++;
        }
      }
      TG.TG_local().barrier();
    }
    // reduce MF and HWs
    if (TG.TG().size() > 1)
    {
      TG.TG().all_reduce_in_place_n(raw_pointer_cast(globalMFfactor.origin()), globalMFfactor.num_elements(), std::plus<>());
      TG.TG().all_reduce_in_place_n(raw_pointer_cast(globalhybrid_weight.origin()), globalhybrid_weight.num_elements(),
                                    std::plus<>());
    }

    // copy from global to local array
    copy_n(make_device_ptr(globalMFfactor[node_number].origin()), MFfactor.num_elements(),
           make_device_ptr(MFfactor.origin()));
    copy_n(make_device_ptr(globalhybrid_weight[node_number].origin()), hybrid_weight.num_elements(),
           make_device_ptr(hybrid_weight.origin()));

    TG.TG_local().barrier();
    AFQMCTimer.stop(vHS_comm_overhead_timer);
  }

  if constexpr (SP) {
    // is this clever or dirsty? seems to work well and saves memory!
    TG.TG_local().barrier();
    using sfqmc::afqmc::inplace_cast;
    if (TG.TG_local().root())
      inplace_cast<SPComplexType, ComplexType>(vrecv.origin(), vrecv.num_elements());
    TG.TG_local().barrier();
  }
  C4Tensor_ref vHS4D(make_device_ptr(vrecv_buff.origin()), vhs4d_ext);
  //std::cout<<" sum(vHS): " <<ma::sum(vrecv_buff) <<" " <<ma::sum(vrecv_buff[0]) <<"\n";

  // From here on is similar to Shared
  int nx = 1;
  if (walker_type == COLLINEAR)
    nx = 2;

  // from now on, individual work on each walker/step
  const int ntasks_per_core     = int(nx * nwalk) / TG.getNCoresPerTG();
  const int ntasks_total_serial = ntasks_per_core * TG.getNCoresPerTG();
  const int nextra              = int(nx * nwalk) - ntasks_total_serial;

  // each processor does ntasks_percore_serial overlaps serially
  const int tk0 = TG.getLocalTGRank() * ntasks_per_core;
  const int tkN = (TG.getLocalTGRank() + 1) * ntasks_per_core;

  // make new communicator if nextra changed from last setting
  reset_nextra(nextra);

  for (int ni = 0; ni < nsteps_; ni++)
  {
    // 5. Propagate walkers
    AFQMCTimer.start(propagate_timer);
    if (nbatched_propagation != 0)
    {
      apply_propagators_batched('N', wset.getWalkerType(), ni, wset.SlaterMatrices(Alpha),
            wset.SlaterMatrices((wset.getWalkerType()==COLLINEAR?Beta:Alpha)), vHS4D);
    }
    else
    {
      apply_propagators('N', wset, ni, tk0, tkN, ntasks_total_serial, vHS4D);
    }
    AFQMCTimer.stop(propagate_timer);

    // 6. Calculate local energy/overlap
    AFQMCTimer.start(pseudo_energy_timer);
    if (hybrid)
    {
      wfn.Overlap(wset, new_overlaps);
    }
    else
    {
      wfn.Energy(wset, new_energies, new_overlaps);
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(pseudo_energy_timer);

    // 7. update weights/energy/etc, apply constrains/bounds/etc
    AFQMCTimer.start(extra_timer);
    if (TG.TG_local().root())
    {
      if (free_projection)
      {
        free_projection_walker_update(wset, dt, new_overlaps, MFfactor[ni], Eshift, hybrid_weight[ni], work,debug_verbosity);
      }
      else if (hybrid)
      {
        hybrid_walker_update(wset, dt, apply_constrain, importance_sampling, Eshift, new_overlaps, MFfactor[ni],
                             hybrid_weight[ni], work, lower_cutoff_scale, upper_cutoff_scale, true);
      }
      else
      {
        local_energy_walker_update(wset, dt, apply_constrain, Eshift, new_overlaps, new_energies, MFfactor[ni],
                                   hybrid_weight[ni], work, lower_cutoff_scale, upper_cutoff_scale);
      }
      if (wset.getBPPos() >= 0 && wset.getBPPos() < wset.NumBackProp())
        wset.advanceBPPos();
      if (wset.getBPPos() >= 0)
        wset.advanceHistoryPos();
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(extra_timer);
  }
}

// Distributed propagation based on collective communication
/*
 * Propagates the walker population nsteps forward with a fixed vbias (from the initial 
 * configuration).   
 */
template<bool SP>
template<class WlkSet>
void AFQMCDistributedPropagatorDistCV<SP>::step_collective(int nsteps_, WlkSet& wset, RealType Eshift, RealType dt)
{
  using std::copy_n;
  AFQMCTimer.start(setup_timer);
  auto walker_type        = wset.getWalkerType();
  int nsteps              = nsteps_;
  int nwalk               = wset.size();
  RealType sqrtdt         = std::sqrt(dt);
  long Gsize              = wfn.size_of_G_for_vbias();
  const int globalnCV     = wfn.global_number_of_cholesky_vectors();
  const int localnCV      = wfn.local_number_of_cholesky_vectors();
  const int nnodes        = TG.getNGroupsPerTG();
  const int ncores        = TG.getNCoresPerTG();
  const int node_number   = TG.getLocalGroupNumber();
  // if transposed_XXX_=true  --> XXX[nwalk][...],
  // if transposed_XXX_=false --> XXX[...][nwalk]
  auto vhs_ext   = iextensions<2u>{nspins_in_vHS * NMO * NMO, nwalk * nsteps};
  auto vhs4d_ext = iextensions<4u>{nspins_in_vHS, NMO, NMO, nwalk * nsteps};
  auto G_ext     = iextensions<2u>{Gsize, nwalk};
  if (transposed_vHS_)
  {
    vhs_ext   = iextensions<2u>{nspins_in_vHS * nwalk * nsteps, NMO * NMO};
    vhs4d_ext = iextensions<4u>{nspins_in_vHS, nwalk * nsteps, NMO, NMO};
  }
  if (transposed_G_)
    G_ext = iextensions<2u>{nwalk, Gsize};

  if (MFfactor.size(0) != nsteps || MFfactor.size(1) != nwalk)
    MFfactor = CMatrix({long(nsteps), long(nwalk)});
  if (hybrid_weight.size(0) != nsteps || hybrid_weight.size(1) != nwalk)
    hybrid_weight = CMatrix({long(nsteps), long(nwalk)});
  if (new_overlaps.size(0) != nwalk)
    new_overlaps = CVector(iextensions<1u>{nwalk});
  if (new_energies.size(0) != nwalk || new_energies.size(1) != 3)
    new_energies = CMatrix({long(nwalk), 3});

  //  Temporary memory usage summary:
  //  G_for_vbias:     [ Gsize * nwalk ] (2 copies)
  //  vbias:           [ localnCV * nwalk ]
  //  X:               [ localnCV * nwalk * nstep ]
  //  vHS:             [ NMO*NMO * nwalk * nstep ] (2 copies)
  // memory_needs: nwalk * ( 2*nsteps + Gsize + localnCV*(nstep+1) + NMO*NMO*nstep )

  // if timestep changed, recalculate one body propagator
  if (std::abs(dt - old_dt) > 1e-6)
    generateP1(dt, walker_type);
  TG.TG_local().barrier();

  StaticMatrix vrecv_buff(vhs_ext, ComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<ComplexType>());
  C4Tensor_ref vHS4D(make_device_ptr(vrecv_buff.origin()), vhs4d_ext);
  SPCMatrix_ref vrecv(reinterpret_pointer_cast<SPComplexType>(make_device_ptr(vrecv_buff.origin())), vhs_ext);

  // scope controlling lifetime of temporary arrays
  {
    Static3Tensor globalMFfactor({nnodes, nsteps, nwalk}, ComplexType(0.0),
                                 buffer_manager.get_generator().template get_allocator<ComplexType>());
    Static3Tensor globalhybrid_weight({nnodes, nsteps, nwalk}, ComplexType(0.0),
                                      buffer_manager.get_generator().template get_allocator<ComplexType>());
    StaticSPMatrix Gstore(G_ext, SPComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<SPComplexType>());

    int Gak0, GakN;
    std::tie(Gak0, GakN) = FairDivideBoundary(TG.getLocalTGRank(), int(Gstore.num_elements()), TG.getNCoresPerTG());

    // 1. Calculate Green function for all (local) walkers
    AFQMCTimer.start(G_for_vbias_timer);
    if constexpr (SP) {
      StaticMatrix Gstore_(G_ext, ComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<ComplexType>());
      wfn.MixedDensityMatrix_for_vbias(wset, Gstore_);
      copy_n_cast(make_device_ptr(Gstore_.origin()) + Gak0, GakN - Gak0, make_device_ptr(Gstore.origin()) + Gak0);
    } else {
      wfn.MixedDensityMatrix_for_vbias(wset, Gstore);
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(G_for_vbias_timer);

    StaticSPMatrix Gwork(G_ext, SPComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<SPComplexType>());
    StaticSPMatrix vbias({long(localnCV), long(nwalk)}, SPComplexType(0.0),
                buffer_manager.get_generator().template get_allocator<SPComplexType>());
    StaticSPMatrix X({long(localnCV), long(nwalk * nsteps)}, SPComplexType(0.0),
                buffer_manager.get_generator().template get_allocator<SPComplexType>());
    StaticSPMatrix vHS(vhs_ext, SPComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<SPComplexType>());

    // partition G and v for communications: all cores communicate a piece of the matrix
    int vak0, vakN;
    std::tie(vak0, vakN) = FairDivideBoundary(TG.getLocalTGRank(), int(vHS.num_elements()), TG.getNCoresPerTG());

    // are we back propagating?
    int bp_step = wset.getBPPos(), bp_max = wset.NumBackProp();
    int xx(0);
    if (bp_step >= 0 && bp_step < bp_max)
    {
APP_ABORT("Error: back propagation needs update after changes to vHS/vbias ");
      xx = 1;
      size_t m_(globalnCV * nwalk * nsteps);
      if (bpX.num_elements() < m_)
      {
        bpX     = mpi3SPCVector(iextensions<1u>{m_}, shared_allocator<SPComplexType>{TG.TG_local()});
        if (TG.TG_local().root())
          std::fill_n(bpX.origin(), bpX.num_elements(), SPComplexType(0.0));
      }
    }
    stdSPCMatrix_ref Xrecv(raw_pointer_cast(bpX.origin()), {long(globalnCV * xx), nwalk * nsteps});
    int Xg0, XgN;
    std::tie(Xg0, XgN) = FairDivideBoundary(TG.getLocalTGRank(), globalnCV * nwalk * nsteps, TG.getNCoresPerTG());
    int Xl0, XlN;
    std::tie(Xl0, XlN) = FairDivideBoundary(TG.getLocalTGRank(), localnCV * nwalk * nsteps, TG.getNCoresPerTG());
    int cv0, cvN;
    std::tie(cv0, cvN) = FairDivideBoundary(TG.getLocalTGRank(), localnCV, TG.getNCoresPerTG());

    // setup counts, it is possible to keep old one if nwalk*nsteps*(cvN-cv0) doesn't change.
    // what can I assume?
    if (bp_step >= 0 && bp_step < bp_max)
    {
      bpx_counts = TG.TG().all_gather_value(int(nwalk * nsteps * (cvN - cv0)));
      if (TG.TG_local().root())
      {
        bpx_displ.reserve(bpx_counts.size());
        bpx_displ.clear();
        for (int i = 0, s = 0; i < bpx_counts.size(); i++)
        {
          bpx_displ.push_back(s);
          s += bpx_counts[i];
        }
      }
    }

    TG.TG_local().barrier();
    AFQMCTimer.stop(setup_timer);

    for (int k = 0; k < nnodes; ++k)
    {
      // 2. bcast G
      AFQMCTimer.start(vHS_comm_overhead_timer);
      if (k == node_number)
        copy_n(make_device_ptr(Gstore.origin()) + Gak0, GakN - Gak0, make_device_ptr(Gwork.origin()) + Gak0);
#ifdef USE_NCCL
#ifdef ENABLE_CUDA
      if constexpr (SP) {
        NCCLCHECK( ncclBcast(raw_pointer_cast(Gwork.origin() + Gak0), 
			     2 * (GakN - Gak0), ncclFloat, k, TG.ncclTG(), TG.ncclStream()));
      } else { 
        NCCLCHECK( ncclBcast(raw_pointer_cast(Gwork.origin() + Gak0), 
			     2 * (GakN - Gak0), ncclDouble, k, TG.ncclTG(), TG.ncclStream()));
      }	
      qmc_cuda::cuda_check(cudaStreamSynchronize(TG.ncclStream()), "cudaStreamSynchronize(s)");
#else
#error "USE_NCCL only with ENABLE_CUDA"
#endif
#else
      TG.TG_Cores().broadcast_n(raw_pointer_cast(Gwork.origin()) + Gak0, GakN - Gak0, k);
#endif
      TG.TG_local().barrier();
      AFQMCTimer.stop(vHS_comm_overhead_timer);

      // calculate vHS contribution from this node
      // 3a. Calculate vbias for initial configuration
      AFQMCTimer.start(vbias_timer);
      wfn.vbias(Gwork, vbias, dt);
      AFQMCTimer.stop(vbias_timer);

      // 3b. Assemble X(nCV,nsteps,nwalk)
      AFQMCTimer.start(assemble_X_timer);
      assemble_X(nsteps, nwalk, sqrtdt, X, vbias, MFfactor, hybrid_weight);
      copy_n(make_device_ptr(MFfactor.origin()), MFfactor.num_elements(), make_device_ptr(globalMFfactor[k].origin()));
      copy_n(make_device_ptr(hybrid_weight.origin()), hybrid_weight.num_elements(),
             make_device_ptr(globalhybrid_weight[k].origin()));
      TG.TG_local().barrier();
      AFQMCTimer.stop(assemble_X_timer);
      if (bp_step >= 0 && bp_step < bp_max)
      {
        APP_ABORT("Finish");
        // accumulate
        //copy_n(X[cv0].origin(),nwalk*nsteps*(cvN-cv0),Xsend[global_origin+cv0].origin());
        // how do I know if these change???
        // possible if 2 execute blocks use different ncores
        // maybe store last ncores and change if this number changes!!!
        TG.TG().gatherv_n(raw_pointer_cast(X[cv0].origin()), nwalk * nsteps * (cvN - cv0), raw_pointer_cast(Xrecv.origin()),
                          bpx_counts.begin(), bpx_displ.begin(), k * ncores);
        TG.TG_local().barrier();
      }

      // 3c. Calculate vHS(M*M,nsteps,nwalk)
      AFQMCTimer.start(vHS_timer);
      wfn.vHS(X, vHS, dt);
      TG.TG_local().barrier();
      AFQMCTimer.stop(vHS_timer);

      AFQMCTimer.start(vHS_comm_overhead_timer);
      // 4. Reduce vHS
#ifdef USE_NCCL
#ifdef ENABLE_CUDA
      if constexpr (SP) {
        NCCLCHECK(ncclReduce((const void*)raw_pointer_cast(vHS.origin() + vak0), (void*)raw_pointer_cast(vrecv.origin() + vak0),
                           2 * (vakN - vak0), ncclFloat, ncclSum, k, TG.ncclTG(), TG.ncclStream()));
      } else {
        NCCLCHECK(ncclReduce((const void*)raw_pointer_cast(vHS.origin() + vak0), (void*)raw_pointer_cast(vrecv.origin() + vak0),
                           2 * (vakN - vak0), ncclDouble, ncclSum, k, TG.ncclTG(), TG.ncclStream()));
      }
      qmc_cuda::cuda_check(cudaStreamSynchronize(TG.ncclStream()), "cudaStreamSynchronize(s)");
#else
#error "USE_NCCL only with ENABLE_CUDA"
#endif
#else
      TG.TG_Cores().reduce_n(raw_pointer_cast(vHS.origin()) + vak0, vakN - vak0, raw_pointer_cast(vrecv.origin()) + vak0,
                             std::plus<>(), k);
#endif

      TG.TG_local().barrier();
      AFQMCTimer.stop(vHS_comm_overhead_timer);
    }

    // after the wait, vrecv ( and by extention vHS4D ) has the final vHS for the local walkers
    AFQMCTimer.start(vHS_comm_overhead_timer);

    // store fields in walker
    if (bp_step >= 0 && bp_step < bp_max)
    {
      int cvg0, cvgN;
      std::tie(cvg0, cvgN) = FairDivideBoundary(TG.getLocalTGRank(), globalnCV, TG.getNCoresPerTG());
      for (int ni = 0; ni < nsteps; ni++)
      {
        if (bp_step < bp_max)
        {
          auto&& V(*wset.getFields(bp_step));
          V.sliced(cvg0, cvgN) = Xrecv({cvg0, cvgN}, {ni * nwalk, (ni + 1) * nwalk});	
          ma::scal(typename WlkSet::bp_element(typename WlkSet::bp_element_value_type(sqrtdt)), V.sliced(cvg0, cvgN));
          bp_step++;
        }
      }
      TG.TG_local().barrier();
    }
    // reduce MF and HWs, always in DP
    if (TG.TG().size() > 1)
    {
#ifdef USE_NCCL
#ifdef ENABLE_CUDA
      NCCLCHECK(ncclAllReduce((const void*)raw_pointer_cast(globalMFfactor.origin()),
                              (void*)raw_pointer_cast(globalMFfactor.origin()), 2 * globalMFfactor.num_elements(), ncclDouble,
                              ncclSum, TG.ncclTG(), TG.ncclStream()));
      NCCLCHECK(ncclAllReduce((const void*)raw_pointer_cast(globalhybrid_weight.origin()),
                              (void*)raw_pointer_cast(globalhybrid_weight.origin()), 2 * globalhybrid_weight.num_elements(),
                              ncclDouble, ncclSum, TG.ncclTG(), TG.ncclStream()));
      qmc_cuda::cuda_check(cudaStreamSynchronize(TG.ncclStream()), "cudaStreamSynchronize(s)");
#else
#error "USE_NCCL only with ENABLE_CUDA"
#endif
#else
      TG.TG().all_reduce_in_place_n(raw_pointer_cast(globalMFfactor.origin()), globalMFfactor.num_elements(), std::plus<>());
      TG.TG().all_reduce_in_place_n(raw_pointer_cast(globalhybrid_weight.origin()), globalhybrid_weight.num_elements(),
                                    std::plus<>());
#endif
    }
    TG.TG_local().barrier();

    // copy from global to local array
    copy_n(make_device_ptr(globalMFfactor[node_number].origin()), MFfactor.num_elements(),
           make_device_ptr(MFfactor.origin()));
    copy_n(make_device_ptr(globalhybrid_weight[node_number].origin()), hybrid_weight.num_elements(),
           make_device_ptr(hybrid_weight.origin()));

    AFQMCTimer.stop(vHS_comm_overhead_timer);
  } // scope controlling lifetime of temporary arrays

  if constexpr (SP) {
    TG.TG_local().barrier();
    using sfqmc::afqmc::inplace_cast;
    if (TG.TG_local().root())
      inplace_cast<SPComplexType, ComplexType>(make_device_ptr(vrecv.origin()), vrecv.num_elements());
    TG.TG_local().barrier();
  }
  //std::cout<<" sum(vHS): " <<ma::sum(vrecv_buff) <<" " <<ma::sum(vrecv_buff[0]) <<"\n";

  // From here on is similar to Shared
  int nx = 1;
  if (walker_type == COLLINEAR)
    nx = 2;

  // from now on, individual work on each walker/step
  const int ntasks_per_core     = int(nx * nwalk) / TG.getNCoresPerTG();
  const int ntasks_total_serial = ntasks_per_core * TG.getNCoresPerTG();
  const int nextra              = int(nx * nwalk) - ntasks_total_serial;

  // each processor does ntasks_percore_serial overlaps serially
  const int tk0 = TG.getLocalTGRank() * ntasks_per_core;
  const int tkN = (TG.getLocalTGRank() + 1) * ntasks_per_core;

  // make new communicator if nextra changed from last setting
  reset_nextra(nextra);

  for (int ni = 0; ni < nsteps_; ni++)
  {
    // 5. Propagate walkers
    AFQMCTimer.start(propagate_timer);
    if (nbatched_propagation != 0)
    {
      apply_propagators_batched('N', wset.getWalkerType(), ni, wset.SlaterMatrices(Alpha),
            wset.SlaterMatrices((wset.getWalkerType()==COLLINEAR?Beta:Alpha)), vHS4D);
    }
    else
    {
      apply_propagators('N', wset, ni, tk0, tkN, ntasks_total_serial, vHS4D);
    }
    AFQMCTimer.stop(propagate_timer);

    // 6. Calculate local energy/overlap
    AFQMCTimer.start(pseudo_energy_timer);
    if (hybrid)
    {
      wfn.Overlap(wset, new_overlaps);
    }
    else
    {
      wfn.Energy(wset, new_energies, new_overlaps);
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(pseudo_energy_timer);

    // 7. update weights/energy/etc, apply constrains/bounds/etc
    AFQMCTimer.start(extra_timer);
    if (TG.TG_local().root())
    {
      if (free_projection)
      {
        free_projection_walker_update(wset, dt, new_overlaps, MFfactor[ni], Eshift, hybrid_weight[ni], work,debug_verbosity);
      }
      else if (hybrid)
      {
        hybrid_walker_update(wset, dt, apply_constrain, importance_sampling, Eshift, new_overlaps, MFfactor[ni],
                             hybrid_weight[ni], work, lower_cutoff_scale, upper_cutoff_scale, true);
      }
      else
      {
        local_energy_walker_update(wset, dt, apply_constrain, Eshift, new_overlaps, new_energies, MFfactor[ni],
                                   hybrid_weight[ni], work, lower_cutoff_scale, upper_cutoff_scale);
      }
      if (wset.getBPPos() >= 0 && wset.getBPPos() < wset.NumBackProp())
        wset.advanceBPPos();
      if (wset.getBPPos() >= 0)
        wset.advanceHistoryPos();
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(extra_timer);
  }
}

/*
 * This routine assumes that the 1 body propagator does not need updating
 */
template<bool SP>
template<class WlkSet, class CTens, class CMat>
void AFQMCDistributedPropagatorDistCV<SP>::BackPropagate(int nbpsteps,
                                                     int nStabalize,
                                                     WlkSet& wset,
                                                     CTens&& Refs,
                                                     CMat&& logdetR)
{
  using std::copy_n;
  const SPComplexType one(1.), zero(0.);
  auto walker_type        = wset.getWalkerType();
  const int nwalk         = wset.size();
  int nspin        = (walker_type == COLLINEAR) ? 2 : 1;
  const int globalnCV     = wfn.global_number_of_cholesky_vectors();
  const int localnCV      = wfn.local_number_of_cholesky_vectors();
  const int global_origin = wfn.global_origin_cholesky_vector();
  const int nnodes        = TG.getNGroupsPerTG();

  auto vhs_ext   = iextensions<2u>{nspins_in_vHS * NMO * NMO, nwalk};
  auto vhs4d_ext = iextensions<4u>{nspins_in_vHS, NMO, NMO, nwalk};
  if (transposed_vHS_)
  {
    vhs_ext   = iextensions<2u>{nspins_in_vHS * nwalk, NMO * NMO};
    vhs4d_ext = iextensions<4u>{nspins_in_vHS, nwalk, NMO, NMO};
  }

  //  Shared buffer used for:
  //  X:               [ (localnCV + 2*globalnCV) * nwalk ]
  //  vHS:             [ NMO*NMO * nwalk ] (3 copies)
  // memory_needs: nwalk * ( localnCV + NMO*NMO )

  StaticSPMatrix X({long(localnCV), long(nwalk)}, SPComplexType(0.0),
                   buffer_manager.get_generator().template get_allocator<SPComplexType>());
  StaticSPMatrix Xsend({long(globalnCV), long(nwalk)}, SPComplexType(0.0),
                       buffer_manager.get_generator().template get_allocator<SPComplexType>());
  StaticSPMatrix Xrecv({long(globalnCV), long(nwalk)}, SPComplexType(0.0),
                       buffer_manager.get_generator().template get_allocator<SPComplexType>());
  StaticMatrix vrecv_buff(vhs_ext, ComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<ComplexType>());
  SPCMatrix_ref vrecv(reinterpret_pointer_cast<SPComplexType>(make_device_ptr(vrecv_buff.origin())), vhs_ext);
  StaticSPMatrix vsend(vhs_ext, SPComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<SPComplexType>());
  StaticSPMatrix vHS(vhs_ext, SPComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<SPComplexType>());

  // partition G and v for communications: all cores communicate a piece of the matrix
  int vak0, vakN;
  int X0, XN;
  std::tie(X0, XN)     = FairDivideBoundary(TG.getLocalTGRank(), int(Xsend.num_elements()), TG.getNCoresPerTG());
  std::tie(vak0, vakN) = FairDivideBoundary(TG.getLocalTGRank(), int(vHS.num_elements()), TG.getNCoresPerTG());
  MPI_Send_init(raw_pointer_cast(Xsend.origin()) + X0, (XN - X0) * sizeof(SPComplexType), MPI_CHAR, TG.prev_core(), 2345,
                TG.TG().get(), &req_Xsend);
  MPI_Recv_init(raw_pointer_cast(Xrecv.origin()) + X0, (XN - X0) * sizeof(SPComplexType), MPI_CHAR, TG.next_core(), 2345,
                TG.TG().get(), &req_Xrecv);
  MPI_Send_init(raw_pointer_cast(vsend.origin()) + vak0, (vakN - vak0) * sizeof(SPComplexType), MPI_CHAR, TG.prev_core(),
                6789, TG.TG().get(), &req_bpvsend);
  MPI_Recv_init(raw_pointer_cast(vrecv.origin()) + vak0, (vakN - vak0) * sizeof(SPComplexType), MPI_CHAR, TG.next_core(),
                6789, TG.TG().get(), &req_bpvrecv);
  TG.TG_local().barrier();

  auto&& Fields(*wset.getFields());
  RUNTIME_CHECK(Fields.size(0) >= nbpsteps, "");
  RUNTIME_CHECK(Fields.size(1) == globalnCV, "");
  RUNTIME_CHECK(Fields.size(2) == nwalk, "");

  int nrow(NMO * ((walker_type == NONCOLLINEAR) ? 2 : 1));
  int ncol(NAEA + ((walker_type == CLOSED) ? 0 : NAEB));
  RUNTIME_CHECK(Refs.size(0) == nwalk, "");
  int nrefs = Refs.size(1);
  RUNTIME_CHECK(Refs.size(2) == nrow * ncol, "");

  int cv0, cvN;
  std::tie(cv0, cvN) = FairDivideBoundary(TG.getLocalTGRank(), localnCV, TG.getNCoresPerTG());
  int r0, rN;
  std::tie(r0, rN) = FairDivideBoundary(TG.getLocalTGRank(), nrow * ncol, TG.getNCoresPerTG());

  MPI_Status st;

  int nx = 1;
  if (walker_type == COLLINEAR)
    nx = 2;

  RUNTIME_CHECK(logdetR.size(0) == nwalk, "");
  RUNTIME_CHECK(logdetR.size(1) == nrefs * nx, "");
  ma::fill(logdetR, ComplexType(0.0, 0.0));

  // from now on, individual work on each walker/step
  const int ntasks_per_core     = int(nx * nwalk) / TG.getNCoresPerTG();
  const int ntasks_total_serial = ntasks_per_core * TG.getNCoresPerTG();
  const int nextra              = int(nx * nwalk) - ntasks_total_serial;

  // each processor does ntasks_percore_serial overlaps serially
  const int tk0 = TG.getLocalTGRank() * ntasks_per_core;
  const int tkN = (TG.getLocalTGRank() + 1) * ntasks_per_core;

  // make new communicator if nextra changed from last setting
  reset_nextra(nextra);

  // to avoid having to modify the existing routines,
  // I'm storing the walkers SlaterMatrix on SlaterMatrixAux
  // and copying the back propagated references into SlaterMatrix
  // 0. copy SlaterMatrix to SlaterMatrixAux
  for (int i = 0; i < nwalk; i++)
  {
    copy_n((*wset[i].SlaterMatrix(Alpha)).origin() + r0, rN - r0, (*wset[i].SlaterMatrixAux(Alpha)).origin() + r0);
    // optimize for the single reference case
    if (nrefs == 1)
      copy_n(Refs[i][0].origin() + r0, rN - r0, (*wset[i].SlaterMatrix(Alpha)).origin() + r0);
  }
  TG.TG_local().barrier();

  for (int ni = nbpsteps - 1; ni >= 0; --ni)
  {
    // 1. Get X(nCV,nwalk) from wset
    ma::fill(vsend.flatted().sliced(vak0, vakN), zero);
    copy_n_cast(Fields[ni].origin() + X0, (XN - X0), make_device_ptr(Xsend.origin()) + X0);
    TG.TG_local().barrier();
    copy_n(make_device_ptr(Xsend[global_origin + cv0].origin()), nwalk * (cvN - cv0), make_device_ptr(X[cv0].origin()));
    TG.TG_local().barrier();
    // 2. Calculate vHS(M*M,nwalk)/vHS(nwalk,M*M) using distributed algorithm
    for (int k = 0; k < nnodes; ++k)
    {
      // 2.1 wait for communication of previous step
      if (k > 0)
      {
        MPI_Wait(&req_Xrecv, &st);
        MPI_Wait(&req_Xsend, &st); // need to wait for Gsend in order to overwrite Gwork
        copy_n(make_device_ptr(Xrecv.origin()) + X0, XN - X0, make_device_ptr(Xsend.origin()) + X0);
        TG.TG_local().barrier();
        copy_n(make_device_ptr(Xsend[global_origin + cv0].origin()), nwalk * (cvN - cv0),
               make_device_ptr(X[cv0].origin()));
        TG.TG_local().barrier();
      }

      // 2.2 setup next communication
      if (k < nnodes - 1)
      {
        MPI_Start(&req_Xsend);
        MPI_Start(&req_Xrecv);
      }

      // 2.3 Calculate vHS
      // MAM: This works (set dt=1.0) because only continuous HST are 
      // allowed with this propagator and the fields were scaled by sqrt(dt)
      // before being saved
      wfn.vHS(X, vHS, 1.0);

      // 2.4 receive v
      if (k > 0)
      {
        MPI_Wait(&req_bpvrecv, &st);
        MPI_Wait(&req_bpvsend, &st);
        copy_n(make_device_ptr(vrecv.origin()) + vak0, vakN - vak0, make_device_ptr(vsend.origin()) + vak0);
      }
      TG.TG_local().barrier();

      // 2.5 add local contribution to vsend
      ma::axpy(one, vHS.sliced(vak0, vakN), vsend.sliced(vak0, vakN));	
      //std::cout<<" k vsend: " <<TG.Global().rank() <<" " <<k <<" " <<ma::dot(vsend[0],vsend[0]) <<"\n" <<std::endl;

      // 2.6 start v communication
      MPI_Start(&req_bpvsend);
      MPI_Start(&req_bpvrecv);
      TG.TG_local().barrier();
    }

    MPI_Wait(&req_bpvrecv, &st);
    MPI_Wait(&req_bpvsend, &st);
    TG.TG_local().barrier();
    //std::cout<<" vrecv: " <<TG.Global().rank() <<" " <<ma::dot(vrecv[0],vrecv[0]) <<"\n" <<std::endl;

    if constexpr (SP) {
      TG.TG_local().barrier();
      if (TG.TG_local().root())
        inplace_cast<SPComplexType, ComplexType>(vrecv.origin(), vrecv.num_elements());
      TG.TG_local().barrier();
    }
    C4Tensor_ref vHS4D(make_device_ptr(vrecv_buff.origin()), vhs4d_ext);

    for (int nr = 0; nr < nrefs; ++nr)
    {
      // 3. copy reference to SlaterMatrix
      if (nrefs > 1)
        for (int i = 0; i < nwalk; i++)
          copy_n(Refs[i][nr].origin() + r0, rN - r0, (*wset[i].SlaterMatrix(Alpha)).origin() + r0);
      TG.TG_local().barrier();

      // 4. Propagate walkers
      if (nbatched_propagation != 0)
        apply_propagators_batched('H', wset.getWalkerType(), 0, wset.SlaterMatrices(Alpha),
            wset.SlaterMatrices((wset.getWalkerType()==COLLINEAR?Beta:Alpha)), vHS4D);
      else
        apply_propagators('H', wset, 0, tk0, tkN, ntasks_total_serial, vHS4D);
      TG.TG_local().barrier();

      // always end (ni==0) with orthogonalization
      if (ni == 0 || ni % nStabalize == 0)
        Orthogonalize_impl(wset, logdetR(logdetR.extension(0), {nspin * nr, nspin * nr + nspin}));

      // 5. copy reference to back
      if (nrefs > 1)
        for (int i = 0; i < nwalk; i++)
          copy_n((*wset[i].SlaterMatrix(Alpha)).origin() + r0, rN - r0, Refs[i][nr].origin() + r0);
      TG.TG_local().barrier();
    }
  }

  // 6. restore the Slater Matrix
  for (int i = 0; i < nwalk; i++)
  {
    if (nrefs == 1)
      copy_n((*wset[i].SlaterMatrix(Alpha)).origin() + r0, rN - r0, Refs[i][0].origin() + r0);
    copy_n((*wset[i].SlaterMatrixAux(Alpha)).origin() + r0, rN - r0, (*wset[i].SlaterMatrix(Alpha)).origin() + r0);
  }
  MPI_Request_free(&req_Xrecv);
  MPI_Request_free(&req_Xsend);
  MPI_Request_free(&req_bpvrecv);
  MPI_Request_free(&req_bpvsend);
  TG.TG_local().barrier();
}

template<bool SP>
template<class WlkSet, class Mat1, class Mat2, class Mat3>
void AFQMCDistributedPropagatorDistCV<SP>::PropagateOperators([[maybe_unused]] int steps, 
                                                              [[maybe_unused]] WlkSet& wset,
                                                              [[maybe_unused]] Mat1&& X,
                                                              [[maybe_unused]] Mat2&& Y, 
                                                              [[maybe_unused]]  Mat3&& M)
{
  APP_ABORT(" Error: AFQMCDistributedPropagatorDistCV::PropagateOperators \n\n");
}


} // namespace afqmc

} // namespace sfqmc
