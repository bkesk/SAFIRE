#include <vector>
#include <map>
#include <string>
#include <iostream>
#include <tuple>

#include "AFQMC/config.h"
#include "AFQMC/Utilities/AFQMCTimer.h"
#include "AFQMC/Utilities/Utils.hpp"
#include "AFQMC/Propagators/WalkerSetUpdate.hpp"
#include "AFQMC/Walkers/WalkerConfig.hpp"

namespace sfqmc
{
namespace afqmc
{
/*
 * Propagates the walker population nsteps forward with a fixed vbias (from the initial 
 * configuration).   
 */
template<bool SP>
template<class WlkSet>
void AFQMCDistributedPropagator<SP>::step(int nsteps_, WlkSet& wset, RealType Eshift, RealType dt)
{
  using std::copy_n;
  AFQMCTimer.start(setup_timer);
  auto walker_type      = wset.getWalkerType();
  int nsteps            = size_t(nsteps_);
  int nwalk             = wset.size();
  RealType sqrtdt       = std::sqrt(dt);
  long Gsize            = wfn.size_of_G_for_vbias();
  long nCV              = wfn.global_number_of_cholesky_vectors();
  const int nnodes      = TG.getNGroupsPerTG();
  const int node_number = TG.getLocalGroupNumber();
  // if transposed_XXX_=true  --> XXX[nwalk][...],
  // if transposed_XXX_=false --> XXX[...][nwalk]
  auto vhs_ext   = iextensions<2u>{nspins_in_vHS * NMO * NMO, nwalk * nsteps};
  auto vhs4d_ext = iextensions<4u>{nspins_in_vHS, NMO, NMO, nwalk * nsteps};
  auto G_ext     = iextensions<2u>{Gsize, nwalk};
  if (transposed_vHS_)
  {
    vhs_ext   = iextensions<2u>{nspins_in_vHS * nwalk * nsteps, NMO * NMO};
    vhs4d_ext = iextensions<4u>{nspins_in_vHS, nwalk * nsteps, NMO, NMO};
  }
  if (transposed_G_)
    G_ext = iextensions<2u>{nwalk, Gsize};

  if (MFfactor.size(1) != nsteps || MFfactor.size(2) != nwalk)
    MFfactor = C3Tensor({2, nsteps, nwalk});
  if (hybrid_weight.size(1) != nsteps || hybrid_weight.size(2) != nwalk)
    hybrid_weight = C3Tensor({2, nsteps, nwalk});

  if (new_overlaps.size(0) != nwalk)
    new_overlaps = CVector(iextensions<1u>{nwalk});
  if (new_energies.size(0) != nwalk || new_energies.size(1) != 3)
    new_energies = CMatrix({nwalk, 3});

  //  Summary of temporary memory usage:
  //  G_for_vbias:     [ Gsize * nwalk ] (2 copies)
  //  X:               [ nCV * nwalk * nstep ] (2 copies)
  //  vbias:           [ nCV * nwalk ]
  //  vHS:             [ NMO*NMO * nwalk * nstep ] (2 copies)
  //  memory_needs: nwalk * ( 2*Gsize + nCV*(nstep+1) + 2*NMO*NMO*nstep )

  // if timestep changed, recalculate one body propagator
  if (std::abs(dt - old_dt) > 1e-6)
    generateP1(dt, walker_type);
  TG.TG_local().barrier();
  AFQMCTimer.stop(setup_timer);

  StaticMatrix vHS_buff(vhs_ext, ComplexType(0.0),
			buffer_manager.get_generator().template get_allocator<ComplexType>());
  SPCMatrix_ref vHS(reinterpret_pointer_cast<SPComplexType>(make_device_ptr(vHS_buff.origin())), vhs_ext);
  {
    StaticSPMatrix G(G_ext, SPComplexType(0.0),
		     buffer_manager.get_generator().template get_allocator<SPComplexType>());

    // 1. Calculate Green function for all (local) walkers
    AFQMCTimer.start(G_for_vbias_timer);
    if constexpr (SP) {
      // control scope of Gc
      int Gak0, GakN;
      std::tie(Gak0, GakN) = FairDivideBoundary(TG.getLocalTGRank(), int(G.num_elements()), TG.getNCoresPerTG());
      StaticMatrix Gc(G_ext, ComplexType(0.0),
		      buffer_manager.get_generator().template get_allocator<ComplexType>());
      wfn.MixedDensityMatrix_for_vbias(wset, Gc);
      TG.TG_local().barrier();
      copy_n_cast(make_device_ptr(Gc.origin()) + Gak0, GakN - Gak0, make_device_ptr(G.origin()) + Gak0);
      TG.TG_local().barrier();
    } else {
      wfn.MixedDensityMatrix_for_vbias(wset, G);
    }
    AFQMCTimer.stop(G_for_vbias_timer);

    StaticSPMatrix Gwork(G_ext, SPComplexType(0.0),
		 	 buffer_manager.get_generator().template get_allocator<SPComplexType>());
    StaticSPMatrix X({long(nCV), long(nwalk * nsteps)}, SPComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<SPComplexType>());
    StaticSPMatrix vbias({long(nCV), long(nwalk)}, SPComplexType(0.0),
                         buffer_manager.get_generator().template get_allocator<SPComplexType>());
    StaticSPMatrix RNG({long(nCV), long(nwalk * nsteps)}, SPComplexType(0.0),
                       buffer_manager.get_generator().template get_allocator<SPComplexType>());
    StaticSPMatrix vHSwork(vhs_ext, SPComplexType(0.0),
			buffer_manager.get_generator().template get_allocator<SPComplexType>());

    // partition G and v for communications: all cores communicate a piece of the matrix
    long vak0, vakN;
    long vb0, vbN;
    // This includes both Gwork and X
    long G0, GN, X0, XN;
    std::tie(G0, GN)     = FairDivideBoundary(TG.getLocalTGRank(), int(Gwork.num_elements()), TG.getNCoresPerTG());
    std::tie(X0, XN)     = FairDivideBoundary(TG.getLocalTGRank(), int(X.num_elements()), TG.getNCoresPerTG());
    std::tie(vak0, vakN) = FairDivideBoundary(TG.getLocalTGRank(), int(vHSwork.num_elements()), TG.getNCoresPerTG());
    std::tie(vb0, vbN)   = FairDivideBoundary(TG.getLocalTGRank(), int(vbias.num_elements()), TG.getNCoresPerTG());

    // generate random numbers
    {
      int i0, iN;
      if(nCV == rng_block_size) {
        std::tie(i0, iN) = FairDivideBoundary(TG.TG_local().rank(), int(RNG.num_elements()), TG.TG_local().size());
        utils::sampleGaussianFields_n(make_device_ptr(RNG.origin()) + i0, iN - i0, *rng);
      } else {
        std::tie(i0, iN) = FairDivideBoundary(TG.TG_local().rank(), rng_block_size, TG.TG_local().size());
        if(iN <= nCV) {
          utils::sampleGaussianFields_n(make_device_ptr(RNG[i0].origin()), (iN - i0)*RNG.size(1), *rng);
        } else if(i0 < nCV) {
          // throw some away 
          StaticSPVector R(iextensions<1u>{ (iN-i0)*RNG.size(1) },
                           buffer_manager.get_generator().template get_allocator<SPComplexType>());
          utils::sampleGaussianFields_n(make_device_ptr(R.origin()), R.size(0), *rng);
          copy_n(R.origin(), (nCV-i0)*RNG.size(1), RNG[i0].origin());
        } else {
          // throw all away 
          StaticSPVector R(iextensions<1u>{ (iN-i0)*RNG.size(1) },
                           buffer_manager.get_generator().template get_allocator<SPComplexType>());
          utils::sampleGaussianFields_n(make_device_ptr(R.origin()), R.size(0), *rng);
        }
      }
    }

    for (int k = 0; k < nnodes; ++k)
    {
      // 2. bcast G (and X) to TG
      AFQMCTimer.start(vHS_comm_overhead_timer);
      if (k == node_number)
      {
        int i0, iN, Gak0, GakN;
        std::tie(i0, iN)     = FairDivideBoundary(TG.TG_local().rank(), int(RNG.num_elements()), TG.TG_local().size());
        std::tie(Gak0, GakN) = FairDivideBoundary(TG.TG_local().rank(), int(G.num_elements()), TG.TG_local().size());
        copy_n(make_device_ptr(RNG.origin()) + i0, iN - i0, make_device_ptr(X.origin()) + i0);
        // can I do this in a way I don't need the barrier???
        copy_n(make_device_ptr(G.origin()) + Gak0, GakN - Gak0, make_device_ptr(Gwork.origin()) + Gak0);
        TG.TG_local().barrier();
      }
      core_comm.broadcast_n(raw_pointer_cast(Gwork.origin()) + G0, GN - G0, k);
      core_comm.broadcast_n(raw_pointer_cast(X.origin()) + X0, XN - X0, k);
      TG.TG_local().barrier();
      AFQMCTimer.stop(vHS_comm_overhead_timer);

      // calculate vHS contribution from this node
      // 4a. Calculate vbias for initial configuration
      AFQMCTimer.start(vbias_timer);
      wfn.vbias(Gwork, vbias, dt);
      AFQMCTimer.stop(vbias_timer);

      // all_reduce vbias
      AFQMCTimer.start(vHS_comm_overhead_timer);
      core_comm.all_reduce_in_place_n(raw_pointer_cast(vbias.origin()) + vb0, vbN - vb0, std::plus<>());
      TG.TG_local().barrier();
      AFQMCTimer.stop(vHS_comm_overhead_timer);

      // 4b. Assemble X(nCV,nsteps,nwalk)
      assemble_X(nsteps, nwalk, sqrtdt, X, vbias, MFfactor[1], hybrid_weight[1], false);
      if (k == node_number)
      {
        TG.TG_local().all_reduce_n(raw_pointer_cast(MFfactor[1].origin()), MFfactor[1].num_elements(),
                                   raw_pointer_cast(MFfactor[0].origin()), std::plus<>());
        TG.TG_local().all_reduce_n(raw_pointer_cast(hybrid_weight[1].origin()), hybrid_weight[1].num_elements(),
                                   raw_pointer_cast(hybrid_weight[0].origin()), std::plus<>());
      }

      // 4c. Calculate vHS(M*M,nsteps,nwalk)
      AFQMCTimer.start(vHS_timer);
      wfn.vHS(X, vHSwork, dt);
      TG.TG_local().barrier();
      AFQMCTimer.stop(vHS_timer);

      AFQMCTimer.start(vHS_comm_overhead_timer);
      core_comm.reduce_n(raw_pointer_cast(vHSwork.origin()) + vak0, vakN - vak0, raw_pointer_cast(vHS.origin()) + vak0,
                         std::plus<>(), k);
      TG.TG_local().barrier();
      AFQMCTimer.stop(vHS_comm_overhead_timer);
    }
  }

  if constexpr (SP) {
    // is this clever or dirsty? seems to work well and saves memory!
    TG.TG_local().barrier();
    using sfqmc::afqmc::inplace_cast;
    if (TG.TG_local().root())
      inplace_cast<SPComplexType, ComplexType>(vHS.origin(), vHS.num_elements());
    TG.TG_local().barrier();
  }
  C4Tensor_ref vHS4D(make_device_ptr(vHS_buff.origin()), vhs4d_ext);

  // From here on is similar to Shared
  int nx = 1;
  if (walker_type == COLLINEAR)
    nx = 2;

  // from now on, individual work on each walker/step
  const int ntasks_per_core     = int(nx * nwalk) / TG.getNCoresPerTG();
  const int ntasks_total_serial = ntasks_per_core * TG.getNCoresPerTG();
  const int nextra              = int(nx * nwalk) - ntasks_total_serial;

  // each processor does ntasks_percore_serial overlaps serially
  const int tk0 = TG.getLocalTGRank() * ntasks_per_core;
  const int tkN = (TG.getLocalTGRank() + 1) * ntasks_per_core;

  // make new communicator if nextra changed from last setting
  reset_nextra(nextra);

  for (int ni = 0; ni < nsteps_; ni++)
  {
    // 5. Propagate walkers
    AFQMCTimer.start(propagate_timer);
    if (nbatched_propagation != 0)
    {
      apply_propagators_batched('N', wset.getWalkerType(), ni, wset.SlaterMatrices(Alpha),
            wset.SlaterMatrices((wset.getWalkerType()==COLLINEAR?Beta:Alpha)), vHS4D);
    }
    else
    {
      apply_propagators('N', wset, ni, tk0, tkN, ntasks_total_serial, vHS4D);
    }
    AFQMCTimer.stop(propagate_timer);

    // 6. Calculate local energy/overlap
    AFQMCTimer.start(pseudo_energy_timer);
    if (hybrid)
    {
      wfn.Overlap(wset, new_overlaps);
    }
    else
    {
      wfn.Energy(wset, new_energies, new_overlaps);
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(pseudo_energy_timer);

    // 7. update weights/energy/etc, apply constrains/bounds/etc
    AFQMCTimer.start(extra_timer);
    if (TG.TG_local().root())
    {
      if (free_projection)
      {
        free_projection_walker_update(wset, dt, new_overlaps, MFfactor[0][ni], Eshift, hybrid_weight[0][ni], work,debug_verbosity);
      }
      else if (hybrid)
      {
        hybrid_walker_update(wset, dt, apply_constrain, importance_sampling, Eshift, new_overlaps, MFfactor[0][ni],
                             hybrid_weight[0][ni], work, lower_cutoff_scale, upper_cutoff_scale, true, debug_verbosity);
      }
      else
      {
        local_energy_walker_update(wset, dt, apply_constrain, Eshift, new_overlaps, new_energies, MFfactor[0][ni],
                                   hybrid_weight[0][ni], work, lower_cutoff_scale, upper_cutoff_scale);
      }
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(extra_timer);
  }
}

template<bool SP>
template<class WlkSet, class Mat1, class Mat2, class Mat3>
void AFQMCDistributedPropagator<SP>::PropagateOperators([[maybe_unused]] int steps, 
                                                        [[maybe_unused]] WlkSet& wset, 
                                                        [[maybe_unused]] Mat1&& X, 
                                                        [[maybe_unused]]  Mat2&& Y, 
                                                        [[maybe_unused]]  Mat3&& M)
{
  APP_ABORT(" Error: AFQMCDistributedPropagator::PropagateOperators \n\n");
}

} // namespace afqmc

} // namespace sfqmc
