/*
 * Propagates the walker population nsteps forward with a fixed vbias (from the initial 
 * configuration).   
 */
template<bool SP>
template<class WlkSet>
void AFQMCBasePropagator<SP>::step(int nsteps_, WlkSet& wset, RealType Eshift, RealType dt)
{
  AFQMCTimer.start(setup_timer);
  auto walker_type = wset.getWalkerType();
  int nsteps       = nsteps_;
  int nwalk        = wset.size();
  SPRealType sqrtdt  = std::sqrt(SPRealType(dt));
  long Gsize       = wfn.size_of_G_for_vbias();
  int localnCV     = wfn.local_number_of_cholesky_vectors();
  // if transposed_XXX_=true  --> XXX[nwalk][...],
  // if transposed_XXX_=false --> XXX[...][nwalk]
  auto vhs_ext   = iextensions<2u>{nspins_in_vHS * NMO * NMO, nwalk * nsteps};
  auto vhs4d_ext = iextensions<4u>{nspins_in_vHS, NMO, NMO, nwalk * nsteps};
  auto G_ext     = iextensions<2u>{Gsize, nwalk};
  if (transposed_vHS_)
  {
    vhs_ext   = iextensions<2u>{nspins_in_vHS * nwalk * nsteps, NMO * NMO};
    vhs4d_ext = iextensions<4u>{nspins_in_vHS, nwalk * nsteps, NMO, NMO};
  }
  if (transposed_G_)
    G_ext = iextensions<2u>{nwalk, Gsize};

  if (MFfactor.size(0) != nsteps || MFfactor.size(1) != nwalk)
    MFfactor = CMatrix({long(nsteps), long(nwalk)});
  if (hybrid_weight.size(0) != nsteps || hybrid_weight.size(1) != nwalk)
    hybrid_weight = CMatrix({long(nsteps), long(nwalk)});
  if (new_overlaps.size(0) != nwalk)
    new_overlaps = CVector(iextensions<1u>{nwalk});
  if (new_energies.size(0) != nwalk || new_energies.size(1) != 3)
    new_energies = CMatrix({long(nwalk), 3});


  //  shared buffer used for:
  //  G_for_vbias:     [ Gsize * nwalk ]
  //  vbias:           [ localnCV * nwalk ]
  //  X:               [ localnCV * nwalk * nstep ]
  //  vHS:             [ nspins_in_vHS*NMO*NMO * nwalk * nstep ]
  // memory_needs: nwalk * ( 2*nsteps + Gsize + localnCV*(nstep+1) + nspins_in_vHS*NMO*NMO*nstep )

  int cv0, cvN;
  std::tie(cv0, cvN) = FairDivideBoundary(TG.getLocalTGRank(), localnCV, TG.getNCoresPerTG());

  // if timestep changed, recalculate one body propagator and vMF
  if (std::abs(dt - old_dt) > 1e-6)
    generateP1(dt, walker_type);
  AFQMCTimer.stop(setup_timer);

  StaticMatrix vHS(vhs_ext, ComplexType(0.0),
		   buffer_manager.get_generator().template get_allocator<ComplexType>());

  { // using scope to control lifetime of StaticArrays, avoiding unnecesary buffer space

    StaticSPMatrix G(G_ext, SPComplexType(0.0),
		     buffer_manager.get_generator().template get_allocator<SPComplexType>());

    // 1. Calculate Green function for all walkers
    AFQMCTimer.start(G_for_vbias_timer);
    if constexpr (SP) { 
      int Gak0, GakN;
      std::tie(Gak0, GakN) = FairDivideBoundary(TG.getLocalTGRank(), int(G.num_elements()), TG.getNCoresPerTG());
      StaticMatrix Gc(G_ext, SPComplexType(0.0),
		      buffer_manager.get_generator().template get_allocator<ComplexType>());
      wfn.MixedDensityMatrix_for_vbias(wset, Gc);
      copy_n_cast(make_device_ptr(Gc.origin()) + Gak0, GakN - Gak0, make_device_ptr(G.origin()) + Gak0);
      TG.TG_local().barrier();
    } else {
      wfn.MixedDensityMatrix_for_vbias(wset, G);
    }
    AFQMCTimer.stop(G_for_vbias_timer);
    //std::cout<<" G: " <<ma::sum(G) <<std::endl;

    StaticSPMatrix vbias({long(localnCV), long(nwalk)}, SPComplexType(0.0),
                         buffer_manager.get_generator().template get_allocator<SPComplexType>());
    // 2. Calculate vbias for initial configuration
    AFQMCTimer.start(vbias_timer);
    if (free_projection)
    {
      ma::fill(vbias, SPComplexType(0.0, 0.0));
    }
    else
    {
      wfn.vbias(G, vbias, dt);
    }
    AFQMCTimer.stop(vbias_timer);
    //std::cout<<" vbias: " <<ma::sum(vbias) <<std::endl;

    StaticSPMatrix X({long(localnCV), long(nsteps * nwalk)}, SPComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<SPComplexType>());
    // 3. Assemble X(nCV,nsteps,nwalk)
    AFQMCTimer.start(assemble_X_timer);
    assemble_X(nsteps, nwalk, sqrtdt, X, vbias, MFfactor, hybrid_weight);
    if (TG.TG_local().size() > 1)
    {
      TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(MFfactor.origin()), MFfactor.num_elements(), std::plus<>());
      TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(hybrid_weight.origin()), hybrid_weight.num_elements(),
                                          std::plus<>());
    }
    AFQMCTimer.stop(assemble_X_timer);
    // Store sqrtdt*X in wset if back propagating
    int bp_step = wset.getBPPos(), bp_max = wset.NumBackProp();
    if (bp_step >= 0 && bp_step < bp_max)
    {
      for (int ni = 0; ni < nsteps; ni++)
      {
        if (bp_step < bp_max)
        {
          auto&& V = *wset.getFields(bp_step);
	  if(nsteps==1) {
	    copy_n_cast(ma::pointer_dispatch(X[cv0].origin()), nwalk*(cvN-cv0), V[cv0].origin());
	  } else {
            APP_ABORT(" Error: fix ");		
          //  V.sliced(cv0, cvN) = X({cv0, cvN}, {ni * nwalk, (ni + 1) * nwalk});
	  }
          ma::scal(typename WlkSet::bp_element(typename WlkSet::bp_element_value_type(sqrtdt)), V.sliced(cv0, cvN));
          bp_step++;
        }
      }
      TG.TG_local().barrier();
    }
    //std::cout<<" X: " <<ma::sum(X) <<std::endl;

    // 4. Calculate vHS(M*M,nsteps,nwalk)/vHS(nsteps,nwalk,M*M)
    AFQMCTimer.start(vHS_timer);
    if constexpr (SP) {
      // is this clever or dirsty? seems to work well and saves memory!
      SPCMatrix_ref vsp(reinterpret_pointer_cast<SPComplexType>(make_device_ptr(vHS.origin())), vhs_ext);
      wfn.vHS(X, vsp, dt);
      TG.TG_local().barrier();
      if (TG.TG_local().root())
        inplace_cast<SPComplexType, ComplexType>(vsp.origin(), vsp.num_elements());
      TG.TG_local().barrier();
    } else {
      wfn.vHS(X, vHS, dt);
    }
    AFQMCTimer.stop(vHS_timer);
    //std::cout<<" Pg vHS: " <<TG.Global().rank() <<" " <<ma::sum(vHS) <<"" <<std::endl;
  }

  C4Tensor_ref vHS4D(make_device_ptr(vHS.origin()), vhs4d_ext);

  int nx = 1;
  if (walker_type == COLLINEAR)
    nx = 2;

  // from now on, individual work on each walker/step
  const int ntasks_per_core     = int(nx * nwalk) / TG.getNCoresPerTG();
  const int ntasks_total_serial = ntasks_per_core * TG.getNCoresPerTG();
  const int nextra              = int(nx * nwalk) - ntasks_total_serial;

  // each processor does ntasks_percore_serial overlaps serially
  const int tk0 = TG.getLocalTGRank() * ntasks_per_core;
  const int tkN = (TG.getLocalTGRank() + 1) * ntasks_per_core;

  // make new communicator if nextra changed from last setting
  reset_nextra(nextra);

  for (int ni = 0; ni < nsteps_; ni++)
  {
    // 5. Propagate walkers
    AFQMCTimer.start(propagate_timer);
    //std::cout<<" before propg wfn " <<std::endl; //: "
    //std::cout<<ma::sum(*wset[0].SlaterMatrix(Alpha)) <<" " <<ma::sum(*wset[0].SlaterMatrix(Beta)) <<std::endl;
    if (nbatched_propagation != 0)
    {
      apply_propagators_batched('N', wset.getWalkerType(), ni, wset.SlaterMatrices(Alpha), 
            wset.SlaterMatrices((wset.getWalkerType()==COLLINEAR?Beta:Alpha)), vHS4D);
    }
    else
    {
      apply_propagators('N', wset, ni, tk0, tkN, ntasks_total_serial, vHS4D);
    }
    AFQMCTimer.stop(propagate_timer);
    //std::cout<<" propg wfn " <<std::endl; //: "
    //std::cout<<ma::sum(*wset[0].SlaterMatrix(Alpha)) <<" " <<ma::sum(*wset[0].SlaterMatrix(Beta)) <<std::endl;

    // 6. Calculate local energy/overlap
    AFQMCTimer.start(pseudo_energy_timer);
    if (hybrid)
    {
      wfn.Overlap(wset, new_overlaps);
    }
    else
    {
      wfn.Energy(wset, new_energies, new_overlaps);
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(pseudo_energy_timer);
    //std::cout<<" pseudo energy " <<ma::sum(new_overlaps) <<std::endl;

    // 7. update weights/energy/etc, apply constrains/bounds/etc
    AFQMCTimer.start(extra_timer);
    if (TG.TG_local().root())
    {
      if (free_projection)
      {
        free_projection_walker_update(wset, dt, new_overlaps, MFfactor[ni], Eshift, hybrid_weight[ni], work,debug_verbosity);
      }
      else if (hybrid)
      {
        hybrid_walker_update(wset, dt, apply_constrain, importance_sampling, Eshift, new_overlaps, MFfactor[ni],
                             hybrid_weight[ni], work, lower_cutoff_scale, upper_cutoff_scale, true, debug_verbosity);
      }
      else
      {
        local_energy_walker_update(wset, dt, apply_constrain, Eshift, new_overlaps, new_energies, MFfactor[ni],
                                   hybrid_weight[ni], work, lower_cutoff_scale, upper_cutoff_scale);
      }
      if (wset.getBPPos() >= 0 && wset.getBPPos() < wset.NumBackProp())
        wset.advanceBPPos();
      // MAM: BP will not work if the nsteps*nsubsteps per block is not consistent with
      //      steps in BP
      if (wset.getBPPos() >= 0)
        wset.advanceHistoryPos();
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(extra_timer);
    //std::cout<<" update: " <<ma::sum(hybrid_weight)  <<" " <<ma::sum(MFfactor) <<std::endl <<std::endl;
  }
}


/*
 * This routine assumes that the 1 body propagator does not need updating
 */
template<bool SP>
template<class WlkSet, class CTens, class CMat>
void AFQMCBasePropagator<SP>::BackPropagate(int nbpsteps, int nStabalize, WlkSet& wset, CTens&& Refs, CMat&& logdetR)
{
  using std::copy_n;
  auto walker_type = wset.getWalkerType();
  int npol         = (walker_type == NONCOLLINEAR) ? 2 : 1;
  int nspin        = (walker_type == COLLINEAR) ? 2 : 1;
  int nwalk        = wset.size();
  int globalnCV    = wfn.global_number_of_cholesky_vectors();

  auto vhs_ext   = iextensions<2u>{nspins_in_vHS * NMO * NMO, nwalk};
  auto vhs4d_ext = iextensions<4u>{nspins_in_vHS, NMO, NMO, nwalk};
  if (transposed_vHS_)
  {
    vhs_ext   = iextensions<2u>{nspins_in_vHS * nwalk, NMO * NMO};
    vhs4d_ext = iextensions<4u>{nspins_in_vHS, nwalk, NMO, NMO};
  }

  StaticMatrix vHS(vhs_ext, ComplexType(0.0),
		   buffer_manager.get_generator().template get_allocator<ComplexType>());
  StaticSPMatrix X({long(globalnCV), long(nwalk)}, SPComplexType(0.0),
                   buffer_manager.get_generator().template get_allocator<SPComplexType>());
  C4Tensor_ref vHS4D(make_device_ptr(vHS.origin()), vhs4d_ext);

  auto&& Fields = *wset.getFields();
  RUNTIME_CHECK(Fields.size(0) >= nbpsteps, "");
  RUNTIME_CHECK(Fields.size(1) == globalnCV, "");
  RUNTIME_CHECK(Fields.size(2) == nwalk, "");

  int nrow(NMO * npol);
  int ncol(NAEA + ((walker_type == CLOSED) ? 0 : NAEB));
  RUNTIME_CHECK(Refs.size(0) == nwalk, "");
  int nrefs = Refs.size(1);
  RUNTIME_CHECK(Refs.size(2) == nrow * ncol, "");

  int cv0, cvN;
  std::tie(cv0, cvN) = FairDivideBoundary(TG.getLocalTGRank(), globalnCV, TG.getNCoresPerTG());
  int r0, rN;
  std::tie(r0, rN) = FairDivideBoundary(TG.getLocalTGRank(), nrow * ncol, TG.getNCoresPerTG());

  int nx = 1;
  if (walker_type == COLLINEAR)
    nx = 2;

  RUNTIME_CHECK(logdetR.size(0) == nwalk, "");
  RUNTIME_CHECK(logdetR.size(1) == nrefs * nx, "");
  ma::fill(logdetR, ComplexType(0.0, 0.0));

  // from now on, individual work on each walker/step
  const int ntasks_per_core     = int(nx * nwalk) / TG.getNCoresPerTG();
  const int ntasks_total_serial = ntasks_per_core * TG.getNCoresPerTG();
  const int nextra              = int(nx * nwalk) - ntasks_total_serial;

  // each processor does ntasks_percore_serial overlaps serially
  const int tk0 = TG.getLocalTGRank() * ntasks_per_core;
  const int tkN = (TG.getLocalTGRank() + 1) * ntasks_per_core;

  // make new communicator if nextra changed from last setting
  reset_nextra(nextra);

  // to avoid having to modify the existing routines,
  // I'm storing the walkers SlaterMatrix on SlaterMatrixAux
  // and copying the back propagated references into SlaterMatrix
  // 0. copy SlaterMatrix to SlaterMatrixAux
  for (int i = 0; i < nwalk; i++)
  {
    copy_n((*wset[i].SlaterMatrix(Alpha)).origin() + r0, rN - r0, (*wset[i].SlaterMatrixAux(Alpha)).origin() + r0);
    // optimize for the single reference case
    if (nrefs == 1)
      copy_n(Refs[i][0].origin() + r0, rN - r0, make_device_ptr((*wset[i].SlaterMatrix(Alpha)).origin()) + r0);
  }
  TG.TG_local().barrier();

  for (int ni = nbpsteps - 1; ni >= 0; --ni)
  {
    // 1. Get X(nCV,nwalk) from wset
    copy_n_cast(Fields[ni][cv0].origin(), nwalk * (cvN - cv0), make_device_ptr(X[cv0].origin()));
    TG.TG_local().barrier();

    // 2. Calculate vHS(M*M,nwalk)/vHS(nwalk,M*M)
    //  X has been scaled by sqrtdt to avoid needing it here
    // MAM: This works (set dt=1.0) because only continuous HST are 
    // allowed with this propagator
    // X has been scaled by sqrtdt to avoid needing it here
    if constexpr (SP) {
      // is this clever or dirsty? seems to work well and saves memory!
      SPCMatrix_ref vsp(reinterpret_pointer_cast<SPComplexType>(make_device_ptr(vHS.origin())), vhs_ext);
      wfn.vHS(X, vsp, 1.0);
      TG.TG_local().barrier();
      if (TG.TG_local().root())
        inplace_cast<SPComplexType, ComplexType>(vsp.origin(), vsp.num_elements());
      TG.TG_local().barrier();
    } else {
      wfn.vHS(X, vHS, 1.0);
    }
    //std::cout<<" BP vHS: " <<TG.Global().rank() <<" " <<ma::sum(vHS) <<"" <<std::endl;

    for (int nr = 0; nr < nrefs; ++nr)
    {
      // 3. copy reference to SlaterMatrix
      if (nrefs > 1)
        for (int i = 0; i < nwalk; i++)
          copy_n(Refs[i][nr].origin() + r0, rN - r0, make_device_ptr((*wset[i].SlaterMatrix(Alpha)).origin()) + r0);
      TG.TG_local().barrier();

      // 4. Propagate walkers
      if (nbatched_propagation != 0)
        apply_propagators_batched('H', wset.getWalkerType(), 0, wset.SlaterMatrices(Alpha), 
            wset.SlaterMatrices((wset.getWalkerType()==COLLINEAR?Beta:Alpha)), vHS4D);
      else
        apply_propagators('H', wset, 0, tk0, tkN, ntasks_total_serial, vHS4D);
      TG.TG_local().barrier();

      // always end (n==0) with an orthogonalization
      if (ni == 0 || ni % nStabalize == 0)
        Orthogonalize_impl(wset, logdetR(logdetR.extension(0), {nspin * nr, nspin * nr + nspin}));
      TG.TG_local().barrier();

      // 5. copy reference to back
      if (nrefs > 1)
        for (int i = 0; i < nwalk; i++)
          copy_n(make_device_ptr((*wset[i].SlaterMatrix(Alpha)).origin()) + r0, rN - r0, Refs[i][nr].origin() + r0);
      TG.TG_local().barrier();
    }
  }

  // 6. restore the Slater Matrix
  for (int i = 0; i < nwalk; i++)
  {
    if (nrefs == 1)
      copy_n((*wset[i].SlaterMatrix(Alpha)).origin() + r0, rN - r0, Refs[i][0].origin() + r0);
    copy_n((*wset[i].SlaterMatrixAux(Alpha)).origin() + r0, rN - r0, (*wset[i].SlaterMatrix(Alpha)).origin() + r0);
  }
  TG.TG_local().barrier();
}

/*
 * Propagate "operator states" forward in time using stored fields.
 */
template<bool SP>
template<class WlkSet, class Mat1, class Mat2, class Mat3>
void AFQMCBasePropagator<SP>::PropagateOperators(int nsteps, WlkSet& wset, Mat1&& X, Mat2&& Y, Mat3&& M)
{ 
  static_assert(std::decay_t<Mat1>::dimensionality == 4, " dimensionality == 4");
  static_assert(std::decay_t<Mat2>::dimensionality == 4, " dimensionality == 4");
  static_assert(std::decay_t<Mat3>::dimensionality == 4, " dimensionality == 4");
  if(TG.TG_local().size() > 1)
    APP_ABORT("Error: ncore>1 not yet available. ");
  using std::copy_n;
  auto walker_type = wset.getWalkerType();
  int npol         = (walker_type == NONCOLLINEAR) ? 2 : 1;
  int nspin        = (walker_type == COLLINEAR) ? 2 : 1;
  int nwalk        = wset.size();
  int globalnCV    = wfn.global_number_of_cholesky_vectors();

  auto vhs_ext   = iextensions<2u>{nspins_in_vHS * NMO * NMO, nwalk};
  auto vhs4d_ext = iextensions<4u>{nspins_in_vHS, NMO, NMO, nwalk};
  if (transposed_vHS_)
  {
    vhs_ext   = iextensions<2u>{nspins_in_vHS * nwalk, NMO * NMO};
    vhs4d_ext = iextensions<4u>{nspins_in_vHS, nwalk, NMO, NMO};
  }

  auto&& Fields = *wset.getFields();
  RUNTIME_CHECK(Fields.size(0) >= nsteps, "");
  RUNTIME_CHECK(Fields.size(1) == globalnCV, "");
  RUNTIME_CHECK(Fields.size(2) == nwalk, "");

  int cv0, cvN;
  std::tie(cv0, cvN) = FairDivideBoundary(TG.getLocalTGRank(), globalnCV, TG.getNCoresPerTG());
  int w0, wN;
  std::tie(w0, wN) = FairDivideBoundary(TG.getLocalTGRank(), nwalk, TG.getNCoresPerTG());

  auto Xup = X.rotated()[0].unrotated();
  auto Xdn = X.rotated()[nspin-1].unrotated();
  auto Yup = Y.rotated()[0].unrotated();
  auto Ydn = Y.rotated()[nspin-1].unrotated();

  // generate P1x_inv if not yet constructed
  // NOTE: if time step changes after this point, 
  // it will be updated with the regular propagator, so only need to create it once here
  if(P1s_inv[0].capacity()==0)
    generateP1(old_dt, walker_type, true);
  

  { // controlling scope to keep buffer usage down

    StaticMatrix vHS(vhs_ext, ComplexType(0.0),
		     buffer_manager.get_generator().template get_allocator<ComplexType>());
    StaticSPMatrix Xfield({long(globalnCV), long(nwalk)}, SPComplexType(0.0),
                   buffer_manager.get_generator().template get_allocator<SPComplexType>());
    C4Tensor_ref vHS4D(make_device_ptr(vHS.origin()), vhs4d_ext);


    for (int ni = 0; ni <nsteps; ++ni)
    {
      // 1. Get X(nCV,nwalk) from wset
      copy_n_cast(Fields[ni][cv0].origin(), nwalk * (cvN - cv0), make_device_ptr(Xfield[cv0].origin()));
      TG.TG_local().barrier();

      // 2. Calculate vHS(M*M,nwalk)/vHS(nwalk,M*M)
      //  X has been scaled by sqrtdt to avoid needing it here
      // MAM: This works (set dt=1.0) because only continuous HST are 
      // allowed with this propagator
      if constexpr (SP) {
        // is this clever or dirsty? seems to work well and saves memory!
        SPCMatrix_ref vsp(reinterpret_pointer_cast<SPComplexType>(make_device_ptr(vHS.origin())), vhs_ext);
        wfn.vHS(Xfield, vsp, 1.0);
        TG.TG_local().barrier();
        if (TG.TG_local().root())
          inplace_cast<SPComplexType, ComplexType>(vsp.origin(), vsp.num_elements());
        TG.TG_local().barrier();
      } else {
        wfn.vHS(Xfield, vHS, 1.0);
      }
      //std::cout<<" BP vHS: " <<TG.Global().rank() <<" " <<ma::sum(vHS) <<"" <<std::endl;

      // 3. Propagate Matrices 
      apply_propagators_batched('N', wset.getWalkerType(), 0, Xup, Xdn, vHS4D );
      // scale vHS by -1, since we need ma::H( B^(-1) )
      ma::scal(ComplexType(-1.0), vHS4D.flatted().flatted()); 
      apply_propagators_batched('H', wset.getWalkerType(), 0, Yup, Ydn, vHS4D, true );
      TG.TG_local().barrier();
    }

  }

  // 4.Regularize states using the current walker's Slater Matrix (which should be orthonormal)
  // Ynew = S * H(S) * Y
  // M += H(Ynew) * X
  // Xnew = X - S * H(S) * X  
  // where S is the walker's Slater Matrix. 
  Static3Tensor SY({nwalk, NAEA, npol*NMO}, ComplexType(0.0),
                buffer_manager.get_generator().template get_allocator<ComplexType>());
  SpinTypes stype[2] = {Alpha, Beta};
  int nel[2] = {NAEA, NAEB};
  for(int ispin=0; ispin<nspin; ispin++) {
    
    // SY = H(S) * Y
    ma::productStridedBatched( ma::H(wset.SlaterMatrices(stype[ispin])),  
                               Y.rotated()[ispin].unrotated(), 
                               SY.rotated().sliced(0, nel[ispin]).unrotated() ); 

    // Ynew = S * SY
    ma::productStridedBatched( wset.SlaterMatrices(stype[ispin]),   
                               SY.rotated().sliced(0, nel[ispin]).unrotated(), 
                               Y.rotated()[ispin].unrotated());

    // M += H(Ynew) * X
    ma::productStridedBatched( ComplexType(1.0), 
                               ma::H(Y.rotated()[ispin].unrotated()), 
                               X.rotated()[ispin].unrotated(),
                               ComplexType(1.0),
                               M.rotated()[ispin].unrotated()); 

    // SY = H(S) * X
    ma::productStridedBatched( ma::H(wset.SlaterMatrices(stype[ispin])),   
                               X.rotated()[ispin].unrotated(),
                               SY.rotated().sliced(0, nel[ispin]).unrotated() ); 

    // Xnew = X - S * SY
    ma::productStridedBatched( ComplexType(-1.0),
                               wset.SlaterMatrices(stype[ispin]),
                               SY.rotated().sliced(0, nel[ispin]).unrotated(),  
                               ComplexType(1.0), 
                               X.rotated()[ispin].unrotated());

  }
  TG.TG_local().barrier();
}

template<bool SP>
template<class WSet>
void AFQMCBasePropagator<SP>::apply_propagators(char TA,
                                            WSet& wset,
                                            int ni,
                                            int tk0,
                                            int tkN,
                                            int ntasks_total_serial,
                                            C4Tensor_ref& vHS4D)
{
  int nwalk        = wset.size();
  auto walker_type = wset.getWalkerType();
  bool noncol      = (walker_type == NONCOLLINEAR);
  int is0 = ( nspins_in_vHS>1 ? 1 : 0 );  // index of beta spin

  if (transposed_vHS_)
  {
    // vHS4D[s][nstep*nwalk][M][M]
    if( (walker_type == CLOSED) or 
        (walker_type == FULLYPOLARIZED) or
        ((walker_type == NONCOLLINEAR) and (nspins_in_vHS==1)) ) 
    {   
      // in this case, tk corresponds to walker number
      for (int tk = tk0; tk < tkN; ++tk)
      {
        int nt = ni * nwalk + tk;
        SDetOp->Propagate(*wset[tk].SlaterMatrix(Alpha), P1s[0], vHS4D[0][nt], order, TA, noncol);
      }
      if (last_nextra > 0)
      {
        int iw = ntasks_total_serial + last_task_index;
        int nt = ni * nwalk + iw;
        SDetOp->Propagate(*wset[iw].SlaterMatrix(Alpha), P1s[0], vHS4D[0][nt], local_group_comm, order, TA, noncol);
      }
    } 
    else if (walker_type == COLLINEAR)   
    {
      // in this case, tk corresponds to 2x the walker number
      for (int tk = tk0; tk < tkN; ++tk)
      {
        int nt = ni * nwalk + tk / 2;
        if (tk % 2 == 0)
          SDetOp->Propagate(*wset[tk / 2].SlaterMatrix(Alpha), P1s[0], vHS4D[0][nt], order, TA);
        else
          SDetOp->Propagate(*wset[tk / 2].SlaterMatrix(Beta), P1s[1], vHS4D[is0][nt], order, TA);
      }
      if (last_nextra > 0)
      {
        int tk = (ntasks_total_serial + last_task_index);
        int nt = ni * nwalk + tk / 2;
        if (tk % 2 == 0)
          SDetOp->Propagate(*wset[tk / 2].SlaterMatrix(Alpha), P1s[0], vHS4D[is0][nt], local_group_comm, order, TA);
        else
          SDetOp->Propagate(*wset[tk / 2].SlaterMatrix(Beta), P1s[1], vHS4D[is0][nt], local_group_comm, order, TA);
      }
    } 
    else 
    { // NONCOLLINEAR with nspins_in_vHS>1
      // in this case, tk corresponds to walker number
      for (int tk = tk0; tk < tkN; ++tk)
      {
        int nt = ni * nwalk + tk;
        SDetOp->Propagate(*wset[tk].SlaterMatrix(Alpha), P1s[0], vHS4D[0][nt], vHS4D[1][nt], order, TA);
      }
      if (last_nextra > 0)
      {
        int iw = ntasks_total_serial + last_task_index;
        int nt = ni * nwalk + iw;
        SDetOp->Propagate(*wset[iw].SlaterMatrix(Alpha), P1s[0], vHS4D[0][nt], vHS4D[1][nt], local_group_comm, order, TA);
      }
    }
  }
  else
  {
    if (local_vHS.size(0) != NMO || local_vHS.size(1) != NMO)
      local_vHS = CMatrix({NMO, NMO});
    // vHS4D[s][M][M][nstep*nwalk]: need temporary buffer in this case
    if( (walker_type == CLOSED) or
        (walker_type == FULLYPOLARIZED) or
        ((walker_type == NONCOLLINEAR) and (nspins_in_vHS==1)) )
    {
      // in this case, tk corresponds to walker number
      for (int tk = tk0; tk < tkN; ++tk)
      {
        int nt    = ni * nwalk + tk;
        local_vHS = vHS4D(0, local_vHS.extension(0), local_vHS.extension(1), nt);
        //std::cout<<" pp: " <<tk <<" " <<ma::sum(local_vHS) <<"" <<std::endl;
        SDetOp->Propagate(*wset[tk].SlaterMatrix(Alpha), P1s[0], local_vHS, order, TA, noncol);
      }
      if (last_nextra > 0)
      {
        int iw    = ntasks_total_serial + last_task_index;
        int nt    = ni * nwalk + iw;
        local_vHS = vHS4D(0, local_vHS.extension(0), local_vHS.extension(1), nt);
        SDetOp->Propagate(*wset[iw].SlaterMatrix(Alpha), P1s[0], local_vHS, local_group_comm, order, TA, noncol);
      }
    }
    else if (walker_type == COLLINEAR)
    {
      // in this case, tk corresponds to 2x the walker number
      for (int tk = tk0; tk < tkN; ++tk)
      {
        int nt = ni * nwalk + tk / 2;
        if (tk % 2 == 0) {
          local_vHS = vHS4D(0, local_vHS.extension(0), local_vHS.extension(1), nt);
          SDetOp->Propagate(*wset[tk / 2].SlaterMatrix(Alpha), P1s[0], local_vHS, order, TA);
        } else {
          local_vHS = vHS4D(is0, local_vHS.extension(0), local_vHS.extension(1), nt);
          SDetOp->Propagate(*wset[tk / 2].SlaterMatrix(Beta), P1s[1], local_vHS, order, TA);
        }
      }
      if (last_nextra > 0)
      {
        int tk    = (ntasks_total_serial + last_task_index);
        int nt    = ni * nwalk + tk / 2;
        if (tk % 2 == 0) {
          local_vHS = vHS4D(0, local_vHS.extension(0), local_vHS.extension(1), nt);
          SDetOp->Propagate(*wset[tk / 2].SlaterMatrix(Alpha), P1s[0], local_vHS, local_group_comm, order, TA);
        } else {
          local_vHS = vHS4D(is0, local_vHS.extension(0), local_vHS.extension(1), nt);
          SDetOp->Propagate(*wset[tk / 2].SlaterMatrix(Beta), P1s[1], local_vHS, local_group_comm, order, TA);
        }
      }
    }
    else
    {
      if (local_vHS2.size(0) != NMO || local_vHS2.size(1) != NMO)
        local_vHS2 = CMatrix({NMO, NMO});
      // NONCOLLINEAR wirh nspin_in_vHS = 2
      // in this case, tk corresponds to walker number
      for (int tk = tk0; tk < tkN; ++tk)
      {
        int nt    = ni * nwalk + tk;
        local_vHS = vHS4D(0, local_vHS.extension(0), local_vHS.extension(1), nt);
        local_vHS2 = vHS4D(1, local_vHS2.extension(0), local_vHS2.extension(1), nt);
        //std::cout<<" pp: " <<tk <<" " <<ma::sum(local_vHS) <<"" <<std::endl;
        SDetOp->Propagate(*wset[tk].SlaterMatrix(Alpha), P1s[0], local_vHS, local_vHS2, order, TA);
      }
      if (last_nextra > 0)
      {
        int iw    = ntasks_total_serial + last_task_index;
        int nt    = ni * nwalk + iw;
        local_vHS = vHS4D(0, local_vHS.extension(0), local_vHS.extension(1), nt);
        local_vHS2 = vHS4D(1, local_vHS2.extension(0), local_vHS2.extension(1), nt);
        SDetOp->Propagate(*wset[iw].SlaterMatrix(Alpha), P1s[0], local_vHS, local_vHS2, local_group_comm, order, TA);
      }
    }
  }
  TG.TG_local().barrier();
}

template<bool SP>
template<class Mat1, class Mat2>
void AFQMCBasePropagator<SP>::apply_propagators_batched_impl(char TA, WALKER_TYPES walker_type, int ni, 
            Mat1&& P1up, Mat1&& P1dn, Mat2&& SMup, Mat2&& SMdn, C4Tensor_ref& vHS4D)
{
  static_assert(std::decay_t<Mat2>::dimensionality == 3, " dimensionality == 3");
  int nwalk        = SMup.size(0);  
  int nbatch       = std::min(nwalk, (nbatched_propagation < 0 ? nwalk : nbatched_propagation));
  int nt = ni * nwalk;
  int is0 = ( nspins_in_vHS>1 ? 1 : 0 );  // index of beta spin

  if (transposed_vHS_)
  {
    // vHS4D[0][nstep*nwalk][M][M]
    if(walker_type == CLOSED) {
      for (int iw = 0; iw < nwalk; iw += nbatch, nt += nbatch)
      { 
        int nb = std::min(nbatch, nwalk - iw);
        SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1up, 
         vHS4D[0].sliced(nt, nt + nb), order, TA);
      }
    } else if(walker_type == COLLINEAR) {
      RUNTIME_CHECK(SMup.size(0) == SMdn.size(0), "");
      for (int iw = 0; iw < nwalk; iw += nbatch, nt += nbatch)
      {
        int nb = std::min(nbatch, nwalk - iw);
        SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1up,
            vHS4D[0].sliced(nt, nt + nb), order, TA);
        SDetOp->BatchedPropagate(SMdn.sliced(iw,iw+nb), P1dn, 
            vHS4D[is0].sliced(nt, nt + nb), order, TA);
      }
    } else if(walker_type == NONCOLLINEAR) {
      for (int iw = 0; iw < nwalk; iw += nbatch, nt += nbatch)
      {
        int nb = std::min(nbatch, nwalk - iw);
        SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1up,
           vHS4D[0].sliced(nt, nt + nb), vHS4D[is0].sliced(nt, nt + nb), order, TA);
      }
    } else if(walker_type == FULLYPOLARIZED) {
      for (int iw = 0; iw < nwalk; iw += nbatch, nt += nbatch)
      { 
        int nb = std::min(nbatch, nwalk - iw);
        SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1up, 
         vHS4D[0].sliced(nt, nt + nb), order, TA);
      }
    }
  }
  else
  {
    if(nspins_in_vHS > 1) { 
      // vHS4D[s][M][M][nstep*nwalk]: need temporary buffer in this case
      RUNTIME_CHECK((walker_type == COLLINEAR) or (walker_type == NONCOLLINEAR), ""); 
      int N2 = vHS4D.size(1) * vHS4D.size(2);
      CMatrix_ref vHS2D_up(vHS4D[0].origin(), {N2, vHS4D.size(3)});
      CMatrix_ref vHS2D_dn(vHS4D[1].origin(), {N2, vHS4D.size(3)});
      Static3Tensor vbuff({2, nbatch, N2}, ComplexType(0.0),
          buffer_manager.get_generator().template get_allocator<ComplexType>());
      auto vup = vbuff[0].rotated().partitioned(NMO).unrotated();
      auto vdn = vbuff[1].rotated().partitioned(NMO).unrotated();
  
      for (int iw = 0; iw < nwalk; iw += nbatch, nt += nbatch)
      {
        int nb = std::min(nbatch, nwalk - iw);
        ma::transpose(vHS2D_up(vHS2D_up.extension(0), {nt, nt + nb}), vbuff[0].sliced(0,nb));
        ma::transpose(vHS2D_dn(vHS2D_dn.extension(0), {nt, nt + nb}), vbuff[1].sliced(0,nb));
        if(walker_type == COLLINEAR) {
          RUNTIME_CHECK(SMup.size(0) == SMdn.size(0), "");
          SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1up,
                vup.sliced(0,nb), order, TA);
          SDetOp->BatchedPropagate(SMdn.sliced(iw,iw+nb), P1dn,
                vdn.sliced(0,nb), order, TA);
        } else if(walker_type == NONCOLLINEAR) {
          SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1up,
                vup.sliced(0,nb), vdn.sliced(0,nb), order, TA);
        }
      }
    } else {
      // vHS4D[s][M][M][nstep*nwalk]: need temporary buffer in this case
      auto vHS2D = vHS4D[0].flatted(); 
      StaticMatrix vbuff({nbatch, vHS2D.size(0)}, ComplexType(0.0),
          buffer_manager.get_generator().template get_allocator<ComplexType>());
      auto v = vbuff.rotated().partitioned(NMO).unrotated();

      for (int iw = 0; iw < nwalk; iw += nbatch, nt += nbatch)
      {
        int nb = std::min(nbatch, nwalk - iw);
        ma::transpose(vHS2D(vHS2D.extension(0), {nt, nt + nb}), vbuff.sliced(0,nb));
        if(walker_type == CLOSED) {
          SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1up,
                v.sliced(0,nb), order, TA);
        } else if(walker_type == COLLINEAR) {
          RUNTIME_CHECK(SMup.size(0) == SMdn.size(0), "");
          SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1up,
                v.sliced(0,nb), order, TA);
          SDetOp->BatchedPropagate(SMdn.sliced(iw,iw+nb), P1dn,
                v.sliced(0,nb), order, TA);
        } else if(walker_type == NONCOLLINEAR) {
          SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1up,
                v.sliced(0,nb), v.sliced(0,nb), order, TA);
        } else if(walker_type == FULLYPOLARIZED) {
          SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1up,
                v.sliced(0,nb), order, TA);
        }
      }
    }
  }
}

/*
   * Orthogonalizes the Slater matrices of all walkers in the set.  
   *  - logdetR: Array where the logarithm of det(R) will be accumulated.
   */
template<bool SP>
template<class WlkSet, class CMat>
void AFQMCBasePropagator<SP>::Orthogonalize_impl(WlkSet& wset, CMat&& logdetR) 
{
  auto walker_type = wset.getWalkerType();
  const int nspin = ( (walker_type == COLLINEAR) ? 2 : 1 );
  int nw_tot = wset.size();
  RUNTIME_CHECK(logdetR.size(0) == nw_tot, "");
  double LogOverlapFactor(wset.getLogOverlapFactor());
  int w0, w1;
  std::tie(w0, w1) = FairDivideBoundary(TG.getLocalTGRank(), nw_tot, TG.getNCoresPerTG());
  int nbatch__ = std::min(w1-w0, (nbatched_qr <= 0 ? w1-w0 : nbatched_qr));
  StaticArray<ComplexType, 2, dev_stack_alloc_type> logdetR_({nspin, nbatch__}, ComplexType(0.0),
                device_buffer_manager.get_generator().template get_allocator<ComplexType>());
  if (walker_type != COLLINEAR)
  {
    RUNTIME_CHECK(logdetR.size(1) == 1, "");
    auto SM = wset.SlaterMatrices(Alpha);
    for (int iw = w0; iw < w1; iw += nbatch__)
    {
      int nb = std::min(nbatch__, w1 - iw);
      SDetOp->BatchedOrthogonalize(SM.sliced(iw,iw+nb), LogOverlapFactor, logdetR_.origin());
      ma::add(ComplexType(1.0), ma::T(logdetR_.rotated().sliced(0,nb).unrotated()), 
              ComplexType(1.0), logdetR.sliced(iw,iw+nb), logdetR.sliced(iw,iw+nb));  
    }
  }
  else
  {
    RUNTIME_CHECK(logdetR.size(1) == 2, "");
    auto SMup = wset.SlaterMatrices(Alpha);
    auto SMdn = wset.SlaterMatrices(Beta);
    for (int iw = w0; iw < w1; iw += nbatch__)
    {
      int nb = std::min(nbatch__, w1 - iw);
      // Alpha
      SDetOp->BatchedOrthogonalize(SMup.sliced(iw,iw+nb), LogOverlapFactor, logdetR_[0].origin()); 
      // Beta
      SDetOp->BatchedOrthogonalize(SMdn.sliced(iw,iw+nb), LogOverlapFactor, logdetR_[1].origin()); 
      ma::add(ComplexType(1.0), ma::T(logdetR_.rotated().sliced(0,nb).unrotated()), 
              ComplexType(1.0), logdetR.sliced(iw,iw+nb), logdetR.sliced(iw,iw+nb));  
    }
  }
  TG.TG_local().barrier();
}

/*
 * Walker orthogonalization for cases where det(R) is not needed. 
 */
template<bool SP>
template<class WlkSet>
void AFQMCBasePropagator<SP>::Orthogonalize_impl(WlkSet& wset)
{ 
  auto walker_type = wset.getWalkerType();
  int nw_tot = wset.size(); 
  double LogOverlapFactor(wset.getLogOverlapFactor());
  int w0, w1;
  std::tie(w0, w1) = FairDivideBoundary(TG.getLocalTGRank(), nw_tot, TG.getNCoresPerTG());
  int nbatch__ = std::min(w1-w0, (nbatched_qr <= 0 ? w1-w0 : nbatched_qr));
  if (walker_type != COLLINEAR)
  { 
    auto SM = wset.SlaterMatrices(Alpha);
    for (int iw = w0; iw < w1; iw += nbatch__)
    { 
      int nb = std::min(nbatch__, w1 - iw);
      SDetOp->BatchedOrthogonalize(SM.sliced(iw,iw+nb), LogOverlapFactor);
    }
  }
  else
  { 
    auto SMup = wset.SlaterMatrices(Alpha);
    auto SMdn = wset.SlaterMatrices(Beta);
    for (int iw = w0; iw < w1; iw += nbatch__)
    { 
      int nb = std::min(nbatch__, w1 - iw);
      // Alpha
      SDetOp->BatchedOrthogonalize(SMup.sliced(iw,iw+nb), LogOverlapFactor);
      // Beta
      SDetOp->BatchedOrthogonalize(SMdn.sliced(iw,iw+nb), LogOverlapFactor);
    }
  }
  TG.TG_local().barrier();
}

template<bool SP>
template<class WlkSet>
void AFQMCBasePropagator<SP>::Orthogonalize_excited_impl(WlkSet& wset)
{
  using devStaticTensor = StaticArray<ComplexType, 3, dev_stack_alloc_type>;
  auto walker_type = wset.getWalkerType();
  int nw_tot = wset.size();
  double LogOverlapFactor(wset.getLogOverlapFactor());
  int w0, w1;
  std::tie(w0, w1) = FairDivideBoundary(TG.getLocalTGRank(), nw_tot, TG.getNCoresPerTG());
  int nbatch__ = std::min(w1-w0, (nbatched_qr <= 0 ? w1-w0 : nbatched_qr));
  if (walker_type != COLLINEAR)
  {
    RUNTIME_CHECK(numExcitations.first > 0, ""); 
    int nexmax(maxOccupExtendedMat.first);
    auto SM = wset.SlaterMatrices(Alpha);
    for (int iw = w0; iw < w1; iw += nbatch__)
    {
      int nb = std::min(nbatch__, w1 - iw);
      devStaticTensor extA({nb, NMO, nexmax}, 
                device_buffer_manager.get_generator().template get_allocator<ComplexType>());
      ma::copy(SM.sliced(iw,iw+nb),extA({0,nb},{0,NMO},{0,NAEA}));
      ma::copy(excitedOrbMat[0]({0,NMO},{NAEA + 1, nexmax}), extA({0,nb},{0,NMO},{NAEA+1,nexmax}));   
      // move i->a, copy trial orb i
      // serializing for now, but will be slow!  
      for (auto& i : excitations)
        if (i.first < NMO && i.second < NMO)
        {
          for(int n=0; n<nb; n++) 
            ma::copy(extA[n]({0,NMO}, i.first), extA[n]({0,NMO}, i.second));
          for(int n=0; n<nb; n++) 
            ma::copy(excitedOrbMat[0]({0,NMO}, i.first), extA[n]({0,NMO}, i.first));
        }
      SDetOp->BatchedOrthogonalize(extA, LogOverlapFactor);
      ma::copy(extA({0,nb},{0,NMO},{0,NAEA}), SM.sliced(iw,iw+nb));
      for (auto& i : excitations)
        if (i.first < NMO && i.second < NMO) {
          for(int n=0; n<nb; n++) 
            ma::copy(extA[n]({0,NMO}, i.second), SM[iw+n]({0,NMO}, i.first));
        }
    }
  }
  else
  {
    auto SMup = wset.SlaterMatrices(Alpha);
    auto SMdn = wset.SlaterMatrices(Beta);
    // Alpha
    if(numExcitations.first == 0) 
    {
      for (int iw = w0; iw < w1; iw += nbatch__)
      {
        int nb = std::min(nbatch__, w1 - iw);
        SDetOp->BatchedOrthogonalize(SMup.sliced(iw,iw+nb), LogOverlapFactor);
      }
    } 
    else 
    {
      int nexmax(maxOccupExtendedMat.first);
      for (int iw = w0; iw < w1; iw += nbatch__)
      { 
        int nb = std::min(nbatch__, w1 - iw);
        devStaticTensor extA({nb, NMO, nexmax}, 
                device_buffer_manager.get_generator().template get_allocator<ComplexType>());
        ma::copy(SMup.sliced(iw,iw+nb),extA({0,nb},{0,NMO},{0,NAEA}));
        ma::copy(excitedOrbMat[0]({0,NMO},{NAEA + 1, nexmax}), extA({0,nb},{0,NMO},{NAEA+1,nexmax}));
        // move i->a, copy trial orb i
        // serializing for now, but will be slow!  
        for (auto& i : excitations)
          if (i.first < NMO && i.second < NMO)
          { 
            for(int n=0; n<nb; n++) 
              ma::copy(extA[n]({0,NMO}, i.first), extA[n]({0,NMO}, i.second));
            for(int n=0; n<nb; n++) 
              ma::copy(excitedOrbMat[0]({0,NMO}, i.first), extA[n]({0,NMO}, i.first));
          }
        SDetOp->BatchedOrthogonalize(extA, LogOverlapFactor);
        ma::copy(extA({0,nb},{0,NMO},{0,NAEA}), SMup.sliced(iw,iw+nb));
        for (auto& i : excitations)
          if (i.first < NMO && i.second < NMO) {
            for(int n=0; n<nb; n++) 
              ma::copy(extA[n]({0,NMO}, i.second), SMup[iw+n]({0,NMO}, i.first));
          }
      }
    }
    // Beta  
    if(numExcitations.first == 0) 
    {
      for (int iw = w0; iw < w1; iw += nbatch__)
      {
        int nb = std::min(nbatch__, w1 - iw);
        SDetOp->BatchedOrthogonalize(SMdn.sliced(iw,iw+nb), LogOverlapFactor);
      }
    } 
    else
    {
      int nexmax(maxOccupExtendedMat.second);
      for (int iw = w0; iw < w1; iw += nbatch__)
      {
        int nb = std::min(nbatch__, w1 - iw);
        devStaticTensor extA({nb, NMO, nexmax},
                device_buffer_manager.get_generator().template get_allocator<ComplexType>());
        ma::copy(SMdn.sliced(iw,iw+nb),extA({0,nb},{0,NMO},{0,NAEB}));
        ma::copy(excitedOrbMat[0]({0,NMO},{NAEB + 1, nexmax}), extA({0,nb},{0,NMO},{NAEB+1,nexmax}));
        // move i->a, copy trial orb i
        // serializing for now, but will be slow!  
        for (auto& i : excitations)
          if (i.first < NMO && i.second < NMO)
          {
            for(int n=0; n<nb; n++)
              ma::copy(extA[n]({0,NMO}, i.first), extA[n]({0,NMO}, i.second));
            for(int n=0; n<nb; n++)
              ma::copy(excitedOrbMat[1]({0,NMO}, i.first), extA[n]({0,NMO}, i.first));
          }
        SDetOp->BatchedOrthogonalize(extA, LogOverlapFactor);
        ma::copy(extA({0,nb},{0,NMO},{0,NAEB}), SMdn.sliced(iw,iw+nb));
        for (auto& i : excitations)
          if (i.first < NMO && i.second < NMO) {
            for(int n=0; n<nb; n++)
              ma::copy(extA[n]({0,NMO}, i.second), SMdn[iw+n]({0,NMO}, i.first));
          }
      }
    }
  }
  TG.TG_local().barrier();
}

template<bool SP>
template<class MatA, class MatB, class MatC, class MatD>
void AFQMCBasePropagator<SP>::assemble_X(size_t nsteps,
                                     size_t nwalk,
                                     RealType sqrtdt,
                                     MatA&& X,
                                     MatB&& vbias,
                                     MatC&& MF,
                                     MatD&& HWs,
                                     bool addRAND)
{
  using std::copy_n;
  using XType = typename std::decay<MatA>::type::element;
  // remember to call vbi = apply_bound_vbias(*vb);
  // X[m,ni,iw] = rand[m,ni,iw] + im * ( vbias[m,iw] - vMF[m]  )
  // HW[ni,iw] = sum_m [ im * ( vMF[m] - vbias[m,iw] ) *
  //                     ( rand[m,ni,iw] + halfim * ( vbias[m,iw] - vMF[m] ) ) ]
  //           = sum_m [ im * ( vMF[m] - vbias[m,iw] ) *
  //                     ( X[m,ni,iw] - halfim * ( vbias[m,iw] - vMF[m] ) ) ]
  // MF[ni,iw] = sum_m ( im * X[m,ni,iw] * vMF[m] )

  TG.TG_local().barrier();
  ComplexType im(0.0, 1.0);
  int nCV = int(X.size(0));
  // generate random numbers
  if (addRAND)
  {
    int i0, iN;
    if(nCV == rng_block_size) {
      std::tie(i0, iN) = FairDivideBoundary(TG.TG_local().rank(), int(X.num_elements()), TG.TG_local().size());
      utils::sampleGaussianFields_n(make_device_ptr(X.origin()) + i0, iN - i0, *rng);
    } else {
      std::tie(i0, iN) = FairDivideBoundary(TG.TG_local().rank(), rng_block_size, TG.TG_local().size());
      if(iN <= nCV) {
        utils::sampleGaussianFields_n(make_device_ptr(X[i0].origin()), (iN - i0)*X.size(1), *rng);
      } else if(i0 < nCV) {
	// throw some away 
        StaticSPVector R(iextensions<1u>{ (iN-i0)*X.size(1) }, 
                     buffer_manager.get_generator().template get_allocator<SPComplexType>());
        utils::sampleGaussianFields_n(make_device_ptr(R.origin()), R.size(0), *rng);
        copy_n(R.origin(), (nCV-i0)*X.size(1), X[i0].origin());
      } else {
	// throw all away 
        StaticSPVector R(iextensions<1u>{ (iN-i0)*X.size(1) }, 
                     buffer_manager.get_generator().template get_allocator<SPComplexType>());
        utils::sampleGaussianFields_n(make_device_ptr(R.origin()), R.size(0), *rng);
      }
    }
// allocate temporary buffer and all sampleUniform with throw away ones
  }

  // construct X
  ma::fill(HWs, ComplexType(0));
  ma::fill(MF, ComplexType(0));

// leaving compiler switch until I decide how to do this better
// basically hide this decision somewhere based on the value of pointer!!!
// TODO: Move this
#if defined(ENABLE_CUDA) || defined(ENABLE_HIP)
  kernels::construct_X(nCV, nsteps, nwalk, free_projection, sqrtdt, vbias_bound, raw_pointer_cast(vMF.origin()),
                       raw_pointer_cast(vbias.origin()), raw_pointer_cast(HWs.origin()), raw_pointer_cast(MF.origin()),
                       raw_pointer_cast(X.origin()));
#else
  boost::multi::array_ref<XType, 3> X3D(raw_pointer_cast(X.origin()), {long(X.size(0)), long(nsteps), long(nwalk)});
  int m0, mN;
  std::tie(m0, mN) = FairDivideBoundary(TG.TG_local().rank(), nCV, TG.TG_local().size());
  TG.TG_local().barrier();
  for (int m = m0; m < mN; ++m)
  {
    auto vb_ = raw_pointer_cast(vbias[m].origin());
    auto vmf_t = apply_bound_vbias(vMF[m], sqrtdt);
    auto vmf_ = vMF[m];
    // apply bounds to vbias
    for (int iw = 0; iw < nwalk; iw++)
      vb_[iw] = apply_bound_vbias(vb_[iw], sqrtdt);
    for (int ni = 0; ni < nsteps; ni++)
    {
      auto X_ = X3D[m][ni].origin();
      auto hws_ = raw_pointer_cast(HWs[ni].origin());
      auto mf_ = raw_pointer_cast(MF[ni].origin());
      for (int iw = 0; iw < nwalk; iw++)
      {
        // No force bias term when doing free projection.
        ComplexType vdiff =
            free_projection ? ComplexType(0.0, 0.0) : (im * (static_cast<ComplexType>(vb_[iw]) - vmf_t));
        X_[iw] += static_cast<XType>(vdiff);
        hws_[iw] -= vdiff * (static_cast<ComplexType>(X_[iw]) - 0.5 * vdiff);
        mf_[iw] += im * static_cast<ComplexType>(X_[iw]) * vmf_;
      }
    }
  }
  TG.TG_local().barrier();
#endif
}

template<bool SP>
template<class WlkSet>
void AFQMCBasePropagator<SP>::Orthogonalize(WlkSet& wset)
{
  if(excitedState)
  {
    if(not importance_sampling)
      APP_ABORT("Error: Excited state propagator only implemented with importance sampling. ");
    Orthogonalize_excited_impl(wset);
  }
  else if(importance_sampling)
  {
    Orthogonalize_impl(wset);
  }
  else
  {
    auto walker_type = wset.getWalkerType();
    int nwalk = wset.size();
    int nspin = ( (walker_type == COLLINEAR) ? 2 : 1 );
    StaticMatrix logdetR({nwalk, nspin}, ComplexType(0.0),
                 buffer_manager.get_generator().template get_allocator<ComplexType>());
    Vector<ComplexType> hostv(iextensions<1u>{nspin*nwalk});
    Vector<ComplexType> hostv2(iextensions<1u>{nwalk});
    // get old weights
    wset.getProperty(WEIGHT, logdetR.flatted().sliced(0,nwalk));
    copy_n(logdetR.origin(), nwalk, hostv2.data());
    // Orthogonalize and keep logdetR
    ma::fill(logdetR, ComplexType(0.0, 0.0));
    Orthogonalize_impl(wset, logdetR);
    // processing this on the host for now, make kernel if needed!
    copy_n(logdetR.origin(), nwalk*nspin, hostv.data());
    TG.TG_local().barrier();
    if (walker_type == CLOSED)
      for (int iw = 0; iw < nwalk; iw++)
        hostv2[iw] *= std::exp(hostv[iw]+hostv[iw]);
    else if (walker_type == COLLINEAR)
      for (int iw = 0; iw < nwalk; iw++)
        hostv2[iw] *= std::exp(hostv[iw] + hostv[iw + nwalk]);
    else if (walker_type == NONCOLLINEAR)
      for (int iw = 0; iw < nwalk; iw++)
        hostv2[iw] *= std::exp(hostv[iw]);
    else if (walker_type == FULLYPOLARIZED)
      for (int iw = 0; iw < nwalk; iw++)
        hostv2[iw] *= std::exp(hostv[iw]);
    copy_n(hostv.data(), nwalk, logdetR.origin());
    wset.setProperty(WEIGHT, logdetR.flatted().sliced(0,nwalk));
  }
  TG.TG_local().barrier();
  wfn.Overlap(wset);
}

