/*
 * Propagates the walker population nsteps forward with a fixed vbias (from the initial 
 * configuration).   
 * Uses dense propagation.
 */
template<bool SP>
template<class WlkSet>
void AFQMCModelPropagator<SP>::step_denseP2(int nsteps_, WlkSet& wset, RealType Eshift, RealType dt)
{
  AFQMCTimer.start(setup_timer);
  auto walker_type = wset.getWalkerType();
  int nsteps       = nsteps_;
  int nwalk        = wset.size();
  RealType sqrtdt  = std::sqrt(dt);
  long Gsize       = wfn.size_of_G_for_vbias();
  int localnCV     = wfn.local_number_of_cholesky_vectors();
  // if transposed_XXX_=true  --> XXX[nwalk][...],
  // if transposed_XXX_=false --> XXX[...][nwalk]
  auto vhs_ext   = iextensions<2u>{2 * NMO * NMO, nwalk * nsteps};
  auto vhs4d_ext = iextensions<4u>{2, NMO, NMO, nwalk * nsteps};
  auto G_ext     = iextensions<2u>{Gsize, nwalk};
  if (transposed_vHS_)
  {
    vhs_ext   = iextensions<2u>{2 * nwalk * nsteps, NMO * NMO};
    vhs4d_ext = iextensions<4u>{2, nwalk * nsteps, NMO, NMO};
  }
  if (transposed_G_)
    G_ext = iextensions<2u>{nwalk, Gsize};

  if (MFfactor.size(0) != nsteps || MFfactor.size(1) != nwalk)
    MFfactor = CMatrix({long(nsteps), long(nwalk)});
  if (hybrid_weight.size(0) != nsteps || hybrid_weight.size(1) != nwalk)
    hybrid_weight = CMatrix({long(nsteps), long(nwalk)});
  if (new_overlaps.size(0) != nwalk)
    new_overlaps = CVector(iextensions<1u>{nwalk});
  if (new_energies.size(0) != nwalk || new_energies.size(1) != 3)
    new_energies = CMatrix({long(nwalk), 3});

  // if timestep changed, recalculate one body propagator
  if (std::abs(dt - old_dt) > 1e-6)
    generateP1(dt, walker_type);
  AFQMCTimer.stop(setup_timer);

  StaticCMatrix vHS(vhs_ext, ComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<ComplexType>());

  { // using scope to control lifetime of StaticArrays, avoiding unnecesary buffer space

    StaticSPMatrix G(G_ext, SPComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<SPComplexType>());

    // 1. Calculate Green function for all walkers
    AFQMCTimer.start(G_for_vbias_timer);
    if constexpr (SP) {
      int Gak0, GakN;
      std::tie(Gak0, GakN) = FairDivideBoundary(TG.getLocalTGRank(), int(G.num_elements()), TG.getNCoresPerTG());
      StaticCMatrix Gc(G_ext, ComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<ComplexType>());
      wfn.MixedDensityMatrix_for_vbias(wset, Gc);
      copy_n_cast(make_device_ptr(Gc.origin()) + Gak0, GakN - Gak0, make_device_ptr(G.origin()) + Gak0);
      TG.TG_local().barrier();
    } else {
      wfn.MixedDensityMatrix_for_vbias(wset, G);
    }
    AFQMCTimer.stop(G_for_vbias_timer);
    //std::cout<<" G: " <<ma::sum(G) <<std::endl;

    StaticSPMatrix vbias({long(localnCV), long(nwalk)}, SPComplexType(0.0),
                         buffer_manager.get_generator().template get_allocator<SPComplexType>());
    // 2. Calculate vbias for initial configuration
    AFQMCTimer.start(vbias_timer);
    if (free_projection)
    {
      fill_n(vbias.origin(), localnCV * nwalk, SPComplexType(0.0, 0.0));
    }
    else
    {
      wfn.vbias(G, vbias, dt);
    }
    AFQMCTimer.stop(vbias_timer);
    //std::cout<<" vbias: " <<ma::sum(vbias) <<std::endl;

    StaticSPMatrix X({long(localnCV), long(nwalk * nsteps)}, SPComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<SPComplexType>());
    // 3. Assemble X(nCV,nsteps,nwalk)
    AFQMCTimer.start(assemble_X_timer);
    assemble_X(nsteps, nwalk, sqrtdt, X, vbias, MFfactor, hybrid_weight);
    if (TG.TG_local().size() > 1)
    {
      TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(MFfactor.origin()), MFfactor.num_elements(), std::plus<>());
      TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(hybrid_weight.origin()), hybrid_weight.num_elements(),
                                          std::plus<>());
    }
    AFQMCTimer.stop(assemble_X_timer);
    // Store sqrtdt*X in wset if back propagating
    int bp_step = wset.getBPPos(), bp_max = wset.NumBackProp();
    if (bp_step >= 0 && bp_step < bp_max)
    {
      for (int ni = 0; ni < nsteps; ni++)
      {
        if (bp_step < bp_max)
        {
          auto&& V = *wset.getFields(bp_step);
          if(nsteps==1) {
            copy_n_cast(ma::pointer_dispatch(X.origin()), localnCV*nwalk, V.origin());
          } else {
            APP_ABORT(" Error: fix ");
          }
	  // MAM: not scaling by sqrtdt in model case, dt dependence is nontrivial
          //ma::scal(typename WlkSet::bp_element(sqrtdt), V);
          bp_step++;
        }
      }
      TG.TG_local().barrier();
    }
    //std::cout<<" X: " <<ma::sum(X) <<std::endl;

    // 4. Calculate vHS(M*M,nsteps,nwalk)/vHS(nsteps,nwalk,M*M)
    AFQMCTimer.start(vHS_timer);
    if constexpr (SP) {
      // is this clever or dirsty? seems to work well and saves memory!
      SPCMatrix_ref vsp(reinterpret_pointer_cast<SPComplexType>(make_device_ptr(vHS.origin())), vhs_ext);
      wfn.vHS(X, vsp, dt);
      TG.TG_local().barrier();
      if (TG.TG_local().root())
        inplace_cast<SPComplexType, ComplexType>(vsp.origin(), vsp.num_elements());
      TG.TG_local().barrier();
    } else {
      wfn.vHS(X, vHS, dt);
    }
    AFQMCTimer.stop(vHS_timer);
    //std::cout<<" Pg vHS: " <<TG.Global().rank() <<" " <<ma::sum(vHS) <<"" <<std::endl;
  }

// make this 4D to encode possible spin dependence
  C4Tensor_ref vHS4D(make_device_ptr(vHS.origin()), vhs4d_ext);


  for (int ni = 0; ni < nsteps_; ni++)
  {
    // 5. Propagate walkers
    AFQMCTimer.start(propagate_timer);
    //std::cout<<" before propg wfn " <<std::endl; //: "
    //std::cout<<ma::sum(*wset[0].SlaterMatrix(Alpha)) <<" " <<ma::sum(*wset[0].SlaterMatrix(Beta)) <<std::endl;
    apply_propagators('N', wset, ni, vHS4D);
    AFQMCTimer.stop(propagate_timer);
    //std::cout<<" propg wfn " <<std::endl; //: "
    //std::cout<<ma::sum(*wset[0].SlaterMatrix(Alpha)) <<" " <<ma::sum(*wset[0].SlaterMatrix(Beta)) <<std::endl;

    // 6. Calculate local energy/overlap
    AFQMCTimer.start(pseudo_energy_timer);
    if (hybrid)
    {
      wfn.Overlap(wset, new_overlaps);
    }
    else
    {
      wfn.Energy(wset, new_energies, new_overlaps);
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(pseudo_energy_timer);
    //std::cout<<" pseudo energy " <<new_energies[0][0] <<" " <<new_energies[0][1] <<" " <<new_energies[0][2] <<" " <<new_overlaps[0] <<std::endl;

    // 7. update weights/energy/etc, apply constrains/bounds/etc
    AFQMCTimer.start(extra_timer);
    if (TG.TG_local().root())
    {
      if (free_projection)
      {
        free_projection_walker_update(wset, dt, new_overlaps, MFfactor[ni], Eshift, hybrid_weight[ni], work,debug_verbosity);
      }
      else if (hybrid)
      {
        hybrid_walker_update(wset, dt, apply_constrain, importance_sampling, Eshift, new_overlaps, MFfactor[ni],
                             hybrid_weight[ni], work, lower_cutoff_scale, upper_cutoff_scale,symmetric_split,
                             debug_verbosity,use_cp_constraint);
      }
      else
      {
        local_energy_walker_update(wset, dt, apply_constrain, Eshift, new_overlaps, new_energies, MFfactor[ni],
                                   hybrid_weight[ni], work, lower_cutoff_scale, upper_cutoff_scale);
      }
      if (wset.getBPPos() >= 0 && wset.getBPPos() < wset.NumBackProp())
        wset.advanceBPPos();
      // MAM: BP will not work if the nsteps*nsubsteps per block is not consistent with
      //      steps in BP
      if (wset.getBPPos() >= 0)
        wset.advanceHistoryPos();
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(extra_timer);
    //std::cout<<" update: " <<hybrid_weight[0][0]  <<" " <<MFfactor[0][0] <<std::endl <<std::endl;
  }
}

/*
 * Propagates the walker population nsteps forward with a fixed vbias (from the initial 
 * configuration).   
 * Uses sparse propagation.
 */
template<bool SP>
template<class WlkSet>
void AFQMCModelPropagator<SP>::step_sparseP2(int nsteps_, WlkSet& wset, RealType Eshift, RealType dt)
{
  if (nsteps_ != 1)  
    APP_ABORT(" Error: fix_bias is not yet allowed in Model Hamiltonians with denseP2=false. "); 
  AFQMCTimer.start(setup_timer);
  auto walker_type = wset.getWalkerType();
  int nsteps       = nsteps_;
  int nwalk        = wset.size();
  RealType sqrtdt  = std::sqrt(dt);
  long Gsize       = wfn.size_of_G_for_vbias();
  int localnCV     = wfn.local_number_of_cholesky_vectors();
  // if transposed_XXX_=true  --> XXX[nwalk][...],
  // if transposed_XXX_=false --> XXX[...][nwalk]
  auto G_ext     = iextensions<2u>{Gsize, nwalk};
  if (transposed_G_)
    G_ext = iextensions<2u>{nwalk, Gsize};

  if (MFfactor.size(0) != nsteps || MFfactor.size(1) != nwalk)
    MFfactor = CMatrix({long(nsteps), long(nwalk)});
  if (hybrid_weight.size(0) != nsteps || hybrid_weight.size(1) != nwalk)
    hybrid_weight = CMatrix({long(nsteps), long(nwalk)});
  if (new_overlaps.size(0) != nwalk)
    new_overlaps = CVector(iextensions<1u>{nwalk});
  if (new_energies.size(0) != nwalk || new_energies.size(1) != 3)
    new_energies = CMatrix({long(nwalk), 3});

  // if timestep changed, recalculate one body propagator
  if (std::abs(dt - old_dt) > 1e-6)
    generateP1(dt, walker_type);
  AFQMCTimer.stop(setup_timer);

  // pointer to csr_matrix::sub_matrix
  csrMat const* spvHS[2];

  { // using scope to control lifetime of StaticArrays, avoiding unnecesary buffer space

    StaticSPMatrix G(G_ext, SPComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<SPComplexType>());

    // 1. Calculate Green function for all walkers
    AFQMCTimer.start(G_for_vbias_timer);
    if constexpr (SP) {
      int Gak0, GakN;
      std::tie(Gak0, GakN) = FairDivideBoundary(TG.getLocalTGRank(), int(G.num_elements()), TG.getNCoresPerTG());
      StaticCMatrix Gc(G_ext, ComplexType(0.0),
		buffer_manager.get_generator().template get_allocator<ComplexType>());
      wfn.MixedDensityMatrix_for_vbias(wset, Gc);
      copy_n_cast(make_device_ptr(Gc.origin()) + Gak0, GakN - Gak0, make_device_ptr(G.origin()) + Gak0);
      TG.TG_local().barrier();
    } else {
      wfn.MixedDensityMatrix_for_vbias(wset, G);
    }
    AFQMCTimer.stop(G_for_vbias_timer);
    //std::cout<<" G: " <<ma::sum(G) <<std::endl;

    StaticSPMatrix vbias({long(localnCV), long(nwalk)}, SPComplexType(0.0),
                         buffer_manager.get_generator().template get_allocator<SPComplexType>());
    // 2. Calculate vbias for initial configuration
    AFQMCTimer.start(vbias_timer);
    if (free_projection)
    {
      fill_n(vbias.origin(), localnCV * nwalk, SPComplexType(0.0, 0.0));
    }
    else
    {
      wfn.vbias(G, vbias, dt);
    }
    AFQMCTimer.stop(vbias_timer);
    //std::cout<<" vbias: " <<ma::sum(vbias) <<std::endl;

    StaticSPMatrix X({long(localnCV), long(nwalk * nsteps)}, SPComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<SPComplexType>());
    // 3. Assemble X(nCV,nsteps,nwalk)
    AFQMCTimer.start(assemble_X_timer);
    assemble_X(nsteps, nwalk, sqrtdt, X, vbias, MFfactor, hybrid_weight);
    if (TG.TG_local().size() > 1)
    {
      TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(MFfactor.origin()), MFfactor.num_elements(), std::plus<>());
      TG.TG_local().all_reduce_in_place_n(raw_pointer_cast(hybrid_weight.origin()), hybrid_weight.num_elements(),
                                          std::plus<>());
    }
    AFQMCTimer.stop(assemble_X_timer);
    // Store sqrtdt*X in wset if back propagating
    int bp_step = wset.getBPPos(), bp_max = wset.NumBackProp();
    if (bp_step >= 0 && bp_step < bp_max)
    {
      for (int ni = 0; ni < nsteps; ni++)
      {
        if (bp_step < bp_max)
        {
          auto&& V = *wset.getFields(bp_step);
          if(nsteps==1) {
            copy_n_cast(ma::pointer_dispatch(X.origin()), localnCV*nwalk, V.origin());
          } else {
            APP_ABORT(" Error: fix ");
          }
	  // MAM: not scaling by sqrtdt in model case, dt dependence is nontrivial
          //ma::scal(typename WlkSet::bp_element(sqrtdt), V);
          bp_step++;
        }
      }
      TG.TG_local().barrier();
    }
    //std::cout<<" X: " <<ma::sum(X) <<std::endl;

    // 4. Calculate sparse vHS(2*nsteps*nwalk*M,nsteps*nwalk*M)
    AFQMCTimer.start(vHS_timer);
    std::tie(spvHS[0],spvHS[1]) = wfn.vHS_sparse(X, dt);
    AFQMCTimer.stop(vHS_timer);
    using ma::sum;
    //std::cout<<" Pg vHS: " <<TG.Global().rank() <<" " <<sum(spvHS[0]->capacity(),ma::pointer_dispatch(spvHS[0]->non_zero_values_data()),1) <<"" <<std::endl;
  }


  for (int ni = 0; ni < nsteps_; ni++)
  {
    // 5. Propagate walkers
    AFQMCTimer.start(propagate_timer);
    //std::cout<<" before propg wfn " <<std::endl; //: "
    //std::cout<<ma::sum(*wset[0].SlaterMatrix(Alpha)) <<" " <<ma::sum(*wset[0].SlaterMatrix(Beta)) <<std::endl;
    apply_propagators('N', wset, ni, *spvHS[0], *spvHS[1]);
    AFQMCTimer.stop(propagate_timer);
    //std::cout<<" propg wfn " <<std::endl; //: "
    //std::cout<<ma::sum(*wset[0].SlaterMatrix(Alpha)) <<" " <<ma::sum(*wset[0].SlaterMatrix(Beta)) <<std::endl;

    // 6. Calculate local energy/overlap
    AFQMCTimer.start(pseudo_energy_timer);
    if (hybrid)
    {
      wfn.Overlap(wset, new_overlaps);
    }
    else
    {
      wfn.Energy(wset, new_energies, new_overlaps);
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(pseudo_energy_timer);
    //std::cout<<" pseudo energy " <<new_energies[0][0] <<" " <<new_energies[0][1] <<" " <<new_energies[0][2] <<" " <<new_overlaps[0] <<std::endl;

    // 7. update weights/energy/etc, apply constrains/bounds/etc
    AFQMCTimer.start(extra_timer);
    if (TG.TG_local().root())
    {
      if (free_projection)
      {
        free_projection_walker_update(wset, dt, new_overlaps, MFfactor[ni], Eshift, hybrid_weight[ni], work,debug_verbosity);
      }
      else if (hybrid)
      {
        hybrid_walker_update(wset, dt, apply_constrain, importance_sampling, Eshift, new_overlaps, MFfactor[ni],
                             hybrid_weight[ni], work, lower_cutoff_scale, upper_cutoff_scale,symmetric_split,
                             debug_verbosity, use_cp_constraint);
      }
      else
      {
        local_energy_walker_update(wset, dt, apply_constrain, Eshift, new_overlaps, new_energies, MFfactor[ni],
                                   hybrid_weight[ni], work, lower_cutoff_scale, upper_cutoff_scale);
      }
      if (wset.getBPPos() >= 0 && wset.getBPPos() < wset.NumBackProp())
        wset.advanceBPPos();
      // MAM: BP will not work if the nsteps*nsubsteps per block is not consistent with
      //      steps in BP
      if (wset.getBPPos() >= 0)
        wset.advanceHistoryPos();
    }
    TG.TG_local().barrier();
    AFQMCTimer.stop(extra_timer);
    //std::cout<<" update: " <<hybrid_weight[0][0]  <<" " <<MFfactor[0][0] <<std::endl <<std::endl;
  }
}


/*
 * This routine assumes that the 1 body propagator does not need updating
 */
template<bool SP>
template<class WlkSet, class CTens, class CMat>
void AFQMCModelPropagator<SP>::BackPropagate_denseP2(int nbpsteps, int nStabalize, WlkSet& wset, CTens&& Refs, CMat&& logdetR)
{
  using std::copy_n;
  auto walker_type = wset.getWalkerType();
  int npol         = (walker_type == NONCOLLINEAR) ? 2 : 1;
  int nspin        = (walker_type == COLLINEAR) ? 2 : 1;
  int nwalk        = wset.size();
  int globalnCV    = wfn.global_number_of_cholesky_vectors();

  auto vhs_ext   = iextensions<2u>{2 * NMO * NMO, nwalk};
  auto vhs4d_ext = iextensions<4u>{2, NMO, NMO, nwalk};
  if (transposed_vHS_)
  { 
    vhs_ext   = iextensions<2u>{2 * nwalk, NMO * NMO};
    vhs4d_ext = iextensions<4u>{2, nwalk, NMO, NMO};
  }

  StaticCMatrix vHS(vhs_ext, ComplexType(0.0),
                   buffer_manager.get_generator().template get_allocator<ComplexType>());
  StaticSPMatrix X({long(globalnCV), long(nwalk)}, SPComplexType(0.0),
                   buffer_manager.get_generator().template get_allocator<SPComplexType>());
  C4Tensor_ref vHS4D(make_device_ptr(vHS.origin()), vhs4d_ext);

  auto&& Fields = *wset.getFields();
  RUNTIME_CHECK(Fields.size(0) >= nbpsteps, "");
  RUNTIME_CHECK(Fields.size(1) == globalnCV, "");
  RUNTIME_CHECK(Fields.size(2) == nwalk, "");

  int nrow(NMO * npol);
  int ncol(NAEA + ((walker_type == CLOSED) ? 0 : NAEB));
  RUNTIME_CHECK(Refs.size(0) == nwalk, "");
  int nrefs = Refs.size(1);
  RUNTIME_CHECK(Refs.size(2) == nrow * ncol, "");

  int nx = 1;
  if (walker_type == COLLINEAR)
    nx = 2;

  RUNTIME_CHECK(logdetR.size(0) == nwalk, "");
  RUNTIME_CHECK(logdetR.size(1) == nrefs * nx, "");
  ma::fill(logdetR, ComplexType(0.0, 0.0));

  for (int i = 0; i < nwalk; i++)
  {
    copy_n((*wset[i].SlaterMatrix(Alpha)).origin(), nrow * ncol, (*wset[i].SlaterMatrixAux(Alpha)).origin());
    // optimize for the single reference case
    if (nrefs == 1)
      copy_n(Refs[i][0].origin(), nrow * ncol, make_device_ptr((*wset[i].SlaterMatrix(Alpha)).origin()));
  }
  TG.TG_local().barrier();

  for (int ni = nbpsteps - 1; ni >= 0; --ni)
  {
    // 1. Get X(nCV,nwalk) from wset
    copy_n_cast(Fields[ni].origin(), nwalk * globalnCV, make_device_ptr(X.origin()));
    TG.TG_local().barrier();

    // 2. Calculate vHS(M*M,nwalk)/vHS(nwalk,M*M)
    if constexpr (SP) {
      // is this clever or dirsty? seems to work well and saves memory!
      SPCMatrix_ref vsp(reinterpret_pointer_cast<SPComplexType>(make_device_ptr(vHS.origin())), vhs_ext);
      wfn.vHS(X, vsp, old_dt);
      TG.TG_local().barrier();
      if (TG.TG_local().root())
        inplace_cast<SPComplexType, ComplexType>(vsp.origin(), vsp.num_elements());
      TG.TG_local().barrier();
    } else {
      wfn.vHS(X, vHS, old_dt);
    }
    //std::cout<<" BP vHS: " <<TG.Global().rank() <<" " <<ma::sum(vHS) <<"" <<std::endl;

    for (int nr = 0; nr < nrefs; ++nr)
    {
      // 3. copy reference to SlaterMatrix
      if (nrefs > 1)
        for (int i = 0; i < nwalk; i++)
          copy_n(Refs[i][nr].origin(), nrow * ncol, make_device_ptr((*wset[i].SlaterMatrix(Alpha)).origin()));
      TG.TG_local().barrier();

      // 4. Propagate walkers
      apply_propagators('H', wset, 0, vHS4D);
      TG.TG_local().barrier();

      // always end (n==0) with an orthogonalization
      if (ni == 0 || ni % nStabalize == 0)
        Orthogonalize_impl(wset, logdetR(logdetR.extension(0), {nspin * nr, nspin * nr + nspin}));
      TG.TG_local().barrier();

      // 5. copy reference to back
      if (nrefs > 1)
        for (int i = 0; i < nwalk; i++)
          copy_n(make_device_ptr((*wset[i].SlaterMatrix(Alpha)).origin()), nrow * ncol, Refs[i][nr].origin());
      TG.TG_local().barrier();
    }
  }

  // 6. restore the Slater Matrix
  for (int i = 0; i < nwalk; i++)
  {
    if (nrefs == 1)
      copy_n((*wset[i].SlaterMatrix(Alpha)).origin(), nrow * ncol, Refs[i][0].origin());
    copy_n((*wset[i].SlaterMatrixAux(Alpha)).origin(), nrow * ncol, (*wset[i].SlaterMatrix(Alpha)).origin());
  }
  TG.TG_local().barrier();
}

template<bool SP>
template<class WlkSet, class CTens, class CMat>
void AFQMCModelPropagator<SP>::BackPropagate_sparseP2(int nbpsteps, int nStabalize, WlkSet& wset, CTens&& Refs, CMat&& logdetR)
{
  using std::copy_n;
  auto walker_type = wset.getWalkerType();
  int npol         = (walker_type == NONCOLLINEAR) ? 2 : 1;
  int nspin        = (walker_type == COLLINEAR) ? 2 : 1;
  int nwalk        = wset.size();
  int globalnCV    = wfn.global_number_of_cholesky_vectors();

  // pointer to csr_matrix::sub_matrix
  csrMat const* spvHS[2];

  StaticSPMatrix X({long(globalnCV), long(nwalk)}, SPComplexType(0.0),
                   buffer_manager.get_generator().template get_allocator<SPComplexType>());

  auto&& Fields = *wset.getFields();
  RUNTIME_CHECK(Fields.size(0) >= nbpsteps, "");
  RUNTIME_CHECK(Fields.size(1) == globalnCV, "");
  RUNTIME_CHECK(Fields.size(2) == nwalk, "");

  int nrow(NMO * npol);
  int ncol(NAEA + ((walker_type == CLOSED) ? 0 : NAEB));
  RUNTIME_CHECK(Refs.size(0) == nwalk, "");
  int nrefs = Refs.size(1);
  RUNTIME_CHECK(Refs.size(2) == nrow * ncol, "");

  int nx = 1;
  if (walker_type == COLLINEAR)
    nx = 2;

  RUNTIME_CHECK(logdetR.size(0) == nwalk, "");
  RUNTIME_CHECK(logdetR.size(1) == nrefs * nx, "");
  ma::fill(logdetR, ComplexType(0.0, 0.0));

  for (int i = 0; i < nwalk; i++)
  {
    copy_n((*wset[i].SlaterMatrix(Alpha)).origin(), nrow * ncol, (*wset[i].SlaterMatrixAux(Alpha)).origin());
    // optimize for the single reference case
    if (nrefs == 1)
      copy_n(Refs[i][0].origin(), nrow * ncol, make_device_ptr((*wset[i].SlaterMatrix(Alpha)).origin()));
  }
  TG.TG_local().barrier();

  for (int ni = nbpsteps - 1; ni >= 0; --ni)
  {
    // 1. Get X(nCV,nwalk) from wset
    copy_n_cast(Fields[ni].origin(), nwalk * globalnCV, make_device_ptr(X.origin()));
    TG.TG_local().barrier();

    // 2. Calculate vHS(M*M,nwalk)/vHS(nwalk,M*M)
    std::tie(spvHS[0],spvHS[1]) = wfn.vHS_sparse(X, old_dt);
       
    for (int nr = 0; nr < nrefs; ++nr)
    {
      // 3. copy reference to SlaterMatrix
      if (nrefs > 1)
        for (int i = 0; i < nwalk; i++)
          copy_n(Refs[i][nr].origin(), nrow * ncol, make_device_ptr((*wset[i].SlaterMatrix(Alpha)).origin()));
      TG.TG_local().barrier();

      // 4. Propagate walkers
      apply_propagators('H', wset, 0, *spvHS[0], *spvHS[1]);
      TG.TG_local().barrier();

      // always end (n==0) with an orthogonalization
      if (ni == 0 || ni % nStabalize == 0)
        Orthogonalize_impl(wset, logdetR(logdetR.extension(0), {nspin * nr, nspin * nr + nspin}));
      TG.TG_local().barrier();

      // 5. copy reference to back
      if (nrefs > 1)
        for (int i = 0; i < nwalk; i++)
          copy_n(make_device_ptr((*wset[i].SlaterMatrix(Alpha)).origin()), nrow * ncol, Refs[i][nr].origin());
      TG.TG_local().barrier();
    }
  }

  // 6. restore the Slater Matrix
  for (int i = 0; i < nwalk; i++)
  {
    if (nrefs == 1)
      copy_n((*wset[i].SlaterMatrix(Alpha)).origin(), nrow * ncol, Refs[i][0].origin());
    copy_n((*wset[i].SlaterMatrixAux(Alpha)).origin(), nrow * ncol, (*wset[i].SlaterMatrix(Alpha)).origin());
  }
  TG.TG_local().barrier();
}

template<bool SP>
template<class WlkSet, class Mat1, class Mat2, class Mat3>
void AFQMCModelPropagator<SP>::PropagateOperators([[maybe_unused]] int steps, [[maybe_unused]] WlkSet& wset, [[maybe_unused]] Mat1&& X, [[maybe_unused]] Mat2&& Y, [[maybe_unused]] Mat3&& M)
{
  APP_ABORT(" Error: AFQMCModelPropagator::PropagateOperators \n\n");
}

template<bool SP>
template<class WSet>
void AFQMCModelPropagator<SP>::apply_propagators(char TA, 
                                             WSet& wset, 
                                             int ni, 
                                             C4Tensor_ref& vHS4D)
{
  int nwalk        = wset.size();
  auto walker_type = wset.getWalkerType();
  int nbatch       = std::min(nwalk, (nbatched_propagation < 0 ? nwalk : nbatched_propagation));
  int nspin = (walker_type == COLLINEAR ? 2 : 1);

  if (walker_type == CLOSED)
    APP_ABORT(" Error: Spin dependent vHS in closed shell system. " );

  if (transposed_vHS_)
  {
    // vHS4D[nspin][nstep*nwalk][M][M]
    if(walker_type == COLLINEAR) {
      auto SMup = wset.SlaterMatrices(Alpha);
      auto SMdn = wset.SlaterMatrices(Beta);
      int nt = ni * nwalk;
      for (int iw = 0; iw < nwalk; iw += nbatch, nt += nbatch)
      { 
        int nb = std::min(nbatch, nwalk - iw);
        if(denseP1) { 
          SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1d[0], 
              vHS4D[0].sliced(nt, nt + nb), order, TA); 
          SDetOp->BatchedPropagate(SMdn.sliced(iw,iw+nb), P1d[1], 
              vHS4D[1].sliced(nt, nt + nb), order, TA); 
        } else {
          SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1s[0], 
              vHS4D[0].sliced(nt, nt + nb), order, TA); 
          SDetOp->BatchedPropagate(SMdn.sliced(iw,iw+nb), P1s[1], 
              vHS4D[1].sliced(nt, nt + nb), order, TA); 
        }
      }
    } else if(walker_type == NONCOLLINEAR) {
      auto SM = wset.SlaterMatrices(Alpha);
      int nt = ni * nwalk;
      for (int iw = 0; iw < nwalk; iw += nbatch, nt += nbatch)
      {
        int nb = std::min(nbatch, nwalk - iw);
        if(denseP1)
          SDetOp->BatchedPropagate(SM.sliced(iw,iw+nb), P1d[0], 
              vHS4D[0].sliced(nt, nt + nb), vHS4D[1].sliced(nt, nt + nb), order, TA);
        else
          SDetOp->BatchedPropagate(SM.sliced(iw,iw+nb), P1s[0], 
              vHS4D[0].sliced(nt, nt + nb), vHS4D[1].sliced(nt, nt + nb), order, TA);
      }
    }
  }
  else
  {
    // vHS4D[nspin][M][M][nstep*nwalk]: need temporary buffer in this case
    int N2 = vHS4D.size(1) * vHS4D.size(2);
    CMatrix_ref vHS2D_up(vHS4D[0].origin(), {N2, vHS4D.size(3)});
    CMatrix_ref vHS2D_dn(vHS4D[1].origin(), {N2, vHS4D.size(3)});

    if(walker_type == COLLINEAR) {
      auto SMup = wset.SlaterMatrices(Alpha);
      auto SMdn = wset.SlaterMatrices(Beta);
      StaticCMatrix vbuff({nbatch, N2}, ComplexType(0.0),
        buffer_manager.get_generator().template get_allocator<ComplexType>());
      // v[nbatch][NMO][NMO]
      auto v = vbuff.rotated().partitioned(NMO).unrotated();

      int nt = ni * nwalk;
      for (int iw = 0; iw < nwalk; iw += nbatch, nt += nbatch)
      {
        int nb = std::min(nbatch, nwalk - iw);
        // Alpha
        ma::transpose(vHS2D_up(vHS2D_up.extension(0), {nt, nt + nb}), vbuff.sliced(0,nb));
        if(denseP1)
          SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1d[0],
                     v.sliced(0,nb), order, TA);
        else
          SDetOp->BatchedPropagate(SMup.sliced(iw,iw+nb), P1s[0],
                     v.sliced(0,nb), order, TA);
        // Beta
        ma::transpose(vHS2D_dn(vHS2D_dn.extension(0), {nt, nt + nb}), vbuff.sliced(0,nb));
        if(denseP1)
          SDetOp->BatchedPropagate(SMdn.sliced(iw,iw+nb),
                     P1d[nspin-1], v.sliced(0,nb), order, TA);
        else
          SDetOp->BatchedPropagate(SMdn.sliced(iw,iw+nb),
                     P1s[nspin-1], v.sliced(0,nb), order, TA);
      }
    } else if(walker_type == NONCOLLINEAR) {
      auto SM = wset.SlaterMatrices(Alpha);
      Static3Tensor vbuff({2, nbatch, N2}, ComplexType(0.0), 
        buffer_manager.get_generator().template get_allocator<ComplexType>());
      // vup/vdn[nbatch][NMO][NMO]
      auto vup = vbuff[0].rotated().partitioned(NMO).unrotated();
      auto vdn = vbuff[1].rotated().partitioned(NMO).unrotated();

      int nt = ni * nwalk;
      for (int iw = 0; iw < nwalk; iw += nbatch, nt += nbatch)
      {
        int nb = std::min(nbatch, nwalk - iw);
        ma::transpose(vHS2D_up(vHS2D_up.extension(0), {nt, nt + nb}), vbuff[0].sliced(0,nb));
        ma::transpose(vHS2D_dn(vHS2D_dn.extension(0), {nt, nt + nb}), vbuff[1].sliced(0,nb)); 
        if(denseP1) 
          SDetOp->BatchedPropagate(SM.sliced(iw,iw+nb), P1d[0], 
                        vup.sliced(0,nb), vdn.sliced(0,nb), order, TA);
        else
          SDetOp->BatchedPropagate(SM.sliced(iw,iw+nb), P1s[0], 
                        vup.sliced(0,nb), vdn.sliced(0,nb), order, TA);
      }
    }
  }
}

template<bool SP>
template<class WSet>
void AFQMCModelPropagator<SP>::apply_propagators(char TA, 
                                             WSet& wset, 
                                             int ni, 
                                             csrMat const& spVup,
                                             csrMat const& spVdn)
{
  auto walker_type = wset.getWalkerType();

  // MAM:
  // getting sub matrices without full column range is expensive,
  // so doing all walkers simultaneously for now.
  // implement something better if nbatch!=-1 is neeeded!!!  

  if (walker_type == CLOSED)
    APP_ABORT(" Error: Spin dependent vHS in closed shell system. ");
  if (ni != 0)  
    APP_ABORT(" Error: fix_bias is not yet allowed with denseP2=false. "); 

  // spV[ nwalk*npol*NMO, nwalk*npol*NMO ]
  if(walker_type == COLLINEAR) {
    auto SMup = wset.SlaterMatrices(Alpha);
    auto SMdn = wset.SlaterMatrices(Beta);
    if(denseP1) { 
      SDetOp->BatchedPropagate(SMup, P1d[0], spVup, order, TA); 
      SDetOp->BatchedPropagate(SMdn, P1d[1], spVdn, order, TA);
    } else {
      SDetOp->BatchedPropagate(SMup, P1s[0], spVup, order, TA); 
      SDetOp->BatchedPropagate(SMdn, P1s[1], spVdn, order, TA);
    }
  } else if(walker_type == NONCOLLINEAR) {
    auto SM = wset.SlaterMatrices(Alpha);
    if(denseP1)
      SDetOp->BatchedPropagate(SM, P1d[0], spVup, order, TA); 
    else
      SDetOp->BatchedPropagate(SM, P1s[0], spVup, order, TA); 
  }
}

/*
   * Orthogonalizes the Slater matrices of all walkers in the set.  
   *  - logdetR: Array where the logarithm of det(R) will be accumulated.
   */
template<bool SP>
template<class WlkSet, class CMat>
void AFQMCModelPropagator<SP>::Orthogonalize_impl(WlkSet& wset, CMat&& logdetR)
{
  auto walker_type = wset.getWalkerType();
  const int nspin = ( (walker_type == COLLINEAR) ? 2 : 1 );
  int nw_tot = wset.size();
  RUNTIME_CHECK(logdetR.size(0) == nw_tot, "");
  double LogOverlapFactor(wset.getLogOverlapFactor());
  int w0, w1;
  std::tie(w0, w1) = FairDivideBoundary(TG.getLocalTGRank(), nw_tot, TG.getNCoresPerTG());
  int nbatch__ = std::min(w1-w0, (nbatched_qr <= 0 ? w1-w0 : nbatched_qr));
  StaticMatrix_<dev_stack_alloc_type> logdetR_({nspin, nbatch__},ComplexType(0.0),
                device_buffer_manager.get_generator().template get_allocator<ComplexType>());
  if (walker_type != COLLINEAR)
  {
    RUNTIME_CHECK(logdetR.size(1) == 1, "");
    auto SM = wset.SlaterMatrices(Alpha);
    for (int iw = w0; iw < w1; iw += nbatch__)
    {
      int nb = std::min(nbatch__, w1 - iw);
      SDetOp->BatchedOrthogonalize(SM.sliced(iw,iw+nb), LogOverlapFactor, logdetR_.origin());
      ma::add(ComplexType(1.0), ma::T(logdetR_.rotated().sliced(0,nb).unrotated()),
              ComplexType(1.0), logdetR.sliced(iw,iw+nb), logdetR.sliced(iw,iw+nb));
    }
  }
  else
  {
    RUNTIME_CHECK(logdetR.size(1) == 2, "");
    auto SMup = wset.SlaterMatrices(Alpha);
    auto SMdn = wset.SlaterMatrices(Beta);
    for (int iw = w0; iw < w1; iw += nbatch__)
    {
      int nb = std::min(nbatch__, w1 - iw);
      // Alpha
      SDetOp->BatchedOrthogonalize(SMup.sliced(iw,iw+nb), LogOverlapFactor, logdetR_[0].origin());
      // Beta
      SDetOp->BatchedOrthogonalize(SMdn.sliced(iw,iw+nb), LogOverlapFactor, logdetR_[1].origin());
      ma::add(ComplexType(1.0), ma::T(logdetR_.rotated().sliced(0,nb).unrotated()),
              ComplexType(1.0), logdetR.sliced(iw,iw+nb), logdetR.sliced(iw,iw+nb));
    }
  }
  TG.TG_local().barrier();
}

/*
 * Walker orthogonalization for cases where det(R) is not needed. 
 */
template<bool SP>
template<class WlkSet>
void AFQMCModelPropagator<SP>::Orthogonalize_impl(WlkSet& wset)
{
  auto walker_type = wset.getWalkerType();
  int nw_tot = wset.size();
  double LogOverlapFactor(wset.getLogOverlapFactor());
  int w0, w1;
  std::tie(w0, w1) = FairDivideBoundary(TG.getLocalTGRank(), nw_tot, TG.getNCoresPerTG());
  int nbatch__ = std::min(w1-w0, (nbatched_qr <= 0 ? w1-w0 : nbatched_qr));
  if (walker_type != COLLINEAR)
  {
    auto SM = wset.SlaterMatrices(Alpha);
    for (int iw = w0; iw < w1; iw += nbatch__)
    {
      int nb = std::min(nbatch__, w1 - iw);
      SDetOp->BatchedOrthogonalize(SM.sliced(iw,iw+nb), LogOverlapFactor);
    }
  }
  else
  {
    auto SMup = wset.SlaterMatrices(Alpha);
    auto SMdn = wset.SlaterMatrices(Beta);
    for (int iw = w0; iw < w1; iw += nbatch__)
    {
      int nb = std::min(nbatch__, w1 - iw);
      // Alpha
      SDetOp->BatchedOrthogonalize(SMup.sliced(iw,iw+nb), LogOverlapFactor);
      // Beta
      SDetOp->BatchedOrthogonalize(SMdn.sliced(iw,iw+nb), LogOverlapFactor);
    }
  }
  TG.TG_local().barrier();
}

template<bool SP>
template<class WlkSet>
void AFQMCModelPropagator<SP>::Orthogonalize_excited_impl(WlkSet& wset)
{
  using devStaticTensor = StaticArray<ComplexType, 3, dev_stack_alloc_type>;
  auto walker_type = wset.getWalkerType();
  int nw_tot = wset.size();
  double LogOverlapFactor(wset.getLogOverlapFactor());
  int w0, w1;
  std::tie(w0, w1) = FairDivideBoundary(TG.getLocalTGRank(), nw_tot, TG.getNCoresPerTG());
  int nbatch__ = std::min(w1-w0, (nbatched_qr <= 0 ? w1-w0 : nbatched_qr));
  if (walker_type != COLLINEAR)
  { 
    RUNTIME_CHECK(numExcitations.first > 0, ""); 
    int nexmax(maxOccupExtendedMat.first);
    auto SM = wset.SlaterMatrices(Alpha);
    for (int iw = w0; iw < w1; iw += nbatch__)
    { 
      int nb = std::min(nbatch__, w1 - iw);
      devStaticTensor extA({nb, NMO, nexmax}, 
                device_buffer_manager.get_generator().template get_allocator<ComplexType>());
      ma::copy(SM.sliced(iw,iw+nb),extA({0,nb},{0,NMO},{0,NAEA}));
      ma::copy(excitedOrbMat[0]({0,NMO},{NAEA + 1, nexmax}), extA({0,nb},{0,NMO},{NAEA+1,nexmax}));
      // move i->a, copy trial orb i
      // serializing for now, but will be slow!  
      for (auto& i : excitations)
        if (i.first < NMO && i.second < NMO)
        { 
          for(int n=0; n<nb; n++) 
            ma::copy(extA[n]({0,NMO}, i.first), extA[n]({0,NMO}, i.second));
          for(int n=0; n<nb; n++) 
            ma::copy(excitedOrbMat[0]({0,NMO}, i.first), extA[n]({0,NMO}, i.first));
        }
      SDetOp->BatchedOrthogonalize(extA, LogOverlapFactor);
      ma::copy(extA({0,nb},{0,NMO},{0,NAEA}), SM.sliced(iw,iw+nb));
      for (auto& i : excitations)
        if (i.first < NMO && i.second < NMO) {
          for(int n=0; n<nb; n++) 
            ma::copy(extA[n]({0,NMO}, i.second), SM[iw+n]({0,NMO}, i.first));
        }
    }
  }
  else
  {
    auto SMup = wset.SlaterMatrices(Alpha);
    auto SMdn = wset.SlaterMatrices(Beta);
    // Alpha
    if(numExcitations.first == 0)
    {
      for (int iw = w0; iw < w1; iw += nbatch__)
      {
        int nb = std::min(nbatch__, w1 - iw);
        SDetOp->BatchedOrthogonalize(SMup.sliced(iw,iw+nb), LogOverlapFactor);
      }
    }
    else
    {
      int nexmax(maxOccupExtendedMat.first);
      for (int iw = w0; iw < w1; iw += nbatch__)
      {
        int nb = std::min(nbatch__, w1 - iw);
        devStaticTensor extA({nb, NMO, nexmax},
                device_buffer_manager.get_generator().template get_allocator<ComplexType>());
        ma::copy(SMup.sliced(iw,iw+nb),extA({0,nb},{0,NMO},{0,NAEA}));
        ma::copy(excitedOrbMat[0]({0,NMO},{NAEA + 1, nexmax}), extA({0,nb},{0,NMO},{NAEA+1,nexmax}));
        // move i->a, copy trial orb i
        // serializing for now, but will be slow!  
        for (auto& i : excitations)
          if (i.first < NMO && i.second < NMO)
          {
            for(int n=0; n<nb; n++)
              ma::copy(extA[n]({0,NMO}, i.first), extA[n]({0,NMO}, i.second));
            for(int n=0; n<nb; n++)
              ma::copy(excitedOrbMat[0]({0,NMO}, i.first), extA[n]({0,NMO}, i.first));
          }
        SDetOp->BatchedOrthogonalize(extA, LogOverlapFactor);
        ma::copy(extA({0,nb},{0,NMO},{0,NAEA}), SMup.sliced(iw,iw+nb));
        for (auto& i : excitations)
          if (i.first < NMO && i.second < NMO) {
            for(int n=0; n<nb; n++)
              ma::copy(extA[n]({0,NMO}, i.second), SMup[iw+n]({0,NMO}, i.first));
          }
      }
    }
    // Beta  
    if(numExcitations.first == 0)
    {
      for (int iw = w0; iw < w1; iw += nbatch__)
      {
        int nb = std::min(nbatch__, w1 - iw);
        SDetOp->BatchedOrthogonalize(SMdn.sliced(iw,iw+nb), LogOverlapFactor);
      }
    }
    else
    {
      int nexmax(maxOccupExtendedMat.second);
      for (int iw = w0; iw < w1; iw += nbatch__)
      {
        int nb = std::min(nbatch__, w1 - iw);
        devStaticTensor extA({nb, NMO, nexmax},
                device_buffer_manager.get_generator().template get_allocator<ComplexType>());
        ma::copy(SMdn.sliced(iw,iw+nb),extA({0,nb},{0,NMO},{0,NAEB}));
        ma::copy(excitedOrbMat[0]({0,NMO},{NAEB + 1, nexmax}), extA({0,nb},{0,NMO},{NAEB+1,nexmax}));
        // move i->a, copy trial orb i
        // serializing for now, but will be slow!  
        for (auto& i : excitations)
          if (i.first < NMO && i.second < NMO)
          {
            for(int n=0; n<nb; n++)
              ma::copy(extA[n]({0,NMO}, i.first), extA[n]({0,NMO}, i.second));
            for(int n=0; n<nb; n++)
              ma::copy(excitedOrbMat[1]({0,NMO}, i.first), extA[n]({0,NMO}, i.first));
          }
        SDetOp->BatchedOrthogonalize(extA, LogOverlapFactor);
        ma::copy(extA({0,nb},{0,NMO},{0,NAEB}), SMdn.sliced(iw,iw+nb));
        for (auto& i : excitations)
          if (i.first < NMO && i.second < NMO) {
            for(int n=0; n<nb; n++)
              ma::copy(extA[n]({0,NMO}, i.second), SMdn[iw+n]({0,NMO}, i.first));
          }
      }
    }
  }
  TG.TG_local().barrier();
}

template<bool SP>
template<class MatA, class MatB, class MatC, class MatD>
void AFQMCModelPropagator<SP>::assemble_X(size_t nsteps,
                                     size_t nwalk,
                                     RealType sqrtdt,
                                     MatA&& X,
                                     MatB&& vbias,
                                     MatC&& MF,
                                     MatD&& HWs,
                                     [[maybe_unused]] bool addRAND)
{
  using XType = typename std::decay<MatA>::type::element;
  using XValueType = typename std::decay<MatA>::type::element::value_type;

  TG.TG_local().barrier();
  ComplexType im(0.0, 1.0);
  int nCV = int(X.size(0));
  int m0, mN;
  
  if(rng_block_size < nCV) 
    APP_ABORT("Error in AFQMCModelPropagator<SP>::assemble_X: rng_block_size < nCV.");

  // rng_block_size random numbers per step, per walker
  std::tie(m0, mN) = FairDivideBoundary(TG.TG_local().rank(), rng_block_size, TG.TG_local().size());
  // pointer to next random number in the buffer
  int rn_needed(nsteps*nwalk*(mN-m0));

  // check buffer size
  // in general, will only be called once
  if(uniformRNbuffer.size() < rn_needed )  
  {
    // initialize random number buffer
    // set size to integer multiple of rn_needed 
    int nrng =  rn_needed * ( static_cast<int>(std::max(rn_needed, 10000000))/rn_needed + 1);
    if(rng_block_size != nCV) nrng = rn_needed;  // no need to waste space
    uniformRNbuffer = RVector( iextensions<1u>{nrng}, RealType(0.0) );
    utils::sampleUniformFields_n(uniformRNbuffer.origin(), uniformRNbuffer.size(), *rng);
    uniformRNptr = uniformRNbuffer.origin();
  }

  if(rng_block_size == nCV)
  {
    // check if we have enough random numbers and generate if not.
    // update uniformRNptr  
    size_t nrem ( uniformRNbuffer.origin()+uniformRNbuffer.size() - uniformRNptr );
    if( nrem < rn_needed ) { 
      utils::sampleUniformFields_n(uniformRNbuffer.origin(), uniformRNbuffer.size(), *rng);
      uniformRNptr = uniformRNbuffer.origin();
    }
  } else {
    // reset buffer every time if doing correlated sampling
    // always draw rn_needed random numbers from the stream to keep synch with other systems
    utils::sampleUniformFields_n(uniformRNbuffer.origin(), rn_needed, *rng);
    uniformRNptr = uniformRNbuffer.origin();   
    // adjust m0/mN if outside {0,nCV}
    m0 = std::min(nCV,m0);    
    mN = std::min(nCV,mN);    
  }
  // clear arrays 
  ma::fill(HWs, ComplexType(0));
  ma::fill(MF, ComplexType(0));

  // sanity checks
  RUNTIME_CHECK(not ( uniformRNptr == nullptr ), "");  
  RUNTIME_CHECK((uniformRNptr-uniformRNbuffer.origin()) <= uniformRNbuffer.size(), "");  
  RUNTIME_CHECK((uniformRNptr-uniformRNbuffer.origin())+rn_needed <= uniformRNbuffer.size(), "");  

// leaving compiler switch until I decide how to do this better
// basically hide this decision somewhere based on the value of pointer!!!
// TODO: Move this
#if defined(ENABLE_DEVICE)
  kernels::construct_X_model(nCV, nsteps, nwalk, free_projection, sqrtdt, vbias_bound, 
                    raw_pointer_cast(FieldTypes.origin()), raw_pointer_cast(vMF.origin()),
                    raw_pointer_cast(vbias.origin()), raw_pointer_cast(HWs.origin()), raw_pointer_cast(MF.origin()),
                    raw_pointer_cast(uniformRNptr), raw_pointer_cast(X.origin()));
  uniformRNptr += rn_needed; 
#else
  boost::multi::array_ref<XType, 3> X3D(raw_pointer_cast(X.origin()), {long(X.size(0)), long(nsteps), long(nwalk)});
  TG.TG_local().barrier();
  for (int m = m0; m < mN; ++m)
  {
    auto X_m = X3D[m];
    auto vb_ = raw_pointer_cast(vbias[m].origin());
    PropagatorTypes Fp = PropagatorTypes(FieldTypes[m]);

    if( Fp == ContinuousChargePropagator or
       Fp == ContinuousSpinPropagator) 
    { 

      // remember to call vbi = apply_bound_vbias(*vb);
      // X[m,ni,iw] = Gaussian(0.0,1.0) + im * ( vbias[m,iw] - vMF[m]  )
      // HW[ni,iw] = sum_m [ im * ( vMF[m] - vbias[m,iw] ) *
      //                     ( rand[m,ni,iw] + halfim * ( vbias[m,iw] - vMF[m] ) ) ]
      //           = sum_m [ im * ( vMF[m] - vbias[m,iw] ) *
      //                     ( X[m,ni,iw] - halfim * ( vbias[m,iw] - vMF[m] ) ) ]
      // MF[ni,iw] = sum_m ( im * X[m,ni,iw] * vMF[m] )
      {  
        auto vmf_t = apply_bound_vbias(vMF[m], sqrtdt);
        auto vmf_ = vMF[m];
        // apply bounds to vbias
        for (int iw = 0; iw < nwalk; iw++){
          vb_[iw] = apply_bound_vbias(vb_[iw], sqrtdt);
        
          if (use_cp_constraint or use_real_vbias)
            {
              if (Fp == ContinuousSpinPropagator) {
                vb_[iw] = ComplexType(0.0,std::imag(vb_[iw]));
              } else if (Fp == ContinuousChargePropagator) {
                vb_[iw] = ComplexType(std::real(vb_[iw]),0.0);
              }
            }
        }

        for (int ni = 0; ni < nsteps; ni++)
        {
          auto X_ = X_m[ni].origin();
          auto hws_ = raw_pointer_cast(HWs[ni].origin());
          auto mf_ = raw_pointer_cast(MF[ni].origin());
          if(free_projection) {
            // No force bias term when doing free projection.
            for (int iw = 0; iw < nwalk; iw++)
            {
              //needs static_cast<XValueType> before static_cast<XType> to avoid implicit conversion warning since XType is often std::complex
              X_[iw] = static_cast<XType>(static_cast<XValueType>(probit(*(uniformRNptr++))));
              mf_[iw] += im * static_cast<ComplexType>(X_[iw]) * vmf_;
            }  // iw
          } else {
            for (int iw = 0; iw < nwalk; iw++)
            {
              ComplexType vdiff = (im * (static_cast<ComplexType>(vb_[iw]) - vmf_t));
              X_[iw] = static_cast<XType>(static_cast<XValueType>(probit(*(uniformRNptr++)))) +
                       static_cast<XType>(vdiff);
              hws_[iw] -= vdiff * (static_cast<ComplexType>(X_[iw]) - 0.5 * vdiff);
              mf_[iw] += im * static_cast<ComplexType>(X_[iw]) * vmf_;
            }  // iw
          } //free projection
        } // ni

      } 
      
    } // ContinuousChargePropagator or ContinuousSpinPropagator
    else if( Fp == DiscreteSpinPropagator or
             Fp == DiscreteChargePropagator ) 
    {
      {  
        auto vmf_t = apply_bound_vbias(vMF[m], sqrtdt);
        auto vmf_ = vMF[m];
        // apply bounds to vbias
        for (int iw = 0; iw < nwalk; iw++){
          vb_[iw] = apply_bound_vbias(vb_[iw], sqrtdt);

          if (use_cp_constraint or use_real_vbias) {
            if (Fp == DiscreteSpinPropagator) {
              vb_[iw] = ComplexType(0.0,std::imag(vb_[iw]));
            } else if (Fp == DiscreteChargePropagator) {
              vb_[iw] = ComplexType(std::real(vb_[iw]),0.0);
            }
          }
        }

        for (int ni = 0; ni < nsteps; ni++)
        {
          auto X_ = X_m[ni].origin();
          auto hws_ = raw_pointer_cast(HWs[ni].origin());
          auto mf_ = raw_pointer_cast(MF[ni].origin());
	  // using abs(exp(xF)) as the force bias term
	  // other options possible
          if(free_projection) {
            // No force bias term when doing free projection.
            APP_ABORT("Finish FP DiscretePropagator");
          } else {
            for (int iw = 0; iw < nwalk; iw++)
            {
              ComplexType vdiff = im * (static_cast<ComplexType>(vb_[iw]) - vmf_t);
	      auto wp = std::abs(std::exp(vdiff));
	      auto wm = std::abs(std::exp(-vdiff));
	      auto P = wm/(wp+wm);
              if( *(uniformRNptr++) < P ) {
		X_[iw] = static_cast<XType>(-1.0);
		hws_[iw] += std::log(1.0/P);
	      } else {
		X_[iw] = static_cast<XType>(1.0);
		hws_[iw] += std::log(1.0/(1.0-P));
	      }			
	      // W_MSsub = exp(-mf_), careful with sign convention
              mf_[iw] += im * static_cast<ComplexType>(X_[iw]) * vmf_;
            }  // iw
          } //free projection
        } // ni

      } 
    }
    else  
    {
      app_error(" Error: Unknown field type: {}", int(FieldTypes[m]));
      APP_ABORT("");
    }     
  }
  TG.TG_local().barrier();
#endif
}

template<bool SP>
template<class WlkSet>
void AFQMCModelPropagator<SP>::Orthogonalize(WlkSet& wset)
{
  if(excitedState)
  { 
    if(not importance_sampling)
      APP_ABORT("Error: Excited state propagator only implemented with importance sampling. ");
    Orthogonalize_excited_impl(wset);
  }
  else if(importance_sampling)
  {
    Orthogonalize_impl(wset);
  }
  else
  {
    auto walker_type = wset.getWalkerType();
    int nwalk = wset.size();
    int nspin = ( (walker_type == COLLINEAR) ? 2 : 1 );
    StaticCMatrix logdetR({nwalk, nspin}, ComplexType(0.0),
                  buffer_manager.get_generator().template get_allocator<ComplexType>());
    Vector<ComplexType> hostv(iextensions<1u>{nspin*nwalk});
    Vector<ComplexType> hostv2(iextensions<1u>{nwalk});
    // get old weights
    wset.getProperty(WEIGHT, logdetR.flatted().sliced(0,nwalk));
    copy_n(logdetR.origin(), nwalk, hostv2.data());
    // Orthogonalize and keep logdetR
    ma::fill(logdetR, ComplexType(0.0, 0.0));
    Orthogonalize_impl(wset, logdetR);
    // processing this on the host for now, make kernel if needed!
    copy_n(logdetR.origin(), nwalk*nspin, hostv.data());
    TG.TG_local().barrier();
    if (walker_type == CLOSED)
      for (int iw = 0; iw < nwalk; iw++)
        hostv2[iw] *= std::exp(hostv[iw]+hostv[iw]);
    else if (walker_type == COLLINEAR)
      for (int iw = 0; iw < nwalk; iw++)
        hostv2[iw] *= std::exp(hostv[iw] + hostv[iw + nwalk]);
    else if (walker_type == NONCOLLINEAR)
      for (int iw = 0; iw < nwalk; iw++)
        hostv2[iw] *= std::exp(hostv[iw]);
    copy_n(hostv2.data(), nwalk, logdetR.origin());
    wset.setProperty(WEIGHT, logdetR.flatted().sliced(0,nwalk));
  }
  TG.TG_local().barrier();
  wfn.Overlap(wset);
}

} // namespace afqmc

} // namespace sfqmc
