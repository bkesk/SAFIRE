#ifndef SFQMC_CONFIGURATION_H
#define SFQMC_CONFIGURATION_H

/* define location of source directory */
#define PROJECT_SOURCE_DIR_STR "@PROJECT_SOURCE_DIR@"

/* define the major version */
#define AF_APP_VERSION_MAJOR  @AF_APP_VERSION_MAJOR@

/* define the minor version */
#define AF_APP_VERSION_MINOR  @AF_APP_VERSION_MINOR@

/* define the patch version */
#define AF_APP_VERSION_PATCH  @AF_APP_VERSION_PATCH@

/* define the version */
#define AF_APP_VERSION "@AF_APP_VERSION@"

/* define the release version */
#cmakedefine AFAPP_RELEASE  @AFAPP_RELEASE@

/* building from Git repository or not */
#cmakedefine IS_GIT_PROJECT  @IS_GIT_PROJECT@

/* Assume MKL library is available. */ 
#cmakedefine HAVE_MKL @HAVE_MKL@

/* Assume ESSL library is available. */ 
#cmakedefine HAVE_ESSL @HAVE_ESSL@

/* Assume ACML library is available. */ 
#cmakedefine HAVE_ACML @HAVE_ACML@

/* Enable device code and use CUDA backend */
#cmakedefine ENABLE_CUDA @ENABLE_CUDA@

/* Enable device code and use HIP backend */
#cmakedefine ENABLE_HIP @ENABLE_HIP@
 
/* Enable OpenMP backend. */
#cmakedefine ENABLE_OPENMP @ENABLE_OPENMP@

/* Enable device code, with some backend. */
#cmakedefine ENABLE_DEVICE @ENABLE_DEVICE@

/* Disable trace manager and associated features */
#cmakedefine DISABLE_TRACEMANAGER @DISABLE_TRACEMANAGER@

/* Fully remove trace manager and associated features */
#cmakedefine REMOVE_TRACEMANAGER @REMOVE_TRACEMANAGER@

#endif // CONFIGURATION_H

